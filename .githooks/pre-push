#!/bin/bash
# Pre-push hook - read-only security scan of outgoing commits
#
# Install with: ./scripts/install-hooks.sh

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# Get the remote and URL
remote="$1"
url="$2"

# A push hook validates the exact refs supplied by Git. Build/version changes belong
# in an explicitly reviewed commit before pushing, never in an unchecked hook commit.

# =============================================================================
# SECURITY SCAN
# =============================================================================

echo -e "${GREEN}Running pre-push security scan...${NC}"

# Critical patterns that should NEVER be pushed
CRITICAL_PATTERNS=(
    # Service-specific (high confidence)
    'ghp_[a-zA-Z0-9]{36}'
    'github_pat_[a-zA-Z0-9_]{20,}'
    'sk-[a-zA-Z0-9]{20,}'
    'sk-ant-[a-zA-Z0-9-]{20,}'
    'AKIA[0-9A-Z]{16}'
    'xox[bpas]-[0-9]+-[0-9A-Za-z]+'
    'sk_live_[a-zA-Z0-9]{24,}'
    'AIza[0-9A-Za-z_-]{35}'
    '-----BEGIN[A-Z ]*PRIVATE KEY-----'
    'ATATT[a-zA-Z0-9]{20,}'
    'appl_[a-zA-Z0-9]{24,}'
)

# Build pattern
PATTERN=""
for p in "${CRITICAL_PATTERNS[@]}"; do
    if [ -n "$PATTERN" ]; then
        PATTERN="$PATTERN|$p"
    else
        PATTERN="$p"
    fi
done

# Determine commits already present on the actual remote; do not rescan the entire
# published history when creating a release branch. Unknown local objects remain
# in the scan rather than being assumed safe.
REMOTE_TIPS=()
while read -r sha ref; do
	if git cat-file -e "$sha^{commit}" 2>/dev/null; then
		REMOTE_TIPS+=("$sha")
	fi
done < <(git ls-remote --refs "$remote")

FOUND=0
while read -r local_ref local_sha remote_ref remote_sha; do
	if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
		continue
	fi
	if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
		if [ ${#REMOTE_TIPS[@]} -gt 0 ]; then
			COMMITS=$(git rev-list "$local_sha" --not "${REMOTE_TIPS[@]}")
		else
			COMMITS=$(git rev-list "$local_sha")
		fi
	else
		COMMITS=$(git rev-list "$remote_sha..$local_sha")
	fi

	for commit in $COMMITS; do
		while IFS= read -r -d '' file; do
			# Deleted paths have no blob at this revision.
			git cat-file -e "$commit:$file" 2>/dev/null || continue
			# Remove only the two public AWS documentation examples before matching.
			# Other credentials on the same line remain visible to the detector.
			MATCHES=$(git show "$commit:$file" | sed \
				-e 's|AKIAIOSFODNN7EXAMPLE||g' \
				-e 's|wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY||g' \
				| LC_ALL=C grep -I -n -E "$PATTERN" || true)
			if [ -n "$MATCHES" ]; then
				FOUND=1
				printf 'Secret pattern detected in commit %s, file %s (content redacted).\n' "$commit" "$file" >&2
			fi
			if ! git show "$commit:$file" | python3 scripts/utilities/base64-secret-scan.py --path "$file" --revision "$commit"; then
				FOUND=1
			fi
		done < <(git diff-tree --root --no-commit-id --name-only --diff-filter=ACMR -r -z "$commit")
	done
done

if [ $FOUND -eq 1 ]; then
    echo -e "${RED}========================================================================${NC}"
    echo -e "${RED}  PUSH BLOCKED: Secrets detected in commits being pushed!              ${NC}"
    echo -e "${RED}========================================================================${NC}"
    echo ""
    echo "These secrets were likely committed using --no-verify."
    echo ""
    echo -e "${YELLOW}To fix:${NC}"
    echo "  1. Remove the secrets from the affected files"
    echo "  2. Use 'git commit --amend' to fix the last commit, or"
    echo "  3. Use 'git rebase -i' to edit earlier commits"
    echo "  4. Force push may be needed (coordinate with team)"
    echo ""
    exit 1
fi

echo -e "${GREEN}No secrets detected in commits. Proceeding with push.${NC}"
exit 0
