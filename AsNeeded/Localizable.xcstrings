    "We'd love to know how your experience has been with the app so far.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos encantaría saber cómo ha sido tu experiencia con la app hasta ahora."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir würden gerne wissen, welche Erfahrungen du bisher mit der App gemacht hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous aimerions connaître votre avis sur votre expérience avec l’app jusqu’à présent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نود معرفة رأيك في تجربتك مع التطبيق حتى الآن."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשמח לשמוע איך הייתה חוויית השימוש שלך ביישום עד כה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خوشحال می‌شویم بدانیم تا اینجا چه تجربه‌ای از کار با برنامه داشته‌اید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これまでのアプリの使い心地をぜひお聞かせください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще се радваме да разберем какви са впечатленията ви от приложението досега."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ens agradaria saber com ha estat la teva experiència amb l’aplicació fins ara."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rádi bychom věděli, jaké máte s aplikací dosavadní zkušenosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi vil gerne høre, hvordan din oplevelse med appen har været indtil nu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα θέλαμε να μάθουμε πώς είναι η εμπειρία σας με την εφαρμογή μέχρι τώρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'd love to know how your experience has been with the app so far."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "We'd love to know how your experience has been with the app so far."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We'd love to know how your experience has been with the app so far."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos encantaría saber cómo ha sido tu experiencia con la app hasta ahora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluaisimme kuulla, millainen kokemuksesi sovelluksesta on tähän mennessä ollut."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous aimerions savoir comment se passe votre expérience avec l’app jusqu’à maintenant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमें जानकर खुशी होगी कि अब तक ऐप के साथ आपका अनुभव कैसा रहा है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voljeli bismo čuti kakvo je vaše dosadašnje iskustvo s aplikacijom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szívesen megtudnánk, milyenek az eddigi tapasztalataid az alkalmazással."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami ingin mengetahui pengalaman Anda menggunakan aplikasi ini sejauh ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci piacerebbe sapere come ti sei trovato finora con l’app."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданбаны осы уақытқа дейін пайдалану тәжірибеңіз туралы білгіміз келеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금까지 앱을 사용해 보신 소감을 들려주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami ingin mengetahui pengalaman anda menggunakan aplikasi ini setakat ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi vil gjerne høre hvordan du har opplevd appen så langt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We horen graag hoe je de app tot nu toe hebt ervaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chętnie poznamy Twoje dotychczasowe wrażenia z korzystania z aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gostaríamos de saber como tem sido sua experiência com o app até agora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gostaríamos de saber como tem sido a sua experiência com a aplicação até agora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne-ar plăcea să aflăm cum a fost experiența ta cu aplicația până acum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нам хотелось бы узнать о ваших впечатлениях от использования приложения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Radi by sme vedeli, aké sú vaše doterajšie skúsenosti s aplikáciou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi vill gärna veta hur du har upplevt appen hittills."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราอยากทราบว่าประสบการณ์การใช้แอปของคุณจนถึงตอนนี้เป็นอย่างไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdiye kadar uygulamayla ilgili deneyiminizin nasıl olduğunu öğrenmek isteriz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нам було б цікаво дізнатися про ваші враження від користування застосунком."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi rất muốn biết trải nghiệm của bạn với ứng dụng đến nay như thế nào."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "我們想了解你目前使用此 app 的體驗。"
          }
        },
        "zh-Hans": {
