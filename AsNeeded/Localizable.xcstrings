    "Designed by the Braille Institute for greater legibility and readability for low vision readers. Features letterform distinction to increase character recognition.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صمّمه Braille Institute لتحسين وضوح النص وسهولة قراءته لضعاف البصر. يتميّز بأشكال حروف متمايزة لتسهيل التعرّف عليها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Dissenyada pel Braille Institute per a una major llegibilitat i lectura per a lectors amb baixa visió. Presenta distinció de formes de lletres per augmentar el reconeixement de caràcters."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navrženo institutem Braille Institute pro lepší rozlišitelnost a čitelnost pro slabozraké čtenáře. Výrazně odlišné tvary písmen usnadňují rozpoznávání znaků."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Designet af Braille Institute for bedre læsbarhed og læselighed for læsere med nedsat syn. Har letteformsskel for at øge tegnegenkendelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entworfen vom Braille Institute für bessere Lesbarkeit und Erkennbarkeit für Menschen mit Sehbehinderung. Bietet deutliche Buchstabenformen zur Verbesserung der Zeichenerkennung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχεδιάστηκε από το Braille Institute για μεγαλύτερη ευκρίνεια και αναγνωσιμότητα για αναγνώστες με χαμηλή όραση. Διαθέτει διακριτά σχήματα γραμμάτων για ευκολότερη αναγνώριση των χαρακτήρων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Designed by the Braille Institute for greater legibility and readability for low vision readers. Features letterform distinction to increase character recognition."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Designed by the Braille Institute for greater legibility and readability for low vision readers. Features letterform distinction to increase character recognition."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Designed by the Braille Institute for greater legibility and readability for low vision readers. Features letterform distinction to increase character recognition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diseñada por el Instituto Braille para una mayor legibilidad y lectura para personas con baja visión. Presenta distinción de formas de letras para aumentar el reconocimiento de caracteres."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Diseñada por el Instituto Braille para una mayor legibilidad y lectura para personas con baja visión. Presenta distinción de formas de letras para aumentar el reconocimiento de caracteres."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "طراحی‌شده توسط Braille Institute برای وضوح و خوانایی بیشتر برای خوانندگان کم‌بینا. شکل‌های متمایز حروف به تشخیص بهتر نویسه‌ها کمک می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Braille Institute on suunnitellut fontin parantamaan tekstin luettavuutta heikkonäköisille lukijoille. Toisistaan erottuvat kirjainmuodot helpottavat merkkien tunnistamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conçue par le Braille Institute pour une meilleure lisibilité et lecture pour les lecteurs malvoyants. Présente une distinction des formes de lettres pour améliorer la reconnaissance des caractères."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Conçue par le Braille Institute pour une meilleure lisibilité et lecture pour les lecteurs malvoyants. Présente une distinction des formes de lettres pour améliorer la reconnaissance des caractères."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוצב על ידי Braille Institute לשיפור הבהירות וקלות הקריאה עבור אנשים עם ראייה ירודה. כולל צורות אותיות מובחנות כדי להקל על זיהוי התווים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम दृष्टि वाले पाठकों के लिए अक्षरों को अधिक स्पष्ट और पढ़ने में आसान बनाने के उद्देश्य से Braille Institute द्वारा डिज़ाइन किया गया है। इसमें अक्षरों के आकार अलग-अलग हैं, जिससे उन्हें पहचानना आसान होता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Braille Institute tervezte a gyengénlátók számára a jobb olvashatóság érdekében. Jól megkülönböztethető betűformái segítik a karakterek felismerését."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirancang oleh Braille Institute agar lebih mudah dibaca oleh pembaca dengan penglihatan terbatas. Memiliki bentuk huruf yang mudah dibedakan untuk meningkatkan pengenalan karakter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Progettato dal Braille Institute per una maggiore leggibilità e lettura per i lettori ipovedenti. Presenta una distinzione delle forme delle lettere per aumentare il riconoscimento dei caratteri."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көру қабілеті төмен адамдарға әріптерді ажыратуды және оқуды жеңілдету үшін Braille Institute әзірлеген. Таңбаларды тануды жеңілдететін айқын әріп пішіндері бар."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Direka oleh Braille Institute untuk meningkatkan kejelasan dan kebolehbacaan bagi pembaca dengan penglihatan terhad. Menampilkan bentuk huruf yang berbeza untuk memudahkan pengecaman aksara."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Designet av Braille Institute for bedre lesbarhet og leselighet for svaksynte lesere. Har bokstavformskiller for å øke tegngjenkjenning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontworpen door het Braille Institute voor betere leesbaarheid en leesbaarheid voor slechtziende lezers. Kenmerken lettervormdistinctie om karakterherkenning te vergroten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaprojektowano przez Braille Institute z myślą o większej wyrazistości i czytelności dla osób słabowidzących. Wyraźnie zróżnicowane kształty liter ułatwiają rozpoznawanie znaków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Projetada pelo Instituto Braille para maior legibilidade e leitura para pessoas com baixa visão. Apresenta distinção de formas de letras para aumentar o reconhecimento de caracteres."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Concebido pelo Instituto Braille para maior legibilidade e leitura para leitores com baixa visão. Apresenta distinção de formas de letras para aumentar o reconhecimento de caracteres."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Proiectată de Braille Institute pentru o mai bună lizibilitate și citire pentru cititorii cu vedere slabă. Prezintă distincția formelor literelor pentru a crește recunoașterea caracterelor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разработано Брайловским институтом для повышения разборчивости и читаемости для читателей со слабым зрением. Функции различия формы букв для повышения узнавания символов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Designad av Braille Institute för bättre läsbarhet och läslighet för läsare med nedsatt syn. Har bokstavsformsskillnader för att öka teckenigenkänning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกแบบโดย Braille Institute เพื่อให้ผู้ที่มีสายตาเลือนรางมองเห็นตัวอักษรได้ชัดเจนและอ่านง่ายขึ้น รูปทรงตัวอักษรมีความแตกต่างกันอย่างชัดเจนเพื่อช่วยให้จดจำตัวอักษรได้ง่ายขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Az gören okuyucular için harflerin daha kolay ayırt edilmesini ve metnin daha rahat okunmasını sağlamak amacıyla Braille Institute tarafından tasarlanmıştır. Karakterlerin tanınmasını kolaylaştıran, birbirinden farklı harf biçimleri içerir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được Braille Institute thiết kế để giúp người có thị lực kém dễ nhận diện chữ và đọc hơn. Các hình dạng chữ có nét khác biệt giúp tăng khả năng nhận diện ký tự."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "由布萊葉盲文研究所設計，讓低視能讀者更容易辨識和閱讀。透過清晰區分字母形狀，提高字元辨識度。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由美国盲文研究所设计，旨在提升低视力读者辨识和阅读文字的体验。通过增强字形差异，提高字符辨识度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Braille Institute 設計，旨在提升低視能讀者的辨識度與易讀性。透過區別字形設計，讓字元更容易辨識。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "弱視の方が文字を見分けやすく、読みやすくなるようにBraille Instituteが設計しました。文字を認識しやすくするため、字形の違いを明確にしています。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Създаден от Braille Institute за по-голяма четливост и по-лесно четене от хора с намалено зрение. Отличителните форми на буквите улесняват разпознаването на знаците."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Osmislio ga je Braille Institute radi lakšeg raspoznavanja slova i čitanja za slabovidne osobe. Različiti oblici slova olakšavaju prepoznavanje znakova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Braille Institute에서 저시력 독자가 글자를 더 쉽게 식별하고 읽을 수 있도록 설계했습니다. 글자 모양을 뚜렷하게 구분하여 문자 인식을 돕습니다."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Navrhnuté inštitútom Braille Institute na zlepšenie čitateľnosti pre slabozrakých čitateľov. Výrazne odlišné tvary písmen uľahčujú rozpoznávanie znakov."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розроблено Braille Institute для кращої розбірливості та зручності читання людьми зі слабким зором. Відмінні форми літер полегшують розпізнавання символів."
          }
        }
      }
    },
