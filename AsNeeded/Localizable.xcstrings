        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez votre expérience et aidez d’autres personnes à découvrir l’app"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שיתוף החוויה שלך כדי לעזור לאחרים לגלות את היישום"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना अनुभव साझा करें और दूसरों को ऐप खोजने में मदद करें"
