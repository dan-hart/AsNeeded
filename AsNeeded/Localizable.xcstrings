        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر As Needed برایتان مفید است، حمایت از توسعهٔ آن را در نظر بگیرید"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
