          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les quantitats o les unitats de les dosis recents no coincideixen. Revisa l'historial de dosis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
