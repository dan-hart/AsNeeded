          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa AsNeeded lähellä olevassa iPhonessasi ja päivitä sitten."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez AsNeeded sur votre iPhone à proximité, puis actualisez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पास के iPhone पर AsNeeded खोलें, फिर रीफ़्रेश करें।"
