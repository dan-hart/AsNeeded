    "Time Sensitive alerts are off in iOS Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones importantes están desactivadas en Ajustes de iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitkritische Mitteilungen sind in den iOS-Einstellungen deaktiviert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications urgentes sont désactivées dans les réglages d’iOS."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التنبيهات الحساسة للوقت معطلة في إعدادات iOS."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדכונים רגישים לזמן כבויים בהגדרות iOS."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هشدارهای حساس به زمان در تنظیمات iOS خاموش هستند."
          }
        },
        "ja": {
