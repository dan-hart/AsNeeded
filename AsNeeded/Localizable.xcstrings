          "stringUnit": {
            "state": "translated",
            "value": "Συγχρονισμός φαρμάκων και δόσεων με το Apple Health"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronise your medication data with Apple Health for seamless tracking across devices."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronise your medication data with Apple Health for seamless tracking across devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza los datos de tus medicamentos con Apple Health para un seguimiento sin interrupciones en todos los dispositivos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza los datos de tus medicamentos con Apple Health para un seguimiento sin interrupciones en todos los dispositivos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌های داروی خود را با Apple Health برای پیگیری یکپارچه در همه دستگاه‌ها همگام کنید."
