        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Еске салғыш параметрлеріңізді жаңарту мүмкін болмады. Қайталап көріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 설정을 업데이트하지 못했습니다. 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapan peringatan anda tidak dapat dikemas kini. Sila cuba lagi."
