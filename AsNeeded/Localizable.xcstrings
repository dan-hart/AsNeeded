    "Add a positive dose amount and a unit, or leave both blank.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una cantidad de dosis positiva y una unidad, o deja ambos campos en blanco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie eine positive Dosismenge und eine Einheit ein oder lassen Sie beide Felder leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une quantité de dose strictement positive et une unité, ou laissez les deux champs vides."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل مقدار جرعة أكبر من الصفر ووحدة، أو اترك كليهما فارغًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להזין כמות מנה חיובית ויחידה, או להשאיר את שני השדות ריקים."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مقدار دوز مثبت و واحد آن را وارد کنید، یا هر دو را خالی بگذارید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正の投与量と単位を入力するか、両方とも空欄にしてください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въведете положително количество за дозата и мерна единица или оставете и двете полета празни."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix una quantitat de dosi positiva i una unitat, o deixa tots dos camps en blanc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte kladné množství dávky a jednotku, nebo ponechte obě pole prázdná."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv en positiv dosismængde og en enhed, eller lad begge felter stå tomme."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε μια θετική ποσότητα δόσης και μια μονάδα ή αφήστε και τα δύο κενά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a positive dose amount and a unit, or leave both blank."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a positive dose amount and a unit, or leave both blank."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a positive dose amount and a unit, or leave both blank."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega una cantidad de dosis positiva y una unidad, o deja ambos campos en blanco."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää positiivinen annosmäärä ja yksikkö tai jätä molemmat tyhjiksi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une quantité de dose strictement positive et une unité, ou laissez les deux champs vides."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खुराक की धनात्मक मात्रा और इकाई जोड़ें, या दोनों को खाली छोड़ दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesi količinu doze veću od nule i jedinicu ili ostavi oba polja prazna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon meg pozitív adagmennyiséget és egységet, vagy hagyja mindkettőt üresen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan jumlah dosis positif beserta satuannya, atau biarkan keduanya kosong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci una quantità positiva per la dose e un'unità, oppure lascia entrambi i campi vuoti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозаның оң мөлшерін және бірлігін қосыңыз немесе екеуін де бос қалдырыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양수인 복용량과 단위를 입력하거나 둘 다 비워 두세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah jumlah dos positif dan unit, atau biarkan kedua-duanya kosong."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en positiv dosemengde og en enhet, eller la begge feltene stå tomme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een positieve dosishoeveelheid en een eenheid toe, of laat beide leeg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz dawkę większą od zera i jednostkę lub pozostaw oba pola puste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma quantidade de dose positiva e uma unidade, ou deixe ambos os campos em branco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma quantidade de dose positiva e uma unidade, ou deixe ambos os campos em branco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă o cantitate pozitivă pentru doză și o unitate de măsură sau lasă ambele câmpuri necompletate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите положительное значение дозы и единицу измерения или оставьте оба поля пустыми."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadajte kladné množstvo dávky a jednotku alebo nechajte obe polia prázdne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange en positiv dosmängd och en enhet, eller lämna båda fälten tomma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มปริมาณยาที่เป็นจำนวนบวกและหน่วย หรือเว้นว่างทั้งสองช่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozitif bir doz miktarı ve birim ekleyin veya ikisini de boş bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкажіть кількість дози, більшу за нуль, та одиницю вимірювання або залиште обидва поля порожніми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm lượng dùng lớn hơn không và đơn vị, hoặc để trống cả hai."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入大於零的用藥劑量及單位，或將兩者都留空。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入大于零的剂量和单位，或将两项均留空。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入大於零的用藥劑量及單位，或將兩者都留白。"
          }
        }
      }
    },
    "Add a prescribed dose and unit to use a maximum amount in 24 hours.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una dosis prescrita y una unidad para usar una cantidad máxima en 24 horas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie eine verordnete Dosis und eine Einheit ein, um eine Höchstmenge innerhalb von 24 Stunden zu verwenden."
