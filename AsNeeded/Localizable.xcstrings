    "Logged %@ %@ of %@": {
      "comment": "A response message displayed to the user after successfully logging a medication dose. The first argument is the amount of the medication taken. The second argument is the unit of measurement. The third argument is the name of the medication.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
