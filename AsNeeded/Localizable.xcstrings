    "This report summarizes self-logged medication history. It may be incomplete or incorrect and should not replace clinical judgment.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este informe resume el historial de medicamentos registrado por el propio usuario. Puede estar incompleto o contener errores y no debe sustituir el criterio clínico."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
