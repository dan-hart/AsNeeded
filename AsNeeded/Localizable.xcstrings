    "Local medication history, with sharing and backups you control": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Historial local de medicamentos, con opciones para compartir y copias de seguridad que tú controlas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokaler Medikamentenverlauf mit Freigaben und Sicherungen, die du selbst kontrollierst"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Historique des médicaments conservé localement, avec un partage et des sauvegardes que vous contrôlez"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجل أدوية محلي، مع مشاركة ونسخ احتياطية تتحكم بها"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היסטוריית תרופות מקומית, עם שיתוף וגיבויים בשליטתך"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سابقهٔ دارویی روی دستگاه، با اشتراک‌گذاری و پشتیبان‌گیری تحت کنترل شما"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末内に保存する服薬履歴。共有とバックアップはご自身で管理できます"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Локална история на лекарствата със споделяне и резервни копия под ваш контрол"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Historial de medicació local, amb compartició i còpies de seguretat que controles tu"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místní historie užívání léků se sdílením a zálohami pod vaší kontrolou"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal medicinhistorik med deling og sikkerhedskopier, som du styrer"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τοπικό ιστορικό φαρμάκων, με κοινοποίηση και αντίγραφα ασφαλείας που ελέγχετε εσείς"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local medication history, with sharing and backups you control"
          }
        },
        "en-AU": {
          "stringUnit": {
