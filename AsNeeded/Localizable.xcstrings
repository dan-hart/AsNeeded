    "Purchase options are temporarily unavailable. You can keep using every feature.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las opciones de compra no están disponibles temporalmente. Puedes seguir usando todas las funciones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaufoptionen sind vorübergehend nicht verfügbar. Du kannst weiterhin alle Funktionen nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les options d’achat sont temporairement indisponibles. Vous pouvez continuer à utiliser toutes les fonctionnalités."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خيارات الشراء غير متاحة مؤقتًا. يمكنك الاستمرار في استخدام جميع الميزات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשרויות הרכישה אינן זמינות זמנית. ניתן להמשיך להשתמש בכל התכונות."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گزینه‌های خرید موقتاً در دسترس نیستند. می‌توانید به استفاده از همهٔ قابلیت‌ها ادامه دهید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入オプションを一時的に利用できません。すべての機能は引き続きご利用いただけます。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Опциите за покупка временно не са налични. Можете да продължите да използвате всички функции."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opcions de compra no estan disponibles temporalment. Pots continuar fent servir totes les funcions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Možnosti nákupu jsou dočasně nedostupné. Všechny funkce můžete dál používat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Købsmulighederne er midlertidigt utilgængelige. Du kan fortsat bruge alle funktioner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι επιλογές αγοράς δεν είναι προσωρινά διαθέσιμες. Μπορείτε να συνεχίσετε να χρησιμοποιείτε όλες τις λειτουργίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase options are temporarily unavailable. You can keep using every feature."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase options are temporarily unavailable. You can keep using every feature."
          }
        },
        "en-GB": {
