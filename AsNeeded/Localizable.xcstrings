    "Import failed: Unable to access the selected file. Please try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error al importar: no se puede acceder al archivo seleccionado. Inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Import fehlgeschlagen: Auf die ausgewählte Datei kann nicht zugegriffen werden. Bitte versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’importation : impossible d’accéder au fichier sélectionné. Veuillez réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل الاستيراد: تعذّر الوصول إلى الملف المحدّد. يُرجى المحاولة مجددًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הייבוא נכשל: לא ניתן לגשת לקובץ שנבחר. יש לנסות שוב."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "واردکردن ناموفق بود: دسترسی به فایل انتخاب‌شده امکان‌پذیر نیست. لطفاً دوباره تلاش کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートに失敗しました：選択したファイルにアクセスできません。もう一度お試しください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Неуспешно импортиране: Няма достъп до избрания файл. Моля, опитайте отново."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La importació ha fallat: no es pot accedir al fitxer seleccionat. Torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Import se nezdařil: K vybranému souboru nelze získat přístup. Zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Import mislykkedes: Kan ikke få adgang til den valgte fil. Prøv igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εισαγωγή απέτυχε: Δεν είναι δυνατή η πρόσβαση στο επιλεγμένο αρχείο. Δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import failed: Unable to access the selected file. Please try again."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Import failed: Unable to access the selected file. Please try again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Import failed: Unable to access the selected file. Please try again."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Error al importar: no se puede acceder al archivo seleccionado. Inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuonti epäonnistui: valittuun tiedostoon ei saatu pääsyä. Yritä uudelleen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’importation : impossible d’accéder au fichier sélectionné. Veuillez réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आयात विफल रहा: चुनी गई फ़ाइल तक पहुँच नहीं हो सकी। कृपया फिर प्रयास करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvoz nije uspio: nije moguće pristupiti odabranoj datoteci. Pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az importálás sikertelen: a kiválasztott fájl nem érhető el. Próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor gagal: Tidak dapat mengakses file yang dipilih. Silakan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importazione non riuscita: impossibile accedere al file selezionato. Riprova."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорттау сәтсіз аяқталды: таңдалған файлға қол жеткізу мүмкін емес. Қайталап көріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기 실패: 선택한 파일에 접근할 수 없습니다. 다시 시도해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Import gagal: Tidak dapat mengakses fail yang dipilih. Sila cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Import mislyktes: Fikk ikke tilgang til den valgte filen. Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeren mislukt: geen toegang tot het geselecteerde bestand. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Import nie powiódł się: nie można uzyskać dostępu do wybranego pliku. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na importação: não foi possível acessar o arquivo selecionado. Tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na importação: não foi possível aceder ao ficheiro selecionado. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Importul a eșuat: fișierul selectat nu poate fi accesat. Încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось импортировать: нет доступа к выбранному файлу. Повторите попытку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Import zlyhal: Nie je možné získať prístup k vybranému súboru. Skúste to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Importen misslyckades: Det gick inte att komma åt den valda filen. Försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำเข้าไม่สำเร็จ: ไม่สามารถเข้าถึงไฟล์ที่เลือกได้ โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarma başarısız oldu: Seçilen dosyaya erişilemiyor. Lütfen tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося імпортувати: немає доступу до вибраного файлу. Спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập thất bại: Không thể truy cập tệp đã chọn. Vui lòng thử lại."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入失敗：無法存取所選檔案。請再試一次。"
          }
