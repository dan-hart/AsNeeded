    "The total allowed in any 24 hours, including the next dose. This does not reset at midnight.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کل مقدار مجاز در هر بازهٔ ۲۴ ساعته، شامل نوبت مصرف بعدی. این مقدار در نیمه‌شب صفر نمی‌شود."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El total permitido en cualquier período de 24 horas, incluida la siguiente dosis. No se reinicia a medianoche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die zulässige Gesamtmenge innerhalb eines beliebigen Zeitraums von 24 Stunden, einschließlich der nächsten Dosis. Sie wird nicht um Mitternacht zurückgesetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La quantité totale autorisée sur toute période de 24 heures, prochaine dose comprise. Ce total n’est pas remis à zéro à minuit."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إجمالي الكمية المسموح بها خلال أي فترة من 24 ساعة، بما يشمل الجرعة التالية. لا يبدأ هذا الحد من جديد عند منتصف الليل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכמות הכוללת המותרת בכל פרק זמן של 24 שעות, כולל המנה הבאה. הספירה אינה מתאפסת בחצות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の服用分を含む、任意の連続した24時間内に許容される合計量です。午前0時にはリセットされません。"
