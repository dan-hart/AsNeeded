          "stringUnit": {
            "state": "translated",
            "value": "Күн аяқталғаннан кейін қабылдау уақыттарының заңдылықтарын көру үшін бірнеше дозаны тіркеңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복용을 몇 차례 기록하면 하루가 끝난 후 복용 시간 패턴을 확인할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekodkan beberapa dos untuk melihat corak masa selepas hari berakhir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrer noen doser for å se tidsmønstre etter at dagen er over."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreer een paar doses om na afloop van de dag patronen in de innametijden te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarejestruj kilka dawek, aby po zakończeniu dnia zobaczyć wzorce czasowe ich przyjmowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre algumas doses para ver padrões de horário após o fim do dia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Registe algumas doses para ver padrões de horários após o fim do dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează câteva doze pentru a vedea tiparele orelor de administrare după încheierea zilei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите несколько приёмов, чтобы увидеть закономерности времени приёма после завершения дня."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenajte niekoľko dávok a po skončení dňa si pozrite časové vzorce užívania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrera några doser för att se tidsmönster när dagen är slut."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกการใช้ยาสองสามครั้งเพื่อดูรูปแบบเวลาเมื่อสิ้นสุดวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün tamamlandıktan sonra zamanlama örüntülerini görmek için birkaç doz kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть кілька доз, щоб після завершення дня побачити закономірності часу прийому."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi nhận vài liều để xem quy luật về thời gian dùng sau khi ngày kết thúc."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄幾次用藥，即可在當天結束後查看用藥時間規律。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录几次用药，在当天结束后查看用药时间规律。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄幾次用藥，即可在當天結束後查看用藥時間規律。"
          }
        }
      }
    },
