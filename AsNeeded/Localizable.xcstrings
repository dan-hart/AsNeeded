            "value": "Yakınınızdaki iPhone üzerinde AsNeeded uygulamasını açın, ardından yenileyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте AsNeeded на своєму iPhone поблизу, а потім оновіть дані."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở AsNeeded trên iPhone ở gần bạn, rồi làm mới."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在附近的 iPhone 上開啟 AsNeeded，然後重新整理。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
