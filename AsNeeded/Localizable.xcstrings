    "Backups occur 5 seconds after logging a dose. Multiple doses trigger one backup to save battery. Use 'Backup Now' for immediate backups.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخ تحدث بعد 5 ثوان. دوزات متعددة تؤدي لنسخة واحدة. استخدم 'الآن' للحفظ الفوري."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les còpies de seguretat es fan 5 segons després de registrar una dosi. Si registres diverses dosis, es fa una sola còpia per estalviar bateria. Utilitza «Fes una còpia de seguretat ara» per fer còpies immediates."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zálohování probíhá 5 sekund po zaznamenání dávky. Více dávek spustí jedinou zálohu, aby se šetřila baterie. Pro okamžité zálohování použijte volbu „Zálohovat nyní“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikkerhedskopier forekommer 5 sekunder efter at have logget en dosis. Flere doser udløser en sikkerhedskopi for at spare batteri. Brug 'Sikkerhedskopi nu' for øjeblikkelige sikkerhedskopier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherungen finden 5 Sekunden nach dem Protokollieren einer Dosis statt. Mehrere Dosen lösen eine Sicherung aus, um Batterie zu sparen. Verwenden Sie 'Jetzt sichern' für sofortige Sicherungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα αντίγραφα ασφαλείας δημιουργούνται 5 δευτερόλεπτα μετά την καταγραφή μιας δόσης. Η καταγραφή πολλών δόσεων ενεργοποιεί τη δημιουργία ενός μόνο αντιγράφου ασφαλείας για εξοικονόμηση μπαταρίας. Χρησιμοποιήστε την επιλογή «Δημιουργία αντιγράφου ασφαλείας τώρα» για άμεση δημιουργία αντιγράφων ασφαλείας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups occur 5 seconds after logging a dose. Multiple doses trigger one backup to save battery. Use 'Backup Now' for immediate backups."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups occur 5 seconds after logging a dose. Multiple doses trigger one backup to save battery. Use 'Backup Now' for immediate backups."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias de seguridad se realizan 5 segundos después de registrar una dosis. Múltiples dosis desencadenan una copia de seguridad para ahorrar batería. Usa 'Crear copia de seguridad ahora' para copias de seguridad inmediatas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias de seguridad se realizan 5 segundos después de registrar una dosis. Múltiples dosis desencadenan una copia de seguridad para ahorrar batería. Usa 'Crear copia de seguridad ahora' para copias de seguridad inmediatas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پشتیبان‌گیری‌ها 5 ثانیه بعد دوز رخ می‌دهند. دوزهای متعدد یک نسخه تریگر می‌کنند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmuuskopiointi tehdään 5 sekunnin kuluttua annoksen kirjaamisesta. Useiden annosten kirjaaminen käynnistää vain yhden varmuuskopioinnin akun säästämiseksi. Voit varmuuskopioida heti valitsemalla ”Varmuuskopioi nyt”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes sont effectuées 5 secondes après l’enregistrement d’une prise. Plusieurs prises déclenchent une seule sauvegarde pour économiser la batterie. Utilisez « Sauvegarder maintenant » pour effectuer une sauvegarde immédiate."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes sont effectuées 5 secondes après la consignation d’une dose. Plusieurs doses déclenchent une seule sauvegarde pour économiser la batterie. Utilisez « Sauvegarder maintenant » pour effectuer une sauvegarde immédiate."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גיבויים מתרחשים אחרי 5 שניות. דוזות מתעלות גיבוי אחד. השתמש 'עכשיו'."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक खुराक लॉग करने के 5 सेकंड बाद बैकअप होता है। कई खुराक बैटरी बचाने के लिए एक बैकअप ट्रिगर करती हैं। तत्काल बैकअप के लिए 'अभी बैकअप करें' का उपयोग करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A biztonsági mentés az adag rögzítése után 5 másodperccel készül el. Több adag rögzítése egyetlen biztonsági mentést indít az akkumulátor kímélése érdekében. Azonnali mentéshez használja a „Biztonsági mentés most” lehetőséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencadangan dilakukan 5 detik setelah mencatat dosis. Beberapa dosis memicu satu pencadangan untuk menghemat baterai. Gunakan 'Cadangkan Sekarang' untuk langsung mencadangkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I backup vengono eseguiti 5 secondi dopo la registrazione di una dose. Più dosi generano un solo backup per risparmiare batteria. Usa 'Esegui backup ora' per eseguire subito un backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "用量をログに記録した後5秒でバックアップが発生します。複数の用量は1つのバックアップをトリガーしてバッテリーを節約します。即座のバックアップには「今すぐバックアップ」を使用してください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозасын журналға жазғаннан 5 секунд өткен соң сақтық көшірмелер орын алады। Бірнеше дозалар батареяны сөндіру үшін бір сақтық көшірме тіргендіреді। Лезде сақтық көшірмелер үшін 'Қазір сақтық көшіре' пайдаланыңыз।"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용량 기록 후 5초 후에 백업이 발생합니다. 여러 용량은 하나의 백업을 트리거하여 배터리를 절약합니다. 즉시 백업하려면 '지금 백업'을 사용하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandaran dibuat 5 saat selepas merekodkan dos. Beberapa dos mencetuskan satu sandaran untuk menjimatkan bateri. Gunakan 'Sandarkan Sekarang' untuk membuat sandaran serta-merta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikkerhetskopier oppstår 5 sekunder etter å ha logget en dose. Flere doser utløser en sikkerhetskopi for å spare batteri. Bruk 'Sikkerhetskopi nå' for umiddelbare sikkerhetskopier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Back-ups worden 5 seconden na het registreren van een dosis uitgevoerd. Meerdere doses triggeren één back-up om batterij te sparen. Gebruik 'Nu back-up maken' voor onmiddellijke back-ups."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie zapasowe są tworzone 5 sekund po zapisaniu dawki. Zapisanie wielu dawek powoduje utworzenie jednej kopii, aby oszczędzać baterię. Użyj opcji „Utwórz kopię zapasową teraz”, aby utworzyć kopię natychmiast."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os backups ocorrem 5 segundos após registrar uma dose. Múltiplas doses acionam um backup para economizar bateria. Use 'Fazer Backup Agora' para backups imediatos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As cópias de segurança ocorrem 5 segundos após registar uma dose. Múltiplas doses acionam uma cópia de segurança para economizar bateria. Use 'Fazer Cópia de Segurança Agora' para cópias de segurança imediatas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiile de siguranță sunt create la 5 secunde după înregistrarea unei doze. Mai multe doze declanșează crearea unei singure copii de siguranță pentru a economisi bateria. Folosește „Creează o copie de siguranță acum” pentru copii de siguranță imediate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервные копии создаются через 5 секунд после регистрации дозы. Несколько доз запускают одну резервную копию для экономии батареи. Используйте 'Резервная копия сейчас' для немедленных резервных копий."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säkerhetskopior sker 5 sekunder efter att ha loggat en dos. Flera doser utlöser en säkerhetskopia för att spara batteri. Använd 'Säkerhetskopiera nu' för omedelbar säkerhetskopiering."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปจะสำรองข้อมูลหลังบันทึกการใช้ยา 5 วินาที การบันทึกการใช้ยาหลายครั้งจะรวมเป็นการสำรองข้อมูลครั้งเดียวเพื่อประหยัดแบตเตอรี่ ใช้ 'สำรองข้อมูลตอนนี้' เพื่อสำรองข้อมูลทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir dozu kaydettikten 5 saniye sonra yedeklemeler oluşur। Çoklu dozlar pili tasarrufu için bir yedeklemeyi tetikler। Anında yedeklemeler için 'Şimdi Yedekle' kullanın।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu được sao lưu 5 giây sau khi ghi lại một liều. Nhiều liều được gộp vào một lần sao lưu để tiết kiệm pin. Dùng 'Sao lưu ngay' để sao lưu tức thì."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄用藥後 5 秒會進行備份。記錄多次用藥只會觸發一次備份，以節省電池用量。如需立即備份，請使用「立即備份」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份会在记录用药后 5 秒进行。多次用药记录会合并触发一次备份，以节省电量。如需立即备份，请使用“立即备份”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份會在記錄用藥後 5 秒進行。記錄多次用藥只會觸發一次備份，以節省電力。若要立即備份，請使用「立即備份」。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервните копия се създават 5 секунди след записване на доза. При записване на няколко дози се създава едно резервно копие, за да се пести батерия. Използвайте „Архивиране сега“ за незабавно създаване на резервно копие."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups occur 5 seconds after logging a dose. Multiple doses trigger one backup to save battery. Use 'Backup Now' for immediate backups."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurnosne kopije izrađuju se 5 sekundi nakon bilježenja doze. Više doza pokreće izradu jedne sigurnosne kopije radi uštede baterije. Za trenutačnu izradu sigurnosne kopije odaberi „Izradi sigurnosnu kopiju sada”."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zálohovanie sa spustí 5 sekúnd po zaznamenaní dávky. Viaceré dávky spustia jedno zálohovanie, aby sa šetrila batéria. Na okamžité zálohovanie použite možnosť „Zálohovať teraz“."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервні копії створюються через 5 секунд після запису дози. Кілька доз запускають одне резервне копіювання для економії заряду. Скористайтеся функцією «Створити резервну копію зараз» для негайного копіювання."
          }
        }
      }
    },
    "Backups older than %lld days are automatically deleted to save space": {
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تُحذف تلقائيًا النسخ الاحتياطية الأقدم من %lld أيام لتوفير المساحة"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تُحذف تلقائيًا النسخ الاحتياطية الأقدم من %lld يومًا لتوفير المساحة"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تُحذف تلقائيًا النسخ الاحتياطية الأقدم من يوم واحد (%lld) لتوفير المساحة"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تُحذف تلقائيًا النسخ الاحتياطية الأقدم من %lld يوم لتوفير المساحة"
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تُحذف تلقائيًا النسخ الاحتياطية الأقدم من يومين (%lld) لتوفير المساحة"
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تُحذف تلقائيًا النسخ الاحتياطية الأقدم من %lld يوم لتوفير المساحة"
                }
              }
            }
          }
        },
        "ca": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les còpies de seguretat de fa més de %lld dies s'eliminen automàticament per estalviar espai"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les còpies de seguretat de fa més de %lld dia s'eliminen automàticament per estalviar espai"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les còpies de seguretat de fa més de %lld dies s'eliminen automàticament per estalviar espai"
                }
              }
            }
          }
        },
        "cs": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Zálohy starší než %lld dny se automaticky mažou, aby se uvolnilo místo"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Zálohy starší než %lld dne se automaticky mažou, aby se uvolnilo místo"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Zálohy starší než %lld den se automaticky mažou, aby se uvolnilo místo"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Zálohy starší než %lld dní se automaticky mažou, aby se uvolnilo místo"
                }
              }
            }
          }
        },
        "da": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Sikkerhedskopier, der er ældre end %lld dag, slettes automatisk for at spare plads"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Sikkerhedskopier, der er ældre end %lld dage, slettes automatisk for at spare plads"
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Sicherungen, die älter als %lld Tag sind, werden automatisch gelöscht, um Speicherplatz zu sparen"
                }
