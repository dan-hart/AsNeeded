        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les options d’achat sont temporairement indisponibles. Vous pouvez continuer à utiliser toutes les fonctionnalités."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरीद के विकल्प अस्थायी रूप से उपलब्ध नहीं हैं। आप हर सुविधा का उपयोग जारी रख सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mogućnosti kupnje privremeno su nedostupne. Možete nastaviti koristiti sve značajke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vásárlási lehetőségek átmenetileg nem érhetők el. Továbbra is minden funkciót használhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsi pembelian untuk sementara tidak tersedia. Anda dapat tetap menggunakan semua fitur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le opzioni di acquisto sono temporaneamente non disponibili. Puoi continuare a usare tutte le funzionalità."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сатып алу нұсқалары уақытша қолжетімсіз. Барлық мүмкіндікті пайдалануды жалғастыра аласыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시적으로 구매 옵션을 사용할 수 없습니다. 모든 기능은 계속 사용할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan pembelian tidak tersedia buat sementara waktu. Anda boleh terus menggunakan semua ciri."
          }
        },
        "nb": {
          "stringUnit": {
