    "Manage backups, export or import your data, and choose your privacy settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona las copias de seguridad, exporta o importa tus datos y elige tus ajustes de privacidad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalte Sicherungen, exportiere oder importiere deine Daten und wähle deine Datenschutzeinstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez les sauvegardes, exportez ou importez vos données et choisissez vos paramètres de confidentialité."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدِر النسخ الاحتياطية، وصدّر بياناتك أو استوردها، واختر إعدادات الخصوصية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניהול גיבויים, ייצוא או ייבוא הנתונים שלך ובחירת הגדרות הפרטיות שלך."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخه‌های پشتیبان را مدیریت کنید، از داده‌هایتان خروجی بگیرید یا آن‌ها را وارد کنید و تنظیمات حریم خصوصی را انتخاب کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップの管理、データのエクスポートやインポート、プライバシー設定の選択ができます。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Управлявайте резервните копия, експортирайте или импортирайте данните си и изберете настройките си за поверителност."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona les còpies de seguretat, exporta o importa les teves dades i tria la configuració de privacitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spravujte zálohy, exportujte nebo importujte data a zvolte si nastavení soukromí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrer sikkerhedskopier, eksportér eller importér dine data, og vælg dine anonymitetsindstillinger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαχειριστείτε αντίγραφα ασφαλείας, εξαγάγετε ή εισαγάγετε τα δεδομένα σας και επιλέξτε τις ρυθμίσεις απορρήτου σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage backups, export or import your data, and choose your privacy settings."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage backups, export or import your data, and choose your privacy settings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage backups, export or import your data, and choose your privacy settings."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Administra copias de seguridad, exporta o importa tus datos y elige tu configuración de privacidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallitse varmuuskopioita, vie tai tuo tietojasi ja valitse tietosuoja-asetuksesi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez les sauvegardes, exportez ou importez vos données et choisissez vos réglages de confidentialité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकअप प्रबंधित करें, अपना डेटा निर्यात या आयात करें और अपनी गोपनीयता सेटिंग्स चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravljajte sigurnosnim kopijama, izvezite ili uvezite podatke i odaberite postavke privatnosti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezelje a biztonsági mentéseket, exportálja vagy importálja adatait, és válassza ki adatvédelmi beállításait."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelola cadangan, ekspor atau impor data Anda, dan pilih pengaturan privasi Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci i backup, esporta o importa i tuoi dati e scegli le impostazioni sulla privacy."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сақтық көшірмелерді басқарыңыз, деректеріңізді экспорттаңыз немесе импорттаңыз және құпиялық баптауларын таңдаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업을 관리하고, 데이터를 내보내거나 가져오고, 개인정보 보호 설정을 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Urus sandaran, eksport atau import data anda, dan pilih tetapan privasi anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrer sikkerhetskopier, eksporter eller importer dataene dine, og velg personverninnstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer reservekopieën, exporteer of importeer je gegevens en kies je privacyinstellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarządzaj kopiami zapasowymi, eksportuj lub importuj dane i wybieraj ustawienia prywatności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie backups, exporte ou importe seus dados e escolha suas configurações de privacidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira cópias de segurança, exporte ou importe os seus dados e escolha as suas definições de privacidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestionează copiile de siguranță, exportă sau importă datele și alege setările de confidențialitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляйте резервными копиями, экспортируйте и импортируйте данные и выбирайте настройки конфиденциальности."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spravujte zálohy, exportujte alebo importujte svoje údaje a vyberte si nastavenia súkromia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantera säkerhetskopior, exportera eller importera dina data och välj dina integritetsinställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดการข้อมูลสำรอง ส่งออกหรือนำเข้าข้อมูลของคุณ และเลือกการตั้งค่าความเป็นส่วนตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekleri yönetin, verilerinizi dışa veya içe aktarın ve gizlilik ayarlarınızı seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керуйте резервними копіями, експортуйте чи імпортуйте дані та вибирайте параметри конфіденційності."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản lý bản sao lưu, xuất hoặc nhập dữ liệu và chọn cài đặt quyền riêng tư."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "管理備份、匯出或匯入資料，以及選擇私隱設定。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理备份、导出或导入数据，并选择隐私设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "管理備份、匯出或匯入資料，以及選擇隱私設定。"
          }
        }
      }
    },
