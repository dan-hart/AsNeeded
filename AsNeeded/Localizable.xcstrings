    "This action cannot be undone. All history and reminders for this medication will be deleted.": {
      "comment": "A message displayed when the user attempts to delete a medication, explaining that the action cannot be undone.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع عن هذا الإجراء. سيتم حذف كل السجلّ والتذكيرات المتعلقة بهذا الدواء."
          }
        },
        "ca": {
          "stringUnit": {
