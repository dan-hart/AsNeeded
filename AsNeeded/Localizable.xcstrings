        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțiunile de achiziție sunt temporar indisponibile. Poți folosi în continuare toate funcțiile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Варианты покупки временно недоступны. Вы можете продолжать пользоваться всеми функциями."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Možnosti nákupu sú dočasne nedostupné. Všetky funkcie môžete naďalej používať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köpalternativen är tillfälligt otillgängliga. Du kan fortsätta använda alla funktioner."
