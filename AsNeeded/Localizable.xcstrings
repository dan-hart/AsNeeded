          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous vos médicaments sont bien approvionnés. Aucun renouvellement n'est nécessaire pour le moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל התרופות שלך במלאי טוב. אין צורך בתחלופה עכשיו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सभी दवाएं अच्छी तरह स्टॉक में हैं। अभी कोई रिफिल की आवश्यकता नहीं है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden gyógyszeréből elegendő készlet áll rendelkezésre. Jelenleg nincs szükség készletfeltöltésre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Persediaan semua obat Anda mencukupi. Saat ini tidak perlu isi ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i tuoi farmaci sono ben forniti. Nessun rifornimento necessario in questo momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての医薬品が十分に在庫されています。現在、補充の必要はありません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сіздің барлық дәрі-дәрмандарыңыз жақсы қойылымында. Қазір рефильдеу қажет емес."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 의약품이 충분히 재고되어 있습니다. 지금 보충이 필요하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekalan semua ubat anda mencukupi. Tiada bekalan semula diperlukan buat masa ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle legemidlene dine er godt forsynt. Ingen påfyllinger nødvendig nå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al uw medicijnen zijn goed op voorraad. Geen vullingen nodig op dit moment."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz wystarczający zapas wszystkich leków. Obecnie nie trzeba go uzupełniać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os seus medicamentos estão bem abastecidos. Nenhum reabastecimento necessário agora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os seus medicamentos estão bem abastecidos. Nenhum reabastecimento necessário agora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai stocuri suficiente pentru toate medicamentele. Nu este necesară reaprovizionarea acum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все ваши лекарства хорошо в наличии. Повторное заполнение сейчас не требуется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla dina läkemedel är väl försörjda. Inga påfyllningar behövs för närvarande."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยาทุกรายการของคุณมีเพียงพอ ขณะนี้ยังไม่ต้องเติมยา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm ilaclarınız yeterince stokta. Şu anda yenileme gerekmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả thuốc của bạn đều còn đủ. Hiện chưa cần bổ sung thuốc."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你的所有藥物備存充足。現時無需補充。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的所有药物库存充足。目前无需补充。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的所有藥物庫存充足。目前無需補充。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Имате достатъчно запаси от всички лекарства. В момента не е необходимо попълване на запасите."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your medications are well stocked. No refills needed right now."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalihe svih tvojih lijekova su dovoljne. Trenutačno ih nije potrebno nadopunjavati."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Máte dostatočné zásoby všetkých liekov. Momentálne ich netreba dopĺňať."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас достатній запас усіх препаратів. Наразі поповнення не потрібне."
          }
        }
      }
    },
