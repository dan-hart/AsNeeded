    "Saved context from this dose stays attached when you update the note.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contexto guardado de esta dosis sigue asociado cuando actualizas la nota."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gespeicherte Kontext dieser Dosis bleibt zugeordnet, wenn du die Notiz aktualisierst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contexte enregistré pour cette dose reste associé lorsque vous modifiez la note."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى المعلومات السياقية المحفوظة لهذه الجرعة مرفقة عند تحديث الملاحظة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פרטי ההקשר שנשמרו עבור מנה זו יישארו מצורפים בעת עדכון ההערה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام به‌روزرسانی یادداشت، اطلاعات زمینه‌ای ذخیره‌شدهٔ این نوبت مصرف همچنان به آن پیوست می‌ماند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモを更新しても、この服用時に保存された関連情報は引き続き紐付けられます。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запазеният контекст за тази доза остава прикрепен, когато актуализирате бележката."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El context desat d'aquesta dosi es manté associat quan actualitzes la nota."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložené souvislosti této dávky zůstanou připojené i po úpravě poznámky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemt kontekst fra denne dosis forbliver tilknyttet, når du opdaterer noten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αποθηκευμένες συνοδευτικές πληροφορίες αυτής της δόσης παραμένουν συνδεδεμένες όταν ενημερώνετε τη σημείωση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved context from this dose stays attached when you update the note."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved context from this dose stays attached when you update the note."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved context from this dose stays attached when you update the note."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El contexto guardado de esta dosis permanece adjunto cuando actualizas la nota."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tähän annokseen tallennetut taustatiedot säilyvät mukana, kun päivität muistiinpanoa."
          }
        },
