          "stringUnit": {
            "state": "translated",
            "value": "दवा का विवरण देखने के लिए सक्रिय करें। क्लिपबोर्ड पर कॉपी करने के लिए नाम कॉपी करें का उपयोग करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivirajte za prikaz pojedinosti o lijeku. Upotrijebite Kopiraj naziv za kopiranje u međuspremnik"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiválja a gyógyszer adatainak megtekintéséhez. A vágólapra másoláshoz használja a Név másolása lehetőséget"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan untuk melihat detail obat. Gunakan Salin nama untuk menyalin ke papan klip"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva per visualizzare i dettagli del farmaco. Usa Copia nome per copiarlo negli appunti"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дәрі туралы мәліметтерді көру үшін белсендіріңіз. Алмасу буферіне көшіру үшін «Атауды көшіру» пәрменін пайдаланыңыз"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하여 약물 상세 정보를 확인하세요. 클립보드에 복사하려면 이름 복사를 사용하세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan untuk melihat butiran ubat. Gunakan Salin nama untuk menyalin ke papan klip"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiver for å vise legemiddeldetaljer. Bruk Kopier navn for å kopiere til utklippstavlen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Activeer om medicijndetails te bekijken. Gebruik Naam kopiëren om naar het klembord te kopiëren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywuj, aby wyświetlić szczegóły leku. Użyj opcji Kopiuj nazwę, aby skopiować ją do schowka"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative para ver os detalhes do medicamento. Use Copiar nome para copiar para a área de transferência"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative para ver os detalhes do medicamento. Utilize Copiar nome para copiar para a área de transferência"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activează pentru a vedea detaliile medicamentului. Folosește Copiază numele pentru a-l copia în clipboard"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активируйте, чтобы посмотреть сведения о лекарстве. Используйте «Скопировать название» для копирования в буфер обмена"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivovaním zobrazíte podrobnosti o lieku. Pomocou možnosti Kopírovať názov ho skopírujete do schránky"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera för att visa läkemedelsdetaljer. Använd Kopiera namn för att kopiera till urklipp"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้งานเพื่อดูรายละเอียดยา ใช้คัดลอกชื่อเพื่อคัดลอกไปยังคลิปบอร์ด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlaç ayrıntılarını görüntülemek için etkinleştirin. Panoya kopyalamak için Adı kopyala seçeneğini kullanın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Активуйте, щоб переглянути відомості про препарат. Скористайтеся дією «Копіювати назву», щоб скопіювати її в буфер обміну"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kích hoạt để xem chi tiết thuốc. Dùng Sao chép tên để sao chép vào bảng nhớ tạm"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用以查看藥物詳細資料。使用「複製名稱」將名稱複製到剪貼簿"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "激活以查看药物详情。使用“复制名称”可复制到剪贴板"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用以查看藥物詳細資料。使用「複製名稱」將名稱複製到剪貼簿"
          }
        }
      }
