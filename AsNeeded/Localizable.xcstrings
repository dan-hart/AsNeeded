    "healthkit.settings.disconnectWarning": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي قطع الاتصال إلى إيقاف المزامنة مع Apple Health. لن يتم حذف بياناتك الحالية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прекъсването на връзката ще спре синхронизацията с Apple Health. Съществуващите ви данни няма да бъдат изтрити."
          }
        },
        "ca": {
          "stringUnit": {
