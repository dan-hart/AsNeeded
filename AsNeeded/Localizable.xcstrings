    "Check the medication, dose amount, and unit, then try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba el medicamento, la cantidad de la dosis y la unidad, y vuelve a intentarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe das Medikament, die Dosismenge und die Einheit und versuche es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le médicament, la quantité de la dose et l’unité, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
