    "Follow your prescription and care instructions.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue tu prescripción y las indicaciones de atención médica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befolge deine Verordnung und Behandlungshinweise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez votre ordonnance et vos consignes de soins."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتّبع وصفتك الطبية وتعليمات الرعاية الخاصة بك."
