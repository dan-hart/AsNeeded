    "Open AsNeeded on your nearby iPhone, then refresh.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre AsNeeded en tu iPhone cercano y luego actualiza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne AsNeeded auf deinem iPhone in der Nähe und aktualisiere anschließend."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez AsNeeded sur votre iPhone à proximité, puis actualisez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح AsNeeded على جهاز iPhone القريب منك، ثم حدّث."
