    "Choose a medication, or leave Automatic to use the overview or next saved window.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un medicamento o deja Automático para usar la vista general o la próxima franja horaria guardada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Medikament oder behalte „Automatisch“ bei, um die Übersicht oder das nächste gespeicherte Zeitfenster zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un médicament ou laissez « Automatique » pour utiliser la vue d’ensemble ou le prochain créneau enregistré."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر دواءً، أو اترك الخيار على «تلقائي» لاستخدام النظرة العامة أو الفترة المحفوظة التالية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור תרופה, או להשאיר את האפשרות ״אוטומטי״ כדי להשתמש בסקירה הכללית או בחלון הזמן הבא שנשמר."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک دارو انتخاب کنید یا گزینهٔ «خودکار» را نگه دارید تا از نمای کلی یا بازهٔ زمانی ذخیره‌شدهٔ بعدی استفاده شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "薬を選択するか、「自動」のままにすると概要または次の保存済みの時間帯が使用されます。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете лекарство или оставете „Автоматично“, за да използвате общия преглед или следващия запазен времеви интервал."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria un medicament o deixa l'opció «Automàtic» per utilitzar la visió general o la pròxima franja desada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte lék nebo ponechte volbu Automaticky pro použití přehledu či dalšího uloženého časového okna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg medicin, eller behold Automatisk for at bruge oversigten eller det næste gemte tidsrum."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε ένα φάρμακο ή αφήστε την επιλογή «Αυτόματα» για να χρησιμοποιήσετε την επισκόπηση ή το επόμενο αποθηκευμένο χρονικό διάστημα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a medication, or leave Automatic to use the overview or next saved window."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a medication, or leave Automatic to use the overview or next saved window."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a medication, or leave Automatic to use the overview or next saved window."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un medicamento o deja Automático para usar la vista general o el próximo intervalo guardado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse lääke tai jätä valinnaksi Automaattinen, jolloin käytetään yleiskatsausta tai seuraavaa tallennettua aikaväliä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un médicament ou laissez Automatique pour utiliser la vue d’ensemble ou la prochaine plage horaire enregistrée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दवा चुनें, या अवलोकन अथवा अगली सहेजी गई समयावधि का उपयोग करने के लिए स्वचालित विकल्प रहने दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi lijek ili ostavi Automatski za upotrebu pregleda ili sljedećeg spremljenog vremenskog okvira."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon gyógyszert, vagy hagyja az Automatikus beállítást az áttekintés vagy a következő mentett időablak használatához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih obat, atau biarkan Otomatis untuk menggunakan ringkasan atau rentang waktu tersimpan berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un farmaco oppure lascia Automatico per usare la panoramica o la prossima finestra temporale salvata."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дәріні таңдаңыз немесе шолуды не келесі сақталған уақыт аралығын пайдалану үшін «Автоматты» опциясын қалдырыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약을 선택하거나 '자동'으로 두어 개요 또는 다음에 저장된 시간대를 사용하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih ubat, atau kekalkan Automatik untuk menggunakan gambaran keseluruhan atau tempoh seterusnya yang disimpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et legemiddel, eller behold Automatisk for å bruke oversikten eller neste lagrede tidsvindu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een medicijn of laat Automatisch geselecteerd om het overzicht of het volgende opgeslagen tijdvenster te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz lek lub pozostaw opcję Automatycznie, aby użyć przeglądu lub następnego zapisanego przedziału czasowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um medicamento ou deixe em Automático para usar a visão geral ou a próxima janela de horário salva."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um medicamento ou mantenha Automático para utilizar a vista geral ou o próximo período guardado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege un medicament sau lasă opțiunea Automat pentru a folosi prezentarea generală sau următorul interval salvat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите лекарство или оставьте «Автоматически», чтобы использовать обзор или следующий сохранённый период приёма."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte liek alebo ponechajte možnosť Automaticky na použitie prehľadu alebo ďalšieho uloženého časového okna."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett läkemedel eller behåll Automatiskt för att använda översikten eller nästa sparade tidsfönster."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกยา หรือคงตัวเลือกอัตโนมัติไว้เพื่อใช้ภาพรวมหรือช่วงเวลาถัดไปที่บันทึกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ilaç seçin veya genel bakışı ya da bir sonraki kayıtlı zaman aralığını kullanmak için Otomatik seçeneğini koruyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть ліки або залиште «Автоматично», щоб використати огляд чи наступний збережений часовий проміжок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thuốc hoặc giữ tùy chọn Tự động để dùng phần tổng quan hoặc khung thời gian đã lưu tiếp theo."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇藥物，或保留「自動」以使用概覽或下一個已儲存的用藥時段。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择药物，或保留“自动”以使用概览或下一个已保存的时间窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇藥物，或保留「自動」以使用總覽或下一個已儲存的時段。"
          }
        }
      }
    },
    "Choose a medication, then try deleting the entry again.": {
