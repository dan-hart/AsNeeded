        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनर्स्थापित करने से पहले स्वचालित बैकअप चालू थे, लेकिन उन्हें फिर से सेट करना होगा क्योंकि बैकअप स्थान की सेटिंग्स हर डिवाइस के लिए अलग होती हैं।\n\nसुरक्षा फिर से शुरू करने के लिए कृपया स्वचालित बैकअप फिर से सेट करें।"
