    "Sorry, I couldn't log your medication. Please try again or open AsNeeded manually.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عذراً، لم أستطع تسجيل دوائك. حاول مرة أخرى أو افتح AsNeeded يدويًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho sento, no he pogut registrar la teva medicació. Torna-ho a provar o obre AsNeeded manualment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omlouvám se, nepodařilo se mi zaznamenat tvůj lék. Zkus to prosím znovu nebo otevři AsNeeded ručně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklager, jeg kunne ikke registrere din medicin. Prøv igen eller åbn AsNeeded manuelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entschuldigung, ich konnte dein Medikament nicht protokollieren. Bitte versuche es erneut oder öffne AsNeeded manuell."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λυπάμαι, δεν μπόρεσα να καταγράψω το φάρμακό σας. Προσπαθήστε ξανά ή ανοίξτε το AsNeeded χειροκίνητα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorry, I couldn't log your medication. Please try again or open AsNeeded manually."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorry, I couldn't log your medication. Please try again or open AsNeeded manually."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorry, I couldn't log your medicine. Please try again or open AsNeeded manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo siento, no pude registrar tu medicación. Por favor, inténtalo de nuevo o abre AsNeeded manualmente."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo siento, no pude registrar tu medicamento. Intenta de nuevo o abre AsNeeded manualmente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "متأسفم، نتوانستم داروی شما را ثبت کنم. لطفاً دوباره تلاش کنید یا به‌صورت دستی AsNeeded را باز کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitettavasti en voinut kirjata lääkettäsi. Yritä uudelleen tai avaa AsNeeded manuaalisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désolé, je n'ai pas pu enregistrer ton médicament. Réessaie ou ouvre AsNeeded manuellement."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Désolé, je n'ai pas pu consigner ton médicament. Essaie de nouveau ou ouvre AsNeeded manuellement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצטער/ת — לא הצלחתי לרשום את התרופה שלך. נסה/י שוב או פתח/י את AsNeeded באופן ידני."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्षमा करें, मैं आपकी दवा लॉग नहीं कर पाया। कृपया पुनः प्रयास करें या मैन्युअली AsNeeded खोलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sajnálom, nem sikerült rögzítenem a gyógyszert. Próbáld újra, vagy nyisd meg kézzel az AsNeeded alkalmazást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaf, saya tidak dapat mencatat obat Anda. Silakan coba lagi atau buka AsNeeded secara manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiacente, non sono riuscito a registrare il tuo farmaco. Riprova o apri AsNeeded manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "申し訳ありません。薬の記録をできませんでした。もう一度お試しになるか、手動で AsNeeded を開いてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кешіріңіз, дәріңізді тіркей алмадым. Қайта байқап көріңіз немесе AsNeeded қолданбасын қолмен ашыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "죄송합니다. 약물 기록을 저장하지 못했습니다. 다시 시도하거나 직접 AsNeeded를 열어 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaf, saya tidak dapat merekod ubat anda. Sila cuba lagi atau buka AsNeeded secara manual."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklager, jeg klarte ikke å registrere medisinen. Prøv igjen eller åpne AsNeeded manuelt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorry, ik kon je medicatie niet registreren. Probeer het opnieuw of open AsNeeded handmatig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przepraszam, nie mogłem zapisać Twojego leku. Spróbuj ponownie lub otwórz AsNeeded ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desculpe, não consegui registrar seu medicamento. Tente novamente ou abra o AsNeeded manualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desculpe, não consegui registar a sua medicação. Tente novamente ou abra AsNeeded manualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pare rău, nu am putut înregistra medicația. Te rog încearcă din nou sau deschide AsNeeded manual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Извини, не удалось зафиксировать приём. Попробуй ещё раз или открой AsNeeded вручную."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyvärr kunde jag inte logga din medicin. Försök igen eller öppna AsNeeded manuellt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอโทษด้วย ฉันไม่สามารถบันทึกยาของคุณได้ โปรดลองอีกครั้งหรือเปิด AsNeeded ด้วยตนเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üzgünüm, ilacınızı kaydedemedim. Lütfen tekrar deneyin veya AsNeeded'i elle açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xin lỗi, tôi không thể ghi lại thuốc của bạn. Vui lòng thử lại hoặc mở AsNeeded thủ công."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "抱歉，未能記錄你的藥物。請再試一次或手動開啟 AsNeeded。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抱歉，无法记录你的用药。请重试或手动打开 AsNeeded。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "抱歉，我無法記錄你的藥物。請再試一次或手動開啟 AsNeeded。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За съжаление, не успях да запиша приема на лекарството ви. Опитайте отново или отворете AsNeeded ръчно."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Žao mi je, bilježenje vašeg lijeka nije uspjelo. Pokušajte ponovno ili ručno otvorite AsNeeded."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ľutujem, nepodarilo sa mi zaznamenať váš liek. Skúste to znova alebo otvorte AsNeeded manuálne."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На жаль, не вдалося записати прийом ліків. Спробуйте знову або відкрийте AsNeeded вручну."
          }
        }
      }
    },
