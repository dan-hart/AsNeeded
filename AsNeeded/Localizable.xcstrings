    "Optional support. Every feature stays free, with no ads.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoyo opcional. Todas las funciones siguen siendo gratuitas y sin anuncios."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freiwillige Unterstützung. Alle Funktionen bleiben kostenlos und werbefrei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soutien facultatif. Toutes les fonctionnalités restent gratuites, sans publicité."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دعم اختياري. تظل جميع الميزات مجانية، دون إعلانات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמיכה היא לבחירתך. כל התכונות נשארות בחינם, ללא פרסומות."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حمایت اختیاری است. همهٔ قابلیت‌ها رایگان و بدون تبلیغ باقی می‌مانند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支援は任意です。すべての機能を無料で利用でき、広告もありません。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Подкрепа по желание. Всички функции остават безплатни, без реклами."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Suport opcional. Totes les funcions continuen sent gratuïtes i sense anuncis."
