    "Waiting to sync with iPhone. Don’t log this dose again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando la sincronización con el iPhone. No vuelvas a registrar esta dosis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf Synchronisierung mit dem iPhone. Erfasse diese Dosis nicht erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de synchronisation avec l’iPhone. N’enregistrez pas cette prise à nouveau."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بانتظار المزامنة مع iPhone. لا تسجّل هذه الجرعة مرة أخرى."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בהמתנה לסנכרון עם iPhone. אין לתעד את המנה הזו שוב."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در انتظار همگام‌سازی با iPhone. این دوز را دوباره ثبت نکنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneとの同期を待っています。この服用分を重ねて記録しないでください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изчакване на синхронизация с iPhone. Не записвайте тази доза отново."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendent de sincronització amb l’iPhone. No tornis a registrar aquesta dosi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čeká na synchronizaci s iPhonem. Tuto dávku znovu nezaznamenávejte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på synkronisering med iPhone. Registrer ikke denne dosis igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναμονή συγχρονισμού με το iPhone. Μην καταγράψετε ξανά αυτή τη δόση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting to sync with iPhone. Don’t log this dose again."
          }
        },
