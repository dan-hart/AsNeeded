          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, especifica qué medicamento te gustaría conocer."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لطفاً مشخص کنید دربارهٔ کدام دارو اطلاعات می‌خواهید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määritä, mistä lääkkeestä haluat tietoja."
          }
        },
        "fr": {
