    "Some changes may already be saved. Review this medication before trying again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que algunos cambios ya se hayan guardado. Revisa este medicamento antes de volver a intentarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Änderungen wurden möglicherweise bereits gespeichert. Prüfe dieses Medikament, bevor du es erneut versuchst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines modifications ont peut-être déjà été enregistrées. Vérifiez ce médicament avant de réessayer."
