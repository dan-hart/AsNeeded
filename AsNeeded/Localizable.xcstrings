            "value": "削除する前に確認します"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изисква потвърждение преди изтриване"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Demana confirmació abans d'eliminar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před smazáním požádá o potvrzení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beder om bekræftelse før sletning"
          }
        },
        "el": {
