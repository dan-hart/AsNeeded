        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto akci nelze vrátit zpět. Veškerá historie a připomenutí pro tento lék budou smazána."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne handling kan ikke fortrydes. Al historik og alle påmindelser for dette lægemiddel vil blive slettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
