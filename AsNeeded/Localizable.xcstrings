    "The waiting time based on your saved dose guidance for %@ has passed. Review your instructions before taking a dose.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha transcurrido el tiempo de espera según las indicaciones de dosificación que has guardado para %@. Revisa tus instrucciones antes de tomar una dosis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wartezeit gemäß deinen gespeicherten Dosierungshinweisen für %@ ist abgelaufen. Prüfe deine Anweisungen, bevor du eine Dosis einnimmst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le délai d’attente basé sur vos consignes de prise enregistrées pour %@ est écoulé. Consultez vos instructions avant de prendre une dose."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقضت مدة الانتظار المستندة إلى إرشادات الجرعات المحفوظة لديك لدواء %@. راجع تعليماتك قبل تناول جرعة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זמן ההמתנה לפי הנחיות המינון השמורות שלך עבור %@ חלף. יש לעיין בהוראות שלך לפני נטילת מנה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمان انتظار بر اساس راهنمای دوز ذخیره‌شدهٔ شما برای %@ سپری شده است. پیش از مصرف یک دوز، دستورالعمل‌های خود را مرور کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の保存済みの服薬目安に基づく待ち時間が経過しました。服用前に指示を確認してください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Времето за изчакване според запазените от вас указания за дозиране на %@ изтече. Прегледайте указанията си, преди да приемете доза."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja ha transcorregut el temps d'espera basat en les orientacions de dosificació desades per a %@. Revisa les instruccions abans de prendre una dosi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čekací doba podle uložených pokynů k dávkování léku %@ uplynula. Před užitím dávky si zkontrolujte pokyny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventetiden baseret på dine gemte doseringsanvisninger for %@ er gået. Gennemgå dine anvisninger, før du tager en dosis."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχει παρέλθει ο χρόνος αναμονής βάσει των αποθηκευμένων οδηγιών δοσολογίας σας για το φάρμακο %@. Ελέγξτε τις οδηγίες σας πριν πάρετε μια δόση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The waiting time based on your saved dose guidance for %@ has passed. Review your instructions before taking a dose."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The waiting time based on your saved dose guidance for %@ has passed. Review your instructions before taking a dose."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The waiting time based on your saved dose guidance for %@ has passed. Review your instructions before taking a dose."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya transcurrió el tiempo de espera según las indicaciones de dosificación que guardaste para %@. Revisa tus instrucciones antes de tomar una dosis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lääkkeelle %@ tallentamaasi annostusohjeeseen perustuva odotusaika on kulunut. Tarkista ohjeesi ennen annoksen ottamista."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le délai d’attente établi selon vos consignes de prise enregistrées pour %@ est écoulé. Relisez vos consignes avant de prendre une dose."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के लिए आपके सहेजे गए खुराक संबंधी मार्गदर्शन के आधार पर प्रतीक्षा का समय बीत चुका है। खुराक लेने से पहले अपने निर्देशों की समीक्षा करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prošlo je vrijeme čekanja na temelju vaših spremljenih uputa za doziranje lijeka %@. Pregledajte svoje upute prije uzimanja doze."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ gyógyszerhez mentett adagolási útmutatás szerinti várakozási idő letelt. Adag bevétele előtt ellenőrizd az utasításaidat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu tunggu berdasarkan panduan dosis yang Anda simpan untuk %@ telah berlalu. Tinjau petunjuk Anda sebelum menggunakan satu dosis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo di attesa basato sulle indicazioni di dosaggio salvate per %@ è trascorso. Controlla le tue indicazioni prima di assumere una dose."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ үшін сақталған дозалау нұсқауларына негізделген күту уақыты өтті. Дозаны қабылдамас бұрын нұсқауларыңызды қарап шығыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 대해 저장된 복용 지침에 따른 대기 시간이 지났습니다. 복용하기 전에 지침을 검토하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempoh menunggu berdasarkan panduan dos yang anda simpan untuk %@ telah berlalu. Semak arahan anda sebelum mengambil dos."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventetiden basert på den lagrede doseringsveiledningen din for %@ er over. Se gjennom instruksjonene dine før du tar en dose."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wachttijd op basis van je opgeslagen doseringsinstructies voor %@ is verstreken. Controleer je instructies voordat je een dosis neemt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minął czas oczekiwania wynikający z zapisanych wskazówek dotyczących dawkowania leku %@. Sprawdź swoje zalecenia przed przyjęciem dawki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo de espera com base nas orientações de dose salvas para %@ já passou. Revise suas instruções antes de tomar uma dose."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo de espera com base nas orientações de dose guardadas para %@ já decorreu. Reveja as suas instruções antes de tomar uma dose."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Timpul de așteptare bazat pe indicațiile salvate privind dozele pentru %@ a trecut. Verifică instrucțiunile înainte de a lua o doză."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время ожидания согласно сохранённым указаниям по приёму %@ истекло. Проверьте свои указания перед приёмом дозы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čakacia doba podľa vašich uložených pokynov na dávkovanie lieku %@ uplynula. Pred užitím dávky si skontrolujte pokyny."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väntetiden enligt dina sparade doseringsanvisningar för %@ har gått ut. Granska dina anvisningar innan du tar en dos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พ้นระยะเวลารอตามแนวทางการใช้ยา %@ ที่คุณบันทึกไว้แล้ว ตรวจสอบคำแนะนำของคุณก่อนใช้ยา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için kaydettiğiniz doz yönergelerine göre bekleme süresi doldu. Doz almadan önce talimatlarınızı gözden geçirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час очікування відповідно до ваших збережених вказівок щодо дозування препарату %@ минув. Перегляньте свої вказівки, перш ніж приймати дозу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian chờ dựa trên hướng dẫn liều đã lưu cho %@ đã kết thúc. Hãy xem lại hướng dẫn của bạn trước khi dùng một liều."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "根據你為 %@ 儲存的用藥指引，等待時間已過。服藥前請查看你的用藥指示。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据您为 %@ 保存的用药指导，等待时间已结束。用药前请查看您的用药说明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依據您為 %@ 儲存的用藥指引，等待時間已過。用藥前請再次查看您的用藥說明。"
          }
        }
      }
    },
    "The waiting time based on your saved dose guidance has passed. Review your medication instructions before taking a dose.": {
