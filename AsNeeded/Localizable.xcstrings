        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lựa chọn của bạn vẫn còn ở đây. Vui lòng thử lưu lại."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你的選擇仍然保留。請再次嘗試儲存。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的选择仍然保留。请再次尝试保存。"
