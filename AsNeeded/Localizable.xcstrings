    "Reminders for times you choose. Next-dose alerts are separate, in Edit Medication.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorios para las horas que elijas. Las alertas de próxima dosis se gestionan por separado, en Editar medicamento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen zu den von dir gewählten Zeiten. Hinweise zur nächsten Dosis werden separat unter „Medikament bearbeiten“ verwaltet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des rappels aux heures de votre choix. Les alertes de prochaine prise sont distinctes, dans Modifier le médicament."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكيرات في الأوقات التي تختارها. تنبيهات الجرعة التالية منفصلة، ضمن «تعديل الدواء»."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תזכורות לשעות שנבחרו. התראות על המנה הבאה מנוהלות בנפרד, בעריכת התרופה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یادآورها برای زمان‌هایی هستند که انتخاب می‌کنید. هشدارهای دوز بعدی جداگانه و در بخش ویرایش دارو قرار دارند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した時刻に通知するリマインダーです。次の投与の通知は別の機能で、「薬を編集」で設定します。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Напомняния за избраните от вас часове. Известията за следваща доза са отделни и се намират в „Редактиране на лекарство“."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatoris per a les hores que triïs. Els avisos de la pròxima dosi es configuren per separat, a Edita el medicament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připomínky v časech, které si zvolíte. Upozornění na další dávku se nastavují samostatně v části Upravit lék."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Påmindelser på tidspunkter, du vælger. Beskeder om næste dosis indstilles separat under Rediger medicin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπενθυμίσεις για τις ώρες που επιλέγετε. Οι ειδοποιήσεις επόμενης δόσης ρυθμίζονται ξεχωριστά, στην Επεξεργασία φαρμάκου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders for times you choose. Next-dose alerts are separate, in Edit Medication."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders for times you choose. Next-dose alerts are separate, in Edit Medication."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders for times you choose. Next-dose alerts are separate, in Edit Medication."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorios para los horarios que elijas. Las alertas de la próxima dosis se configuran por separado, en Editar medicamento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistutukset valitseminasi aikoina. Seuraavan annoksen ilmoitukset ovat erikseen Muokkaa lääkettä -näkymässä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Des rappels aux heures de votre choix. Les alertes de prochaine dose sont distinctes et se trouvent dans Modifier le médicament."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके चुने हुए समय के लिए रिमाइंडर। अगली खुराक के अलर्ट अलग हैं और दवा में बदलाव करने की स्क्रीन में मिलते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsjetnici za vremena koja odaberete. Upozorenja za sljedeću dozu postavljaju se zasebno u odjeljku Uredi lijek."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Emlékeztetők az Ön által választott időpontokban. A következő adagra vonatkozó jelzések külön, a Gyógyszer szerkesztése részen állíthatók be."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat pada waktu yang Anda pilih. Peringatan dosis berikutnya diatur terpisah, di Edit Obat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria agli orari che scegli. Gli avvisi per la prossima dose sono separati, in Modifica farmaco."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өзіңіз таңдаған уақыттардағы еске салғыштар. Келесі доза туралы ескертулер «Дәріні өңдеу» бөлімінде бөлек бапталады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 시간에 알림을 받습니다. 다음 복용 알림은 '약 편집'에서 별도로 설정합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan pada masa yang anda pilih. Amaran dos seterusnya adalah berasingan, dalam Sunting Ubat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminnelser på tidspunkter du velger. Varsler om neste dose administreres separat under Rediger legemiddel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen op tijdstippen die je kiest. Meldingen voor de volgende dosis stel je afzonderlijk in bij Medicijn bewerken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia o wybranych godzinach. Alerty o kolejnej dawce są dostępne osobno w sekcji Edytuj lek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes nos horários que você escolher. Os alertas da próxima dose ficam separados, em Editar medicamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes para os horários que escolher. Os alertas da próxima dose são separados e encontram-se em Editar medicamento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mementouri la orele alese de tine. Alertele pentru următoarea doză sunt separate, în Editare medicament."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания в выбранное вами время. Уведомления о следующем приёме настраиваются отдельно в разделе «Изменить лекарство»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripomienky v časoch, ktoré si vyberiete. Upozornenia na ďalšiu dávku sa nastavujú samostatne v časti Upraviť liek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminnelser vid tider du väljer. Aviseringar om nästa dos finns separat under Redigera läkemedel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเตือนตามเวลาที่คุณเลือก ส่วนการแจ้งเตือนการใช้ยาครั้งถัดไปตั้งค่าแยกต่างหากในหน้าแก้ไขยา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğiniz saatler için hatırlatıcılar. Sonraki doz uyarıları, İlaç düzenle bölümünde ayrı olarak yönetilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування у вибраний вами час. Сповіщення про наступну дозу налаштовуються окремо в розділі «Редагувати ліки»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời nhắc vào những thời điểm bạn chọn. Cảnh báo liều tiếp theo được cài đặt riêng trong Chỉnh sửa thuốc."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在你選擇的時間發出提醒。下次用藥提示另於「編輯藥物」中設定。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您选择的时间提醒。下次用药提醒单独在“编辑药物”中设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您選擇的時間提醒。下次用藥通知另於「編輯藥物」中設定。"
          }
        }
      }
    },
