    "Are you sure you want to clear all reminders for this medication?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد أنك تريد مسح جميع التذكيرات لهذا الدواء؟"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estàs segur que vols esborrar tots els recordatoris d'aquest medicament?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravdu chceš vymazat všechna připomenutí pro tento lék?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil fjerne alle påmindelser for denne medicin?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du wirklich alle Erinnerungen für dieses Medikament löschen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είστε βέβαιοι ότι θέλετε να διαγράψετε όλες τις υπενθυμίσεις για αυτό το φάρμακο;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to clear all reminders for this medication?"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to clear all reminders for this medication?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to clear all reminders for this medicine?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que quieres eliminar todos los recordatorios de este medicamento?"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres borrar todos los recordatorios de este medicamento?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آیا مطمئن هستید که می‌خواهید همه‌ی یادآورها برای این دارو را پاک کنید؟"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko varmasti poistaa kaikki tämän lääkkeen muistutukset?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Es-tu sûr de vouloir supprimer tous les rappels pour ce médicament ?"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Es-tu sûr de vouloir supprimer tous les rappels pour ce médicament ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם לאשר הסרה של כל התזכורות עבור תרופה זו?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई इस दवा के सभी रिमाइंडर साफ़ करना चाहते हैं?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztosan törölni szeretnéd az összes emlékeztetőt ennél a gyógyszeres bejegyzésnél?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda yakin ingin menghapus semua pengingat untuk obat ini?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro di voler cancellare tutti i promemoria per questo farmaco?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この薬のすべてのリマインダーをクリアしてもよろしいですか？"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы дәріге арналған барлық ескертулерді жоюға шынымен сенімдісіз бе?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 약에 대한 모든 알림을 지우시겠습니까?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah anda pasti mahu mengosongkan semua peringatan untuk ubat ini?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil fjerne alle påminnelser for dette legemidlet?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je alle herinneringen voor dit medicijn wilt verwijderen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usunąć wszystkie przypomnienia dotyczące tego leku?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja limpar todos os lembretes deste medicamento?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem a certeza de que pretende apagar todos os lembretes desta medicação?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigur dorești să ștergi toate mementourile pentru acest medicament?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты уверен(а), что хочешь удалить все напоминания для этого лекарства?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill rensa alla påminnelser för detta läkemedel?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือว่าต้องการล้างการเตือนทั้งหมดของยานี้?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ilacın tüm hatırlatmalarını temizlemek istediğinizden emin misiniz?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc muốn xóa tất cả lời nhắc cho loại thuốc này không?"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你確定要清除此藥物的所有提醒嗎？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要清除该药物的所有提醒吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您確定要清除這個藥物的所有提醒嗎？"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Наистина ли искате да изчистите всички напомняния за това лекарство?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Želiš li doista izbrisati sve podsjetnike za ovaj lijek?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naozaj chcete vymazať všetky pripomienky pre tento liek?"
