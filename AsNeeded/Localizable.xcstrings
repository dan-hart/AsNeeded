    "Renews automatically each month. Cancel anytime in your App Store subscription settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva automáticamente cada mes. Puedes cancelar en cualquier momento en los ajustes de suscripciones del App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich automatisch jeden Monat. Jederzeit in deinen App Store-Abonnementeinstellungen kündbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renouvelle automatiquement chaque mois. Résiliez à tout moment dans les réglages de vos abonnements App Store."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجدد تلقائيًا كل شهر. يمكنك الإلغاء في أي وقت من إعدادات اشتراكات App Store."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתחדש אוטומטית מדי חודש. ניתן לבטל בכל עת בהגדרות המינויים ב-App Store."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر ماه به‌طور خودکار تمدید می‌شود. هر زمان می‌توانید از تنظیمات اشتراک App Store خود لغو کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月自動更新されます。App Storeのサブスクリプション設定でいつでも解約できます。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Подновява се автоматично всеки месец. Можете да отмените по всяко време в настройките за абонаменти в App Store."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es renova automàticament cada mes. Pots cancel·lar la subscripció en qualsevol moment a la configuració de subscripcions de l'App Store."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky se obnovuje každý měsíc. Zrušit můžete kdykoli v nastavení předplatného v App Storu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes automatisk hver måned. Opsig når som helst i dine abonnementsindstillinger i App Store."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανανεώνεται αυτόματα κάθε μήνα. Ακυρώστε οποιαδήποτε στιγμή από τις ρυθμίσεις συνδρομών σας στο App Store."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renews automatically each month. Cancel anytime in your App Store subscription settings."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Renews automatically each month. Cancel anytime in your App Store subscription settings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Renews automatically each month. Cancel anytime in your App Store subscription settings."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva automáticamente cada mes. Cancela cuando quieras en la configuración de suscripciones de App Store."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusiutuu automaattisesti kuukausittain. Voit perua milloin tahansa App Storen tilausasetuksissa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renouvelle automatiquement chaque mois. Annulez en tout temps dans les paramètres de vos abonnements à l’App Store."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर महीने अपने आप नवीनीकृत होती है। अपनी App Store सदस्यता सेटिंग्स में कभी भी रद्द करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatski se obnavlja svaki mjesec. Otkažite bilo kada u postavkama pretplata u trgovini App Store."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Havonta automatikusan megújul. Bármikor lemondható az App Store előfizetési beállításaiban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperpanjang secara otomatis setiap bulan. Batalkan kapan saja di pengaturan langganan App Store Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova automaticamente ogni mese. Puoi annullare in qualsiasi momento nelle impostazioni degli abbonamenti dell'App Store."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай сайын автоматты түрде жаңартылады. App Store жазылым баптауларында кез келген уақытта бас тартуға болады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매월 자동 갱신됩니다. App Store 구독 설정에서 언제든지 취소할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperbaharui secara automatik setiap bulan. Batalkan pada bila-bila masa dalam tetapan langganan App Store anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes automatisk hver måned. Avslutt når som helst i abonnementsinnstillingene i App Store."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt elke maand automatisch verlengd. Je kunt op elk moment opzeggen in je abonnementsinstellingen van de App Store."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odnawia się automatycznie co miesiąc. Możesz anulować w dowolnym momencie w ustawieniach subskrypcji App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renovação automática a cada mês. Cancele quando quiser nas configurações de assinaturas da App Store."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Renova-se automaticamente todos os meses. Cancele a qualquer momento nas definições de assinaturas da App Store."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reînnoiește automat în fiecare lună. Anulează oricând din setările abonamentelor din App Store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продлевается автоматически каждый месяц. Отменить можно в любое время в настройках подписок App Store."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovuje sa automaticky každý mesiac. Kedykoľvek môžete zrušiť v nastaveniach predplatného v App Store."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förnyas automatiskt varje månad. Avsluta när som helst i dina abonnemangsinställningar i App Store."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต่ออายุโดยอัตโนมัติทุกเดือน ยกเลิกได้ทุกเมื่อในการตั้งค่าการสมัครสมาชิกของ App Store"
