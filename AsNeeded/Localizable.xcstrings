    "Failed to archive legacy databases: %@. Migration will retry on next launch.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron archivar las bases de datos antiguas: %@. Se volverá a intentar la migración la próxima vez que se abra la app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivierung der alten Datenbanken fehlgeschlagen: %@. Die Migration wird beim nächsten Start erneut versucht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’archivage des anciennes bases de données : %@. La migration sera relancée au prochain démarrage."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشلت أرشفة قواعد البيانات القديمة: %@. ستُعاد محاولة الترحيل عند التشغيل التالي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העברת מסדי הנתונים הישנים לארכיון נכשלה: %@. העברת הנתונים תתבצע שוב בהפעלה הבאה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بایگانی پایگاه‌های دادهٔ قدیمی ناموفق بود: %@. انتقال داده‌ها در اجرای بعدی دوباره انجام می‌شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旧データベースのアーカイブに失敗しました：%@。次回起動時に移行を再試行します。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Неуспешно архивиране на старите бази данни: %@. Миграцията ще бъде опитана отново при следващото стартиране."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’han pogut arxivar les bases de dades antigues: %@. La migració es tornarà a intentar la pròxima vegada que s’obri l’app."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivace starších databází se nezdařila: %@. Migrace se zopakuje při příštím spuštění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke arkivere ældre databaser: %@. Migreringen forsøges igen ved næste opstart."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποτυχία αρχειοθέτησης παλαιών βάσεων δεδομένων: %@. Η μετεγκατάσταση θα επιχειρηθεί ξανά στην επόμενη εκκίνηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to archive legacy databases: %@. Migration will retry on next launch."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to archive legacy databases: %@. Migration will retry on next launch."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to archive legacy databases: %@. Migration will retry on next launch."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron archivar las bases de datos anteriores: %@. Se volverá a intentar la migración la próxima vez que se abra la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanhojen tietokantojen arkistointi epäonnistui: %@. Tietojen siirtoa yritetään uudelleen seuraavalla käynnistyksellä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’archivage des anciennes bases de données : %@. Une nouvelle tentative de migration aura lieu au prochain lancement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुराने डेटाबेस संग्रहित नहीं किए जा सके: %@। अगली बार ऐप खुलने पर माइग्रेशन का फिर प्रयास होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arhiviranje starih baza podataka nije uspjelo: %@. Migracija će se ponovno pokušati pri sljedećem pokretanju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A régi adatbázisok archiválása sikertelen: %@. Az áttelepítés a következő indításkor újra megkísérli."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal mengarsipkan basis data lama: %@. Migrasi akan dicoba lagi saat aplikasi dibuka berikutnya."
          }
        },
        "it": {
          "stringUnit": {
