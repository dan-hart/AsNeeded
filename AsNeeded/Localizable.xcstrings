    "iPhone connection is starting. Try again shortly.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está iniciando la conexión con el iPhone. Vuelve a intentarlo en unos instantes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zum iPhone wird aufgebaut. Versuche es in Kürze erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à l’iPhone est en cours. Réessayez dans un instant."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ بدء الاتصال بـ iPhone. حاول مرة أخرى بعد قليل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיבור ל־iPhone מתחיל. יש לנסות שוב בעוד זמן קצר."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال به iPhone در حال برقراری است. کمی بعد دوباره تلاش کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneへの接続を開始しています。しばらくしてからもう一度お試しください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Връзката с iPhone се установява. Опитайте отново след малко."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’està iniciant la connexió amb l’iPhone. Torna-ho a provar d’aquí a una estona."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navazuje se připojení k iPhonu. Zkuste to za chvíli znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbindelsen til iPhone oprettes. Prøv igen om lidt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεση με το iPhone ξεκινά. Δοκιμάστε ξανά σε λίγο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone connection is starting. Try again shortly."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone connection is starting. Try again shortly."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone connection is starting. Try again shortly."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está iniciando la conexión con el iPhone. Inténtalo de nuevo en unos momentos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteyttä iPhoneen muodostetaan. Yritä hetken kuluttua uudelleen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à l’iPhone est en cours. Réessayez sous peu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone से कनेक्शन शुरू हो रहा है। थोड़ी देर में दोबारा कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uspostavlja se veza s iPhoneom. Pokušajte ponovno uskoro."
