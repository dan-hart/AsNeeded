    "Tap here to choose a color and icon for this medication. Customizing is optional.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca aquí para elegir un color y un icono para este medicamento. La personalización es opcional."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe hier, um eine Farbe und ein Symbol für dieses Medikament auszuwählen. Die Anpassung ist optional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ici pour choisir une couleur et une icône pour ce médicament. La personnalisation est facultative."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط هنا لاختيار لون وأيقونة لهذا الدواء. التخصيص اختياري."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להקיש כאן כדי לבחור צבע וסמל לתרופה הזו. ההתאמה האישית היא אופציונלית."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای انتخاب رنگ و آیکون این دارو، اینجا بزنید. شخصی‌سازی اختیاری است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここをタップして、この薬の色とアイコンを選択します。カスタマイズは任意です。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете тук, за да изберете цвят и икона за това лекарство. Персонализирането е по желание."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca aquí per triar un color i una icona per a aquest medicament. La personalització és opcional."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím sem vyberete barvu a ikonu tohoto léku. Přizpůsobení je volitelné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk her for at vælge en farve og et ikon til denne medicin. Tilpasning er valgfrit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε εδώ για να επιλέξετε χρώμα και εικονίδιο για αυτό το φάρμακο. Η προσαρμογή είναι προαιρετική."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap here to choose a color and icon for this medication. Customizing is optional."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap here to choose a colour and icon for this medication. Customising is optional."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap here to choose a colour and icon for this medication. Customising is optional."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca aquí para elegir un color y un ícono para este medicamento. La personalización es opcional."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse tälle lääkkeelle väri ja kuvake napauttamalla tästä. Mukauttaminen on valinnaista."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ici pour choisir une couleur et une icône pour ce médicament. La personnalisation est facultative."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस दवा के लिए रंग और आइकन चुनने के लिए यहाँ टैप करें। अपनी पसंद के अनुसार बदलाव करना वैकल्पिक है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite ovdje za odabir boje i ikone za ovaj lijek. Prilagodba nije obavezna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints ide a gyógyszer színének és ikonjának kiválasztásához. A testreszabás nem kötelező."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk di sini untuk memilih warna dan ikon obat ini. Penyesuaian bersifat opsional."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca qui per scegliere un colore e un’icona per questo farmaco. La personalizzazione è facoltativa."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы дәрінің түсі мен белгішесін таңдау үшін осында түртіңіз. Бұл міндетті емес."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기를 탭하여 이 약의 색상과 아이콘을 선택하세요. 맞춤 설정은 선택 사항입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik di sini untuk memilih warna dan ikon bagi ubat ini. Penyesuaian adalah pilihan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk her for å velge farge og ikon for dette legemiddelet. Tilpasning er valgfritt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik hier om een kleur en symbool voor deze medicatie te kiezen. Aanpassen is optioneel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij tutaj, aby wybrać kolor i ikonę tego leku. Dostosowanie jest opcjonalne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque aqui para escolher uma cor e um ícone para este medicamento. A personalização é opcional."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque aqui para escolher uma cor e um ícone para este medicamento. A personalização é opcional."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge aici pentru a alege o culoare și o pictogramă pentru acest medicament. Personalizarea este opțională."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите здесь, чтобы выбрать цвет и значок для этого лекарства. Это необязательно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím sem vyberte farbu a ikonu tohto lieku. Prispôsobenie je voliteľné."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck här för att välja en färg och ikon för det här läkemedlet. Anpassning är valfri."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะที่นี่เพื่อเลือกสีและไอคอนสำหรับยานี้ จะปรับแต่งหรือไม่ก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ilaç için renk ve simge seçmek üzere buraya dokunun. Özelleştirme isteğe bağlıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться тут, щоб вибрати колір і значок для цих ліків. Налаштування вигляду необов’язкове."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào đây để chọn màu và biểu tượng cho thuốc này. Việc tùy chỉnh là không bắt buộc."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下這裏，為此藥物選擇顏色及圖示。你可自行決定是否自訂。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点此处，为此药物选择颜色和图标。自定义为可选操作。"
          }
