    "Use Log Dose to choose a medication and record a dose you have taken.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Registrar dosis para elegir un medicamento y registrar una dosis que hayas tomado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende „Dosis erfassen“, um ein Medikament auszuwählen und eine bereits eingenommene Dosis zu erfassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Enregistrer une prise pour choisir un médicament et enregistrer une dose que vous avez prise."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم «تسجيل جرعة» لاختيار دواء وتسجيل جرعة تناولتها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להשתמש ב״תיעוד מנה״ כדי לבחור תרופה ולתעד מנה שכבר נטלת."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با «ثبت دوز»، دارویی انتخاب کنید و دوزی را که مصرف کرده‌اید ثبت کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「服薬を記録」で薬を選び、服用した分を記録してください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Използвайте „Записване на доза“, за да изберете лекарство и да запишете приета доза."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes servir Registra una dosi per triar un medicament i registrar una dosi que has pres."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomocí akce Zaznamenat dávku vyberte lék a zaznamenejte dávku, kterou jste užili."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug Registrer dosis til at vælge et lægemiddel og registrere en dosis, du har taget."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε την Καταγραφή δόσης για να επιλέξετε φάρμακο και να καταγράψετε μια δόση που έχετε πάρει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Log Dose to choose a medication and record a dose you have taken."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Log Dose to choose a medication and record a dose you have taken."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Log Dose to choose a medication and record a dose you have taken."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Registrar dosis para elegir un medicamento y registrar una dosis que hayas tomado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse lääke ja kirjaa ottamasi annos toiminnolla Kirjaa annos."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Enregistrer une dose pour choisir un médicament et enregistrer une dose que vous avez prise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दवा चुनने और ली गई खुराक दर्ज करने के लिए खुराक दर्ज करें का उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upotrijebite opciju Evidentiraj dozu da biste odabrali lijek i evidentirali dozu koju ste uzeli."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Adag rögzítése funkcióval kiválaszthatsz egy gyógyszert, és rögzítheted a bevett adagot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan Catat Dosis untuk memilih obat dan mencatat dosis yang sudah Anda gunakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Registra dose per scegliere un farmaco e registrare una dose che hai assunto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дәріні таңдап, қабылдаған дозаңызды тіркеу үшін «Дозаны тіркеу» пәрменін пайдаланыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복용 기록을 사용해 약을 선택하고 복용한 양을 기록하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan Rekod Dos untuk memilih ubat dan merekodkan dos yang telah anda ambil."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk Registrer dose for å velge et legemiddel og registrere en dose du har tatt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik Dosis registreren om medicatie te kiezen en een ingenomen dosis vast te leggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj opcji Zapisz dawkę, aby wybrać lek i zapisać przyjętą dawkę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Registrar dose para escolher um medicamento e registrar uma dose que você tomou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Registar dose para escolher um medicamento e registar uma dose que tomou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește Înregistrează doza pentru a alege un medicament și a înregistra o doză pe care ai luat-o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте действие «Записать приём», чтобы выбрать лекарство и записать принятую дозу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomocou možnosti Zaznamenať dávku vyberte liek a zaznamenajte dávku, ktorú ste užili."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd Registrera dos för att välja ett läkemedel och registrera en dos du har tagit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้บันทึกการใช้ยาเพื่อเลือกยาและบันทึกยาที่คุณใช้ไปแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ilaç seçmek ve aldığınız bir dozu kaydetmek için Doz Kaydet'i kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скористайтеся дією «Записати прийом дози», щоб вибрати препарат і записати дозу, яку ви прийняли."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng Ghi liều để chọn thuốc và ghi lại một liều bạn đã dùng."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "使用「記錄用藥」選擇藥物並記錄已服用的劑量。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用“记录用药”选择药物，并记录您已用药的一次剂量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用「記錄用藥」選擇藥物，並記錄您已使用的劑量。"
          }
        }
      }
    },
