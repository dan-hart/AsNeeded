          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the medication, dose amount, and unit, then try again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the medication, dose amount, and unit, then try again."
          }
        },
        "es-419": {
