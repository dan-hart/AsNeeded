          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε για προσαρμογή της δόσης, πατήστε παρατεταμένα για καταγραφή της προεπιλεγμένης δόσης"
          }
        },
        "en-AU": {
          "stringUnit": {
