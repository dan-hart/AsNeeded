        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر بسته تحت مجوز متن‌باز مربوط به خود ارائه می‌شود. برای مشاهدهٔ متن کامل مجوز در مخزن کد منبع، روی هر بسته کلیک کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokaisella paketilla on oma avoimen lähdekoodin lisenssinsä. Avaa paketin koko lisenssiteksti lähdekoodivarastossa napsauttamalla pakettia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque paquet est distribué sous sa propre licence open source. Cliquez sur un paquet pour consulter le texte intégral de sa licence dans le dépôt source."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque paquet est distribué sous sa propre licence de code source libre. Cliquez sur un paquet pour consulter le texte intégral de sa licence dans le dépôt source."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל חבילה מופצת בכפוף לרישיון הקוד הפתוח שלה. לחיצה על חבילה תציג את נוסח הרישיון המלא במאגר קוד המקור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर पैकेज अपने संबंधित ओपन सोर्स लाइसेंस के अंतर्गत लाइसेंस प्राप्त है। स्रोत रिपॉज़िटरी में किसी पैकेज का पूरा लाइसेंस पाठ देखने के लिए उस पर क्लिक करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden csomagra a saját nyílt forráskódú licence vonatkozik. Kattintson egy csomagra a teljes licencszöveg megtekintéséhez a forráskód-tárolóban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap paket dilisensikan berdasarkan lisensi sumber terbukanya masing-masing. Klik paket mana pun untuk melihat teks lisensi lengkapnya di repositori sumber."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni pacchetto è distribuito secondo la rispettiva licenza a codice aperto. Fai clic su un pacchetto per visualizzare il testo completo della licenza nel repository del codice sorgente."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр пакет өзінің ашық бастапқы код лицензиясы бойынша таратылады. Лицензияның толық мәтінін бастапқы код репозиторийінде көру үшін кез келген пакетті басыңыз."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap pakej dilesenkan di bawah lesen sumber terbuka masing-masing. Klik pada mana-mana pakej untuk melihat teks lesen penuhnya dalam repositori sumber."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver pakke er lisensiert under sin respektive åpen kildekode-lisens. Klikk på en pakke for å se dens fulle licenstekst i kildelageret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk pakket is gelicentieerd onder de respectieve open-source licentie. Klik op een pakket om de volledige licentietekst in de bronrepository weer te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy pakiet jest udostępniany na odpowiedniej licencji otwartego oprogramowania. Kliknij dowolny pakiet, aby wyświetlić pełny tekst jego licencji w repozytorium źródłowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pacote é licenciado sob sua respectiva licença de código aberto. Clique em qualquer pacote para visualizar o texto completo da licença no repositório de origem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pacote é licenciado sob a sua respetiva licença de código aberto. Clique em qualquer pacote para ver o texto completo da licença no repositório de origem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare pachet este licențiat conform propriei licențe cu sursă deschisă. Apasă pe orice pachet pentru a vedea textul integral al licenței în depozitul de cod sursă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый пакет имеет лицензию в соответствии с его соответствующей лицензией с открытым исходным кодом. Нажмите на любой пакет, чтобы просмотреть полный текст лицензии в исходном репозитории."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje paket är licensierat under sitt respektive öppen källkods-licens. Klicka på ett paket för att se dess fullständiga licenstekst i källdatabasen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละแพ็กเกจอยู่ภายใต้สัญญาอนุญาตโอเพนซอร์สของตนเอง คลิกแพ็กเกจใดก็ได้เพื่อดูข้อความสัญญาอนุญาตฉบับเต็มในที่เก็บซอร์สโค้ด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her paket, kendi açık kaynak lisansı kapsamında lisanslanmıştır. Kaynak deposundaki lisans metninin tamamını görüntülemek için herhangi bir pakete tıklayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi gói được cấp phép theo giấy phép nguồn mở tương ứng. Nhấp vào bất kỳ gói nào để xem toàn văn giấy phép trong kho mã nguồn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "每個套件均依照各自的開放原始碼授權條款授權。點選任何套件，即可在原始碼儲存庫中查看完整的授權條款。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个软件包均根据各自的开源许可证授权。点击任意软件包，即可在源代码仓库中查看其完整许可证文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個套件皆依其各自的開放原始碼授權條款授權。點選任一套件，即可在原始碼儲存庫中檢視完整授權條款。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各パッケージには、それぞれのオープンソースライセンスが適用されます。パッケージをクリックすると、ソースリポジトリでライセンスの全文を確認できます。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всеки пакет се предоставя под съответния си лиценз за отворен код. Натиснете върху пакет, за да видите пълния текст на лиценза му в хранилището на изходния код."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each package is licensed under its respective open source license. Click on any package to view its full license text in the source repository."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki paket licenciran je pod svojom licencom otvorenog koda. Kliknite bilo koji paket za prikaz cjelovitog teksta njegove licence u izvornom repozitoriju."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 패키지에는 해당 오픈 소스 라이선스가 적용됩니다. 패키지를 클릭하면 소스 저장소에서 라이선스 전문을 볼 수 있습니다."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý balík je licencovaný podľa príslušnej licencie otvoreného zdrojového kódu. Kliknutím na ľubovoľný balík zobrazíte úplný text jeho licencie v zdrojovom repozitári."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен пакет поширюється за відповідною ліцензією відкритого коду. Натисніть будь-який пакет, щоб переглянути повний текст його ліцензії в репозиторії вихідного коду."
          }
        }
      }
    },
