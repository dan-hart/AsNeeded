    "iPhone hasn’t responded. Open AsNeeded there, then refresh.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El iPhone no ha respondido. Abre AsNeeded en él y luego actualiza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das iPhone hat nicht geantwortet. Öffne dort AsNeeded und aktualisiere anschließend."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone n’a pas répondu. Ouvrez AsNeeded sur celui-ci, puis actualisez."
          }
        },
        "ar": {
