        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son dozların miktarları veya birimleri eşleşmiyor. Doz geçmişinizi gözden geçirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
