        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatıcı ayarlarınız güncellenemedi. Lütfen tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося оновити налаштування нагадувань. Спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
