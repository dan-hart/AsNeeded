    "All your medications are well stocked. No refills needed right now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جميع أدويتك بحالة جيدة. لا توجد حاجة لإعادة ملء الآن."
          }
        },
        "ca": {
          "stringUnit": {
