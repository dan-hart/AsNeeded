    "Select a font that works best for you. Tap any option to see a live preview and learn more about its accessibility features.": {
      "comment": "Description for font family picker",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الخط الأنسب لك. اضغط على أي خيار لعرض معاينة مباشرة ومعرفة المزيد عن ميزات تسهيلات الاستخدام فيه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona el tipus de lletra que et vagi millor. Toca qualsevol opció per veure'n una previsualització en directe i obtenir més informació sobre les seves funcions d'accessibilitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte si písmo, které vám nejlépe vyhovuje. Klepnutím na kteroukoli možnost zobrazíte živý náhled a dozvíte se více o jejích funkcích zpřístupnění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en skrifttype, der fungerer bedst for dig. Tryk på en indstilling for at se en live forhåndsvisning og lær mere om dens tilgængelighedsfunktioner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Schriftart, die am besten für Sie geeignet ist. Tippen Sie auf eine beliebige Option, um eine Live-Vorschau anzuzeigen und weitere Informationen zu den Barrierefreiheitsfunktionen zu erfahren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε τη γραμματοσειρά που σας εξυπηρετεί καλύτερα. Πατήστε οποιαδήποτε επιλογή για να δείτε ζωντανή προεπισκόπηση και να μάθετε περισσότερα για τις δυνατότητες προσβασιμότητάς της."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a font that works best for you. Tap any option to see a live preview and learn more about its accessibility features."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a font that works best for you. Tap any option to see a live preview and learn more about its accessibility features."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una fuente que funcione mejor para ti. Toca cualquier opción para ver una vista previa en vivo y obtener más información sobre sus características de accesibilidad."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una fuente que funcione mejor para ti. Toca cualquier opción para ver una vista previa en vivo y obtener más información sobre sus características de accesibilidad."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قلمی را انتخاب کنید که برایتان مناسب‌تر است. برای دیدن پیش‌نمایش زنده و آشنایی بیشتر با قابلیت‌های دسترس‌پذیری هر گزینه، روی آن بزنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse sinulle parhaiten sopiva fontti. Napauta mitä tahansa vaihtoehtoa nähdäksesi reaaliaikaisen esikatselun ja saadaksesi lisätietoja sen saavutettavuusominaisuuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez la police qui vous convient le mieux. Touchez une option pour afficher un aperçu en direct et en savoir plus sur ses fonctionnalités d’accessibilité."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez la police qui vous convient le mieux. Touchez une option pour voir un aperçu en direct et en savoir plus sur ses fonctions d’accessibilité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור את הגופן המתאים לך ביותר. הקשה על כל אפשרות תציג תצוגה מקדימה חיה ומידע נוסף על תכונות הנגישות שלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने लिए सबसे उपयुक्त फ़ॉन्ट चुनें। तुरंत पूर्वावलोकन देखने और उसकी सुलभता सुविधाओं के बारे में अधिक जानने के लिए किसी भी विकल्प पर टैप करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki a számodra legmegfelelőbb betűtípust. Koppints bármelyik lehetőségre az élő előnézet megtekintéséhez és az akadálymentesítési funkciók megismeréséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih jenis huruf yang paling sesuai untuk Anda. Ketuk opsi mana saja untuk melihat pratinjau langsung dan mempelajari lebih lanjut tentang fitur aksesibilitasnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona il carattere più adatto a te. Tocca un’opzione per vedere un’anteprima in tempo reale e scoprire le sue funzionalità di accessibilità."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өзіңізге ең қолайлы қаріпті таңдаңыз. Алдын ала көріп, оның қолжетімділік мүмкіндіктері туралы көбірек білу үшін кез келген нұсқаны түртіңіз."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih fon yang paling sesuai untuk anda. Ketik mana-mana pilihan untuk melihat pratonton langsung dan mengetahui lebih lanjut tentang ciri kebolehcapaiannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en skrifttype som fungerer best for deg. Trykk på et alternativ for å se en live forhåndsvisning og lær mer om dens tilgjengelighetsfunksjoner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer een lettertype dat het beste voor u werkt. Tik op een optie om een live preview te zien en meer te weten te komen over de toegankelijkheidsfuncties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz czcionkę, która najbardziej Ci odpowiada. Stuknij dowolną opcję, aby zobaczyć podgląd na żywo i dowiedzieć się więcej o jej funkcjach dostępności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma fonte que funcione melhor para você. Toque em qualquer opção para ver uma visualização ao vivo e saiba mais sobre seus recursos de acessibilidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma fonte que funcione melhor para si. Toque em qualquer opção para ver uma visualização ao vivo e saiba mais sobre seus recursos de acessibilidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectează fontul care ți se potrivește cel mai bine. Atinge orice opțiune pentru a vedea o previzualizare în timp real și a afla mai multe despre funcțiile sale de accesibilitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите шрифт, который работает лучше всего для вас. Нажмите на любой вариант, чтобы увидеть живой предпросмотр и узнать больше о его функциях доступности."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett teckensnitt som fungerar bäst för dig. Tryck på ett alternativ för att se en live förhandsvisning och läs mer om dess tillgänglighetsfunktioner."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกแบบอักษรที่เหมาะกับคุณที่สุด แตะตัวเลือกใดก็ได้เพื่อดูตัวอย่างทันทีและเรียนรู้เพิ่มเติมเกี่ยวกับคุณสมบัติการช่วยการเข้าถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Size en uygun yazı tipini seçin. Canlı önizlemeyi görmek ve erişilebilirlik özellikleri hakkında daha fazla bilgi edinmek için herhangi bir seçeneğe dokunun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn phông chữ phù hợp nhất với bạn. Chạm vào bất kỳ lựa chọn nào để xem trước trực tiếp và tìm hiểu thêm về các tính năng trợ năng của phông chữ đó."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇最適合你的字體。點一下任何選項，即可即時預覽並了解其輔助使用功能。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择最适合您的字体。轻点任意选项即可实时预览，并了解其辅助功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇最適合您的字體。點一下任一選項，即可即時預覽並進一步了解其輔助使用特色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分に合ったフォントを選択してください。各項目をタップすると、リアルタイムのプレビューとアクセシビリティ機能の詳細を確認できます。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете шрифт, който ви подхожда най-добре. Докоснете някоя от опциите, за да видите визуализация на живо и да научите повече за функциите ѝ за достъпност."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a font that works best for you. Tap any option to see a live preview and learn more about its accessibility features."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite font koji vam najbolje odgovara. Dodirnite bilo koju opciju za pregled uživo i više informacija o njezinim značajkama pristupačnosti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 읽기 편한 글꼴을 선택하세요. 각 옵션을 탭하면 실시간 미리보기를 보고 접근성 기능에 대해 자세히 알아볼 수 있습니다."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte si písmo, ktoré vám najviac vyhovuje. Klepnutím na ľubovoľnú možnosť zobrazíte živý náhľad a dozviete sa viac o jej funkciách prístupnosti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть шрифт, який найкраще вам підходить. Торкніться будь-якого варіанта, щоб переглянути його наживо й дізнатися більше про його можливості доступності."
          }
        }
      }
    },
    "Select a medication in the toolbar to see its trends.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un medicamento en la barra de herramientas para ver sus tendencias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle in der Symbolleiste ein Medikament aus, um seine Trends anzusehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un médicament dans la barre d’outils pour voir ses tendances."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر دواءً من شريط الأدوات لعرض اتجاهات استخدامه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור תרופה בסרגל הכלים כדי לראות את המגמות שלה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای مشاهدهٔ روندهای یک دارو، آن را در نوار ابزار انتخاب کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーで薬を選択すると、その傾向を確認できます。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете лекарство в лентата с инструменти, за да видите тенденциите за него."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un medicament a la barra d'eines per veure'n les tendències."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte lék na panelu nástrojů a zobrazte jeho trendy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et lægemiddel i værktøjslinjen for at se dets tendenser."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε ένα φάρμακο στη γραμμή εργαλείων για να δείτε τις τάσεις του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a medication in the toolbar to see its trends."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a medication in the toolbar to see its trends."
          }
        },
        "en-GB": {
