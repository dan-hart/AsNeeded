    "An unexpected error occurred while loading your data. Please try again or contact support if the problem persists.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha producido un error inesperado al cargar tus datos. Inténtalo de nuevo o contacta con el servicio de asistencia si el problema persiste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Laden Ihrer Daten ist ein unerwarteter Fehler aufgetreten. Bitte versuchen Sie es erneut oder wenden Sie sich an den Support, wenn das Problem weiterhin besteht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur inattendue s’est produite lors du chargement de vos données. Veuillez réessayer ou contacter l’assistance si le problème persiste."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ غير متوقع أثناء تحميل بياناتك. يُرجى المحاولة مجددًا أو التواصل مع الدعم إذا استمرت المشكلة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אירעה שגיאה בלתי צפויה בטעינת הנתונים שלך. יש לנסות שוב או לפנות לתמיכה אם הבעיה נמשכת."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام بارگیری داده‌های شما خطای غیرمنتظره‌ای رخ داد. لطفاً دوباره تلاش کنید یا در صورت ادامهٔ مشکل با پشتیبانی تماس بگیرید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データの読み込み中に予期しないエラーが発生しました。もう一度お試しください。問題が続く場合は、サポートにお問い合わせください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Възникна неочаквана грешка при зареждането на данните ви. Опитайте отново или се свържете с поддръжката, ако проблемът продължава."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'ha produït un error inesperat en carregar les teves dades. Torna-ho a provar o contacta amb el servei d'assistència si el problema persisteix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při načítání dat došlo k neočekávané chybě. Zkuste to znovu. Pokud problém přetrvává, kontaktujte podporu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der opstod en uventet fejl under indlæsning af dine data. Prøv igen, eller kontakt support, hvis problemet fortsætter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρουσιάστηκε μη αναμενόμενο σφάλμα κατά τη φόρτωση των δεδομένων σας. Δοκιμάστε ξανά ή επικοινωνήστε με την υποστήριξη αν το πρόβλημα επιμένει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unexpected error occurred while loading your data. Please try again or contact support if the problem persists."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "An unexpected error occurred while loading your data. Please try again or contact support if the problem persists."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "An unexpected error occurred while loading your data. Please try again or contact support if the problem persists."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocurrió un error inesperado al cargar tus datos. Inténtalo de nuevo o comunícate con soporte si el problema persiste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietojesi lataamisessa tapahtui odottamaton virhe. Yritä uudelleen tai ota yhteyttä tukeen, jos ongelma jatkuu."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur inattendue s’est produite lors du chargement de vos données. Veuillez réessayer ou communiquer avec l’assistance si le problème persiste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका डेटा लोड करते समय एक अनपेक्षित त्रुटि हुई। कृपया फिर से प्रयास करें या समस्या बनी रहने पर सहायता से संपर्क करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Došlo je do neočekivane pogreške pri učitavanju tvojih podataka. Pokušaj ponovno ili se obrati podršci ako se problem nastavi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Váratlan hiba történt az adatok betöltésekor. Próbálja újra, vagy ha a probléma továbbra is fennáll, forduljon az ügyfélszolgálathoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjadi kesalahan tak terduga saat memuat data Anda. Silakan coba lagi atau hubungi dukungan jika masalah berlanjut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è verificato un errore imprevisto durante il caricamento dei dati. Riprova o contatta l'assistenza se il problema persiste."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деректеріңізді жүктеу кезінде күтпеген қате орын алды. Қайталап көріңіз немесе мәселе шешілмесе, қолдау қызметіне хабарласыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터를 불러오는 중 예기치 않은 오류가 발생했습니다. 다시 시도하거나 문제가 지속되면 지원팀에 문의하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ralat yang tidak dijangka berlaku semasa memuatkan data anda. Sila cuba lagi atau hubungi sokongan jika masalah berterusan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det oppstod en uventet feil under innlasting av dataene dine. Prøv igjen, eller kontakt brukerstøtte hvis problemet vedvarer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een onverwachte fout opgetreden bij het laden van je gegevens. Probeer het opnieuw of neem contact op met de ondersteuning als het probleem aanhoudt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas wczytywania danych wystąpił nieoczekiwany błąd. Spróbuj ponownie lub skontaktuj się z pomocą techniczną, jeśli problem będzie się powtarzał."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um erro inesperado ao carregar seus dados. Tente novamente ou entre em contato com o suporte se o problema persistir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um erro inesperado ao carregar os seus dados. Tente novamente ou contacte o suporte se o problema persistir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "A apărut o eroare neașteptată la încărcarea datelor. Încearcă din nou sau contactează asistența dacă problema persistă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При загрузке данных произошла непредвиденная ошибка. Повторите попытку или обратитесь в службу поддержки, если проблема сохраняется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri načítavaní vašich údajov sa vyskytla neočakávaná chyba. Skúste to znova alebo kontaktujte podporu, ak problém pretrváva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett oväntat fel inträffade när dina data skulle läsas in. Försök igen eller kontakta supporten om problemet kvarstår."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกิดข้อผิดพลาดที่ไม่คาดคิดขณะโหลดข้อมูลของคุณ โปรดลองอีกครั้ง หรือติดต่อฝ่ายสนับสนุนหากปัญหายังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verileriniz yüklenirken beklenmeyen bir hata oluştu. Lütfen tekrar deneyin veya sorun devam ederse destek ekibiyle iletişime geçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час завантаження даних сталася неочікувана помилка. Спробуйте ще раз або зверніться до служби підтримки, якщо проблема не зникає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xảy ra lỗi không mong muốn khi tải dữ liệu của bạn. Vui lòng thử lại hoặc liên hệ bộ phận hỗ trợ nếu sự cố vẫn tiếp diễn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "載入資料時發生未預期的錯誤。請再試一次；如問題持續，請聯絡支援。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载数据时发生意外错误。请重试；如果问题仍然存在，请联系支持团队。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "載入資料時發生未預期的錯誤。請再試一次；若問題持續發生，請聯絡支援團隊。"
          }
        }
      }
    },
