    "Choose how long to keep backups (7 days to 1 year). Older backups are deleted daily to save space. Today's backup is always kept.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مدة حفظ النسخ (7 أيام إلى سنة). النسخ القديمة تُحذف يومياً. نسخة اليوم تُحفظ دائماً."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria quant de temps vols conservar les còpies de seguretat (de 7 dies a 1 any). Les còpies més antigues s'eliminen diàriament per estalviar espai. La còpia d'avui es conserva sempre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, jak dlouho se mají zálohy uchovávat (7 dní až 1 rok). Starší zálohy se denně mažou, aby se uvolnilo místo. Dnešní záloha se vždy ponechá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg hvor længe du vil beholde sikkerhedskopier (7 dage til 1 år). Ældre sikkerhedskopier slettes dagligt for at spare plads. Dagens sikkerhedskopi bevares altid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie, wie lange Sicherungen beibeholt werden (7 Tage bis 1 Jahr). Ältere Sicherungen werden täglich gelöscht, um Speicherplatz zu sparen. Die heutige Sicherung wird immer beibehalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε για πόσο διάστημα θα διατηρούνται τα αντίγραφα ασφαλείας (από 7 ημέρες έως 1 έτος). Τα παλαιότερα αντίγραφα ασφαλείας διαγράφονται καθημερινά για εξοικονόμηση χώρου. Το σημερινό αντίγραφο ασφαλείας διατηρείται πάντα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how long to keep backups (7 days to 1 year). Older backups are deleted daily to save space. Today's backup is always kept."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how long to keep backups (7 days to 1 year). Older backups are deleted daily to save space. Today's backup is always kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuánto tiempo mantener las copias de seguridad (7 días a 1 año). Las copias de seguridad más antiguas se eliminan diariamente para ahorrar espacio. La copia de seguridad de hoy siempre se conserva."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuánto tiempo mantener las copias de seguridad (7 días a 1 año). Las copias de seguridad más antiguas se eliminan diariamente para ahorrar espacio. La copia de seguridad de hoy siempre se conserva."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتخاب کنید چگونه طول مدت نگهداری نسخه‌ها. نسخه‌های قدیمی روزانه حذف می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse varmuuskopioiden säilytysaika (7 päivästä 1 vuoteen). Vanhemmat varmuuskopiot poistetaan päivittäin tilan säästämiseksi. Tämän päivän varmuuskopio säilytetään aina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la durée de conservation des sauvegardes (de 7 jours à 1 an). Les anciennes sauvegardes sont supprimées chaque jour pour libérer de l’espace. La sauvegarde du jour est toujours conservée."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la durée de conservation des sauvegardes (de 7 jours à 1 an). Les sauvegardes plus anciennes sont supprimées chaque jour pour libérer de l’espace. La sauvegarde d’aujourd’hui est toujours conservée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר כמה זמן לשמור גיבויים. גיבויים ישנים נמחקים יומי. גיבוי היום נשמר תמיד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि बैकअप को कितने समय तक रखना है (7 दिन से 1 साल)। पुरानी बैकअप स्थान बचाने के लिए रोज़ाना हटा दी जाती हैं। आज की बैकअप हमेशा रखी जाती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki, meddig őrizze meg a biztonsági mentéseket (7 naptól 1 évig). A régebbi mentések naponta törlődnek a helymegtakarítás érdekében. A mai biztonsági mentés mindig megmarad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih berapa lama cadangan disimpan (7 hari hingga 1 tahun). Cadangan lama dihapus setiap hari untuk menghemat ruang. Cadangan hari ini selalu disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli per quanto tempo conservare i backup (da 7 giorni a 1 anno). I backup più vecchi vengono eliminati ogni giorno per risparmiare spazio. Il backup di oggi viene sempre conservato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップを保持する期間を選択します（7日から1年）。古いバックアップはスペースを節約するために毎日削除されます。今日のバックアップは常に保持されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бәкіттерді қанша уақыт сақтау керектігін таңдаңыз (7 күннен 1 жылға дейін)। Ескі бәкіттер орындарды сөндіру үшін күнде өшіріледі। Бүгінгі бәкіт әрқашан сақталады।"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업을 유지할 기간을 선택하십시오(7일에서 1년). 공간을 절약하기 위해 오래된 백업이 매일 삭제됩니다. 오늘의 백업은 항상 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih tempoh penyimpanan sandaran (7 hari hingga 1 tahun). Sandaran lama dipadam setiap hari untuk menjimatkan ruang. Sandaran hari ini sentiasa dikekalkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg hvor lenge du vil beholde sikkerhetskopier (7 dager til 1 år). Eldre sikkerhetskopier slettes daglig for å spare plass. Dagens sikkerhetskopi bevares alltid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies hoe lang u back-ups wilt bewaren (7 dagen tot 1 jaar). Oudere back-ups worden dagelijks verwijderd om ruimte te besparen. De back-up van vandaag blijft altijd behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz okres przechowywania kopii zapasowych (od 7 dni do 1 roku). Starsze kopie są usuwane codziennie, aby oszczędzać miejsce. Dzisiejsza kopia jest zawsze zachowywana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quanto tempo manter backups (7 dias a 1 ano). Backups mais antigos são excluídos diariamente para economizar espaço. O backup de hoje é sempre mantido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quanto tempo manter cópias de segurança (7 dias a 1 ano). Cópias de segurança mais antigas são eliminadas diariamente para economizar espaço. A cópia de segurança de hoje é sempre mantida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege cât timp să păstrezi copiile de siguranță (de la 7 zile la 1 an). Copiile mai vechi sunt șterse zilnic pentru a economisi spațiu. Copia de siguranță de astăzi este păstrată întotdeauna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, как долго хранить резервные копии (от 7 дней до 1 года). Старые резервные копии удаляются ежедневно для экономии места. Резервная копия на сегодня всегда сохраняется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj hur länge du vill behålla säkerhetskopior (7 dagar till 1 år). Äldre säkerhetskopior raderas dagligen för att spara utrymme. Dagens säkerhetskopia sparas alltid."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกระยะเวลาเก็บข้อมูลสำรอง (7 วันถึง 1 ปี) ข้อมูลสำรองที่เก่ากว่าระยะเวลานี้จะถูกลบทุกวันเพื่อประหยัดพื้นที่ ข้อมูลสำรองของวันนี้จะถูกเก็บไว้เสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedeklemeleri ne kadar süre tutacağınızı seçin (7 günden 1 yıla kadar)। Eski yedeklemeler alan tasarrufu için günlük silinir। Bugünün yedeklemesi her zaman saklanır।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thời gian giữ bản sao lưu (từ 7 ngày đến 1 năm). Các bản sao lưu cũ hơn được xóa hằng ngày để tiết kiệm dung lượng. Bản sao lưu hôm nay luôn được giữ lại."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇保留備份的時間長度（7 日到 1 年）。舊備份每日刪除以節省空間。今日的備份始終保留。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择保留备份的时间长度（7 天到 1 年）。旧备份每天删除以节省空间。今天的备份始终保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇保留備份的時間長度（7 天到 1 年）。舊備份每天刪除以節省空間。今天的備份始終保留。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете колко дълго да се пазят резервните копия (от 7 дни до 1 година). По-старите резервни копия се изтриват ежедневно, за да се освободи място. Днешното резервно копие винаги се запазва."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how long to keep backups (7 days to 1 year). Older backups are deleted daily to save space. Today's backup is always kept."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite koliko dugo želite čuvati sigurnosne kopije (od 7 dana do 1 godine). Starije sigurnosne kopije svakodnevno se brišu radi uštede prostora. Današnja sigurnosna kopija uvijek se čuva."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, ako dlho sa majú zálohy uchovávať (7 dní až 1 rok). Staršie zálohy sa denne vymazávajú, aby sa ušetrilo miesto. Dnešná záloha sa vždy uchová."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть термін зберігання резервних копій (від 7 днів до 1 року). Старіші копії видаляються щодня для економії місця. Сьогоднішня резервна копія зберігається завжди."
          }
        }
      }
    },
