    "Add a medication in the Medication tab to see its recorded doses and trends.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un medicamento en la pestaña Medicamentos para ver sus dosis registradas y tendencias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie im Tab „Medikamente“ ein Medikament hinzu, um die erfassten Dosen und Trends zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un médicament dans l’onglet Médicaments pour voir ses doses enregistrées et ses tendances."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف دواءً في علامة تبويب الأدوية لعرض جرعاته المسجلة واتجاهاتها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להוסיף תרופה בלשונית התרופות כדי לראות את המנות שתועדו עבורה ואת המגמות שלה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای مشاهدهٔ دوزهای ثبت‌شده و روندهای یک دارو، آن را در زبانهٔ «دارو» اضافه کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録した服薬や傾向を確認するには、「薬」タブで薬を追加してください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавете лекарство в раздела „Лекарства“, за да видите записаните за него дози и тенденции."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix un medicament a la pestanya Medicació per veure’n les dosis registrades i les tendències."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte lék na kartě Léky a zobrazte si jeho zaznamenané dávky a trendy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj medicin på fanen Medicin for at se registrerede doser og tendenser."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε ένα φάρμακο στην καρτέλα Φάρμακα για να δείτε τις καταγεγραμμένες δόσεις και τις τάσεις του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a medication in the Medication tab to see its recorded doses and trends."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a medication in the Medication tab to see its recorded doses and trends."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a medication in the Medication tab to see its recorded doses and trends."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega un medicamento en la pestaña Medicamentos para ver sus dosis registradas y tendencias."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää lääke Lääkkeet-välilehdellä nähdäksesi sen kirjatut annokset ja trendit."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un médicament dans l’onglet Médicaments pour voir ses doses enregistrées et ses tendances."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दर्ज खुराकें और रुझान देखने के लिए दवा टैब में दवा जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj lijek na kartici Lijekovi za prikaz zabilježenih doza i trendova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon hozzá egy gyógyszert a Gyógyszerek lapon a rögzített adagok és trendek megtekintéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan obat di tab Obat untuk melihat dosis yang dicatat dan trennya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un farmaco nella scheda Farmaci per visualizzarne le dosi registrate e le tendenze."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тіркелген дозалар мен үрдістерді көру үшін «Дәрілер» қойындысында дәрі қосыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록된 복용 내역과 추세를 보려면 약물 탭에서 약물을 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah ubat dalam tab Ubat untuk melihat dos yang direkodkan dan trendnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til et legemiddel i fanen Legemidler for å se registrerte doser og trender."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een medicijn toe op het tabblad Medicatie om de geregistreerde doses en trends te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj lek na karcie Leki, aby zobaczyć zapisane dawki i trendy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um medicamento na aba Medicamentos para ver suas doses registradas e tendências."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um medicamento no separador Medicação para ver as doses registadas e as tendências."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă un medicament în fila Medicamente pentru a vedea dozele înregistrate și tendințele acestuia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте лекарство на вкладке «Лекарства», чтобы увидеть записи о приёмах и тенденции."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte liek na karte Lieky a zobrazte si jeho zaznamenané dávky a trendy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till ett läkemedel på fliken Läkemedel för att se dess registrerade doser och trender."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มยาในแท็บยาเพื่อดูบันทึกการใช้ยาและแนวโน้ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen dozları ve eğilimleri görmek için İlaç sekmesinde bir ilaç ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте препарат на вкладці «Ліки», щоб переглядати записані дози та тенденції."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm thuốc trong thẻ Thuốc để xem các liều đã ghi và xu hướng dùng thuốc."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在「藥物」分頁新增藥物，即可查看其用藥記錄及趨勢。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“药物”标签页中添加药物，以查看其用药记录和趋势。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「藥物」標籤頁新增藥物，即可查看其用藥記錄和趨勢。"
          }
        }
      }
