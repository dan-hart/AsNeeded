    "Review History before trying again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa el historial antes de volver a intentarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe den Verlauf, bevor du es erneut versuchst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez l’historique avant de réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع السجل قبل المحاولة مجددًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לעיין בהיסטוריה לפני ניסיון נוסף."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از تلاش دوباره، تاریخچه را مرور کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行する前に履歴を確認してください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прегледайте историята, преди да опитате отново."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa l'historial abans de tornar-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než to zkusíte znovu, zkontrolujte historii."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemgå historikken, før du prøver igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξτε το Ιστορικό πριν δοκιμάσετε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review History before trying again."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Review History before trying again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Review History before trying again."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa el historial antes de volver a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista historia ennen kuin yrität uudelleen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez l’historique avant de réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिर से कोशिश करने से पहले इतिहास की समीक्षा करें।"
          }
        },
        "hr": {
          "stringUnit": {
