    "Pre-migration backup failed. Migration cannot proceed without backup protection.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de seguridad previa a la migración ha fallado. La migración no puede continuar sin la protección de una copia de seguridad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherung vor der Migration ist fehlgeschlagen. Die Migration kann ohne Absicherung durch eine Sicherung nicht fortgesetzt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde préalable à la migration a échoué. La migration ne peut pas se poursuivre sans la protection d’une sauvegarde."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل النسخ الاحتياطي قبل ترحيل البيانات. لا يمكن متابعة الترحيل دون الحماية التي توفرها نسخة احتياطية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגיבוי לפני העברת הנתונים נכשל. לא ניתן להמשיך בהעברת הנתונים ללא הגנת גיבוי."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پشتیبان‌گیری پیش از انتقال داده‌ها ناموفق بود. انتقال داده‌ها بدون حفاظت نسخهٔ پشتیبان نمی‌تواند ادامه یابد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移行前のバックアップに失敗しました。バックアップによる保護なしでは移行を続行できません。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Създаването на резервно копие преди миграцията е неуспешно. Миграцията не може да продължи без защита чрез резервно копие."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha fallat la còpia de seguretat prèvia a la migració. La migració no pot continuar sense la protecció d'una còpia de seguretat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Záloha před migrací selhala. Migrace nemůže pokračovat bez ochrany zálohou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikkerhedskopiering før migrering mislykkedes. Migreringen kan ikke fortsætte uden beskyttelse fra en sikkerhedskopi."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η δημιουργία αντιγράφου ασφαλείας πριν από τη μετεγκατάσταση απέτυχε. Η μετεγκατάσταση δεν μπορεί να συνεχιστεί χωρίς την προστασία αντιγράφου ασφαλείας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre-migration backup failed. Migration cannot proceed without backup protection."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre-migration backup failed. Migration cannot proceed without backup protection."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre-migration backup failed. Migration cannot proceed without backup protection."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la copia de seguridad previa a la migración. La migración no puede continuar sin la protección de una copia de seguridad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietojen siirtoa edeltävä varmuuskopiointi epäonnistui. Tietojen siirtoa ei voi jatkaa ilman varmuuskopion suojaa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde avant la migration a échoué. La migration ne peut pas se poursuivre sans la protection d’une sauvegarde."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटा स्थानांतरण से पहले बैकअप विफल रहा। बैकअप की सुरक्षा के बिना डेटा स्थानांतरण आगे नहीं बढ़ सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izrada sigurnosne kopije prije migracije nije uspjela. Migracija se ne može nastaviti bez zaštite sigurnosnom kopijom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az adatmigráció előtti biztonsági mentés sikertelen. Biztonsági mentés nyújtotta védelem nélkül az adatmigráció nem folytatható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencadangan sebelum migrasi gagal. Migrasi tidak dapat dilanjutkan tanpa perlindungan cadangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creazione della copia di sicurezza prima della migrazione non riuscita. La migrazione non può procedere senza la protezione di una copia di sicurezza."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деректерді көшіру алдындағы сақтық көшірмені жасау сәтсіз аяқталды. Сақтық көшірме қорғанысынсыз деректерді көшіруді жалғастыру мүмкін емес."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이그레이션 전 백업에 실패했습니다. 백업으로 데이터를 보호하지 않으면 마이그레이션을 진행할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandaran sebelum migrasi gagal. Migrasi tidak boleh diteruskan tanpa perlindungan sandaran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikkerhetskopieringen før migrering mislyktes. Migreringen kan ikke fortsette uten beskyttelse fra en sikkerhetskopi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De back-up voorafgaand aan de migratie is mislukt. De migratie kan niet doorgaan zonder bescherming door een back-up."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utworzenie kopii zapasowej przed migracją nie powiodło się. Migracja nie może być kontynuowana bez zabezpieczenia w postaci kopii zapasowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha no backup anterior à migração. A migração não pode prosseguir sem a proteção de um backup."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia de segurança anterior à migração falhou. A migração não pode prosseguir sem a proteção de uma cópia de segurança."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Crearea copiei de siguranță înainte de migrare a eșuat. Migrarea nu poate continua fără protecția unei copii de siguranță."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать резервную копию перед миграцией. Миграция невозможна без защиты данных резервной копией."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zálohovanie pred migráciou zlyhalo. Migrácia nemôže pokračovať bez ochrany zálohou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säkerhetskopieringen före migreringen misslyckades. Migreringen kan inte fortsätta utan skyddet från en säkerhetskopia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำรองข้อมูลก่อนย้ายข้อมูลไม่สำเร็จ ไม่สามารถย้ายข้อมูลต่อได้หากไม่มีข้อมูลสำรองเพื่อป้องกันข้อมูลสูญหาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veri geçişi öncesi yedekleme başarısız oldu. Yedekleme koruması olmadan veri geçişine devam edilemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося створити резервну копію перед міграцією. Міграція неможлива без захисту резервною копією."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao lưu trước khi di chuyển dữ liệu thất bại. Không thể tiếp tục di chuyển dữ liệu nếu không có bản sao lưu bảo vệ."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "遷移前備份失敗。沒有備份保護，無法繼續遷移。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "迁移前备份失败。没有备份保护，无法继续迁移。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移轉前備份失敗。沒有備份保護，無法繼續移轉。"
          }
        }
      }
    },
