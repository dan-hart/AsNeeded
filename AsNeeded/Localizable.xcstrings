    "healthkit.sync.mode.asNeededSOT.desc": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحكم AsNeeded في بيانات الأدوية الخاصة بك. يتم نسخ التغييرات إلى Apple Health، ولكن التغييرات الخارجية يتم تجاهلها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded контролира данните за вашите лекарства. Промените се копират в Apple Health, но външните промени се игнорират."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded controla les teves dades de medicaments. Els canvis es copien a Apple Health, però els canvis externs s'ignoren."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded řídí data o vašich lécích. Změny se kopírují do Apple Health, ale externí změny jsou ignorovány."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded styrer dine medicindata. Ændringer kopieres til Apple Health, men eksterne ændringer ignoreres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded steuert Ihre Medikamentendaten. Änderungen werden nach Apple Health kopiert, externe Änderungen werden jedoch ignoriert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AsNeeded ελέγχει τα δεδομένα των φαρμάκων σας. Οι αλλαγές αντιγράφονται στο Apple Health, αλλά οι εξωτερικές αλλαγές αγνοούνται."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage in AsNeeded, backup to Apple Health"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage in AsNeeded, backup to Apple Health"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona en AsNeeded, copia de seguridad en Apple Health"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Administra en AsNeeded, respaldo en Apple Health"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در AsNeeded مدیریت کنید، در Apple Health پشتیبان‌گیری کنید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallitse AsNeededissä, varmuuskopioi Apple Healthiin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez dans AsNeeded, sauvegardez dans Apple Health"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez dans AsNeeded, sauvegardez dans Apple Santé"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נהל ב-AsNeeded, גבה ל-Apple Health"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded में प्रबंधन करें, Apple Health में बैकअप लें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravljaj u AsNeeded, izradi sigurnosnu kopiju u Apple Health"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezelés az AsNeeded alkalmazásban, biztonsági mentés az Apple Health alkalmazásba"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelola di AsNeeded, cadangkan ke Apple Health"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci in AsNeeded, backup su Apple Health"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeededで管理し、Apple Healthにバックアップ"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded қолданбасында басқарып, Apple Health қызметіне сақтық көшірмесін жасаңыз"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded에서 관리, Apple Health에 백업"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Urus dalam AsNeeded, sandaran ke Apple Health"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrer i AsNeeded, sikkerhetskopier til Apple Health"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer in AsNeeded, back-up naar Apple Health"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarządzaj w AsNeeded, kopia zapasowa w Apple Health"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie no AsNeeded, backup no Apple Health"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded é a fonte principal; as alterações sincronizam com a Saúde"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded este sursa principală; modificările se sincronizează cu Sănătate"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded является основным источником; изменения синхронизируются со Здоровьем"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded je hlavný zdroj; zmeny sa synchronizujú so Zdravím"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded är den primära källan; ändringar synkroniseras med Hälsa"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded เป็นแหล่งหลัก การเปลี่ยนแปลงจะซิงค์กับสุขภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded ana kaynaktır. Değişiklikler Apple Health'e gönderilir ancak Apple Health'ten gelen güncellemeler yoksayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded є джерелом істини. Зміни надсилаються до Apple Health, але оновлення з Apple Health ігноруються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded là nguồn chính thống. Thay đổi được gửi đến Apple Health nhưng cập nhật từ Apple Health bị bỏ qua."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在 AsNeeded 中管理，並備份至 Apple Health"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded 是真实来源。更改发送到 Apple Health，但来自 Apple Health 的更新会被忽略。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded 是真實來源。更改發送到 Apple Health，但來自 Apple Health 的更新會被忽略。"
          }
        },
        "en": {
          "stringUnit": {
