    "Recent timing and daily use look within the guidance you saved for this medication.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los intervalos recientes y el uso diario parecen ajustarse a las indicaciones que guardaste para este medicamento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten Einnahmeabstände und der tägliche Verbrauch scheinen innerhalb der Vorgaben zu liegen, die du für dieses Medikament gespeichert hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les horaires récents et l’utilisation quotidienne semblent respecter les consignes que vous avez enregistrées pour ce médicament."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أن توقيت الجرعات الأخيرة والاستخدام اليومي يتوافقان مع الإرشادات التي حفظتها لهذا الدواء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נראה שתזמון המנות והשימוש היומי בתקופה האחרונה נמצאים בגבולות ההנחיות ששמרת לתרופה זו."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به نظر می‌رسد زمان‌بندی اخیر و مصرف روزانه در محدودهٔ راهنمایی است که برای این دارو ذخیره کرده‌اید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の投与タイミングと1日あたりの使用量は、この薬について保存した指針の範囲内にあるようです。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Скорошните часове на прием и дневната употреба изглеждат в рамките на указанията, които сте запазили за това лекарство."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els intervals entre les preses recents i el consum diari semblen ajustar-se a les pautes que has desat per a aquest medicament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedávné časy užití a denní spotřeba se zdají být v mezích pokynů, které jste pro tento lék uložili."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De seneste doseringstidspunkter og den daglige brug ser ud til at være inden for den vejledning, du har gemt for denne medicin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πρόσφατοι χρόνοι λήψης και η ημερήσια χρήση φαίνεται να συμφωνούν με τις οδηγίες που αποθηκεύσατε για αυτό το φάρμακο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent timing and daily use look within the guidance you saved for this medication."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent timing and daily use look within the guidance you saved for this medication."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent timing and daily use look within the guidance you saved for this medication."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los intervalos recientes y el uso diario parecen estar dentro de las indicaciones que guardaste para este medicamento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeaikaiset annosajat ja päivittäinen käyttö näyttävät olevan tälle lääkkeelle tallentamiesi ohjeiden mukaisia."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures de prise récentes et l’utilisation quotidienne semblent respecter les consignes que vous avez enregistrées pour ce médicament."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाल की खुराकों का समय और दैनिक उपयोग इस दवा के लिए आपके सहेजे गए मार्गदर्शन की सीमाओं के भीतर लगते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čini se da su nedavni vremenski razmaci i dnevno uzimanje unutar smjernica koje ste spremili za ovaj lijek."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legutóbbi bevételek időzítése és a napi használat a gyógyszerhez mentett útmutatásnak megfelelőnek tűnik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu penggunaan terbaru dan penggunaan harian tampaknya sesuai dengan panduan yang Anda simpan untuk obat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli intervalli recenti tra le dosi e il consumo giornaliero sembrano rientrare nelle indicazioni che hai salvato per questo farmaco."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы қабылдау уақыттары мен күнделікті қолдану осы дәрі үшін сақтаған нұсқауларыңыздың шегінде сияқты."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 복용 간격과 일일 사용량이 이 약에 대해 저장한 지침 범위 내에 있는 것으로 보입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa pengambilan dan penggunaan harian terkini kelihatan mematuhi panduan yang anda simpan untuk ubat ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nylige dosetidspunkter og daglig bruk ser ut til å være innenfor veiledningen du har lagret for dette legemiddelet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De recente tijdsintervallen en het dagelijkse gebruik lijken binnen de richtlijnen te vallen die je voor dit medicijn hebt opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnie odstępy między dawkami i dzienne zużycie wydają się mieścić w zapisanych wskazówkach dla tego leku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os intervalos recentes entre doses e o uso diário parecem estar dentro das orientações que você salvou para este medicamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os intervalos recentes entre doses e a utilização diária parecem estar dentro das orientações que guardou para este medicamento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalele recente dintre doze și utilizarea zilnică par să respecte indicațiile salvate pentru acest medicament."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Судя по последним данным, интервалы между приёмами и суточное количество соответствуют сохранённым вами указаниям для этого лекарства."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedávne časové odstupy a denné užívanie sa zdajú byť v súlade s pokynmi, ktoré ste pre tento liek uložili."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den senaste tidens dosintervall och dagliga användning verkar ligga inom den vägledning du har sparat för det här läkemedlet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงเวลาที่ใช้ยาและการใช้ยารายวันในระยะหลังดูเหมือนจะอยู่ภายในแนวทางที่คุณบันทึกไว้สำหรับยานี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son dozların zamanlaması ve günlük kullanım, bu ilaç için kaydettiğiniz yönergelere uygun görünüyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час нещодавніх прийомів і добове вживання, схоже, відповідають збереженим вами вказівкам для цих ліків."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời điểm dùng thuốc gần đây và mức sử dụng hằng ngày có vẻ nằm trong hướng dẫn bạn đã lưu cho thuốc này."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "最近的用藥時間及每日用量看來符合你為此藥物儲存的指引。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近期用药时间和每日用量似乎在你为此药物保存的指导范围内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "近期的用藥間隔與每日用量似乎符合您為此藥物儲存的指引。"
          }
        }
      }
    },
    "Reconfigure Now": {
      "localizations": {
        "ar": {
          "stringUnit": {
