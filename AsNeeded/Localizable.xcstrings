    "This controls what happens when you import data that contains app settings. You can always change your choice during import.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحكم هذا في ما يحدث عند استيراد بيانات تحتوي على إعدادات التطبيق. يمكنك دائمًا تغيير اختيارك أثناء الاستيراد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això controla què passa quan importes dades que contenen la configuració de l'app. Sempre pots canviar la tria durant la importació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto určuje, co se stane při importu dat obsahujících nastavení aplikace. Svou volbu můžete během importu kdykoli změnit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette styrer, hvad der sker, når du importerer data, der indeholder app-indstillinger. Du kan altid ændre dit valg under import."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies steuert, was geschieht, wenn Sie Daten mit App-Einstellungen importieren. Sie können Ihre Wahl jederzeit während des Imports ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό καθορίζει τι συμβαίνει όταν εισάγετε δεδομένα που περιέχουν ρυθμίσεις της εφαρμογής. Μπορείτε πάντα να αλλάξετε την επιλογή σας κατά την εισαγωγή."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This controls what happens when you import data that contains app settings. You can always change your choice during import."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This controls what happens when you import data that contains app settings. You can always change your choice during import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto controla lo que sucede cuando importas datos que contienen configuración de la aplicación. Siempre puedes cambiar tu elección durante la importación."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto controla lo que sucede cuando importas datos que contienen configuración de la aplicación. Siempre puedes cambiar tu elección durante la importación."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این گزینه تعیین می‌کند هنگام ورود داده‌هایی که شامل تنظیمات برنامه هستند چه اتفاقی بیفتد. همیشه می‌توانید هنگام ورود داده‌ها انتخاب خود را تغییر دهید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä määrittää, mitä tapahtuu, kun tuot sovellusasetuksia sisältäviä tietoja. Voit aina muuttaa valintaasi tuonnin aikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce réglage détermine ce qui se passe lorsque vous importez des données contenant des réglages de l’app. Vous pouvez toujours modifier votre choix lors de l’importation."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce réglage détermine ce qui se passe lorsque vous importez des données contenant des réglages de l’app. Vous pouvez toujours modifier votre choix pendant l’importation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפשרות הזו קובעת מה יקרה בעת ייבוא נתונים המכילים הגדרות יישום. תמיד ניתן לשנות את הבחירה במהלך הייבוא."
