    "The dose unit does not match the saved 24-hour quantity limit. No conversion is assumed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La unidad de dosis no coincide con la del límite de cantidad guardado para 24 horas. No se presupone ninguna conversión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dosiseinheit stimmt nicht mit der gespeicherten Mengenbegrenzung für 24 Stunden überein. Es wird keine Umrechnung angenommen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’unité de dose ne correspond pas à celle de la limite de quantité enregistrée sur 24 heures. Aucune conversion n’est supposée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وحدة الجرعة لا تطابق وحدة الحد الأقصى للكمية المحفوظ لفترة 24 ساعة. لا يُفترض أي تحويل بين الوحدات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יחידת המידה של המנה אינה תואמת לזו של מגבלת הכמות השמורה ל-24 שעות. לא מניחים שניתן להמיר ביניהן."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "واحد مقدار مصرف با محدودیت مقدار مصرف ۲۴ ساعتهٔ ذخیره‌شده مطابقت ندارد. هیچ تبدیل واحدی فرض نمی‌شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "服用量の単位が、保存されている24時間の数量上限の単位と一致しません。自動的な換算は行いません。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Единицата за дозата не съответства на запазеното количествено ограничение за 24 часа. Не се приема автоматично преобразуване между единиците."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La unitat de la dosi no coincideix amb la del límit de quantitat en 24 hores desat. No s'assumeix cap conversió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednotka dávky neodpovídá uloženému limitu množství za 24 hodin. Žádný převod se nepředpokládá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosisenheden stemmer ikke overens med den gemte mængdegrænse for 24 timer. Der antages ingen omregning."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μονάδα της δόσης δεν αντιστοιχεί στο αποθηκευμένο όριο ποσότητας 24ώρου. Δεν θεωρείται δεδομένη καμία μετατροπή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The dose unit does not match the saved 24-hour quantity limit. No conversion is assumed."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The dose unit does not match the saved 24-hour quantity limit. No conversion is assumed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The dose unit does not match the saved 24-hour quantity limit. No conversion is assumed."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La unidad de la dosis no coincide con la del límite de cantidad guardado para 24 horas. No se supone ninguna conversión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Annoksen yksikkö ei vastaa tallennetun 24 tunnin enimmäismäärän yksikköä. Yksikkömuunnosta ei oleteta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’unité de la dose ne correspond pas à celle de la limite de quantité sur 24 heures enregistrée. Aucune conversion n’est présumée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खुराक की इकाई सहेजी गई 24 घंटे की मात्रा सीमा की इकाई से मेल नहीं खाती। इकाइयों के बीच कोई रूपांतरण नहीं माना गया है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedinica doze ne odgovara spremljenom ograničenju količine u razdoblju od 24 sata. Pretvorba se ne pretpostavlja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az adag mértékegysége nem egyezik a mentett 24 órás mennyiségi korlát mértékegységével. A rendszer nem feltételez átváltást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satuan dosis tidak sesuai dengan batas jumlah 24 jam yang disimpan. Tidak ada konversi yang diasumsikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’unità della dose non corrisponde a quella del limite di quantità salvato per le 24 ore. Non viene presunta alcuna conversione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозаның өлшем бірлігі сақталған 24 сағаттық мөлшер шегіне сәйкес келмейді. Бірліктерді түрлендіру болжанбайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복용량 단위가 저장된 24시간 수량 한도의 단위와 일치하지 않습니다. 단위 변환은 적용하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Unit dos tidak sepadan dengan had kuantiti 24 jam yang disimpan. Tiada penukaran unit diandaikan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Doseenheten samsvarer ikke med den lagrede mengdegrensen for 24 timer. Det antas ingen omregning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De dosiseenheid komt niet overeen met de opgeslagen hoeveelheidslimiet per 24 uur. Er wordt niet automatisch omgerekend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednostka dawki nie odpowiada jednostce zapisanego limitu ilości w ciągu 24 godzin. Nie zakłada się żadnego przeliczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A unidade da dose não corresponde à do limite de quantidade salvo para 24 horas. Nenhuma conversão é presumida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A unidade da dose não corresponde ao limite de quantidade guardado para 24 horas. Não se presume qualquer conversão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unitatea de măsură a dozei nu corespunde limitei cantitative salvate pe 24 de ore. Nu se presupune nicio conversie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Единица измерения дозы не совпадает с единицей сохранённого ограничения количества за 24 часа. Пересчёт единиц не выполняется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednotka dávky sa nezhoduje s uloženým limitom množstva za 24 hodín. Nepredpokladá sa žiadny prepočet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosenheten stämmer inte överens med den sparade mängdgränsen för 24 timmar. Ingen omräkning förutsätts."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน่วยขนาดยาไม่ตรงกับหน่วยของปริมาณสูงสุดใน 24 ชั่วโมงที่บันทึกไว้ ระบบจะไม่ถือว่ามีการแปลงหน่วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doz birimi, kayıtlı 24 saatlik miktar sınırıyla eşleşmiyor. Herhangi bir birim dönüşümü varsayılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одиниця вимірювання дози не відповідає збереженому обмеженню кількості за 24 години. Перерахунок не передбачається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đơn vị liều không khớp với giới hạn số lượng trong 24 giờ đã lưu. Không tự giả định cách quy đổi."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "劑量單位與已儲存的 24 小時用量上限不符。不會假設任何單位換算。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
