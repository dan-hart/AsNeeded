            "value": "Fragt vor dem Löschen nach einer Bestätigung"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande confirmation avant la suppression"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب التأكيد قبل الحذف"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מבקש אישור לפני מחיקה"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از حذف، تأیید می‌خواهد"
          }
        },
        "ja": {
