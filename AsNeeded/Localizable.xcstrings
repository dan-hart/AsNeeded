    "Automatically saves your medications and dose history to a location you choose after logging a dose.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ أدويتك وسجل الجرعات تلقائياً بعد تسجيل جرعة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desa automàticament els teus medicaments i l'historial de dosis en una ubicació que triïs després de registrar una dosi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zaznamenání dávky automaticky uloží vaše léky a historii dávek do vámi zvoleného umístění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemmer automatisk dine mediciner og dosishistorik til et sted, du vælger, efter at have logget en dosis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert automatisch Ihre Medikamente und den Dosis-Verlauf an einem Speicherort Ihrer Wahl nach dem Protokollieren einer Dosis."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύει αυτόματα τα φάρμακά σας και το ιστορικό δόσεων σε μια τοποθεσία που επιλέγετε, αφού καταγράψετε μια δόση."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically saves your medications and dose history to a location you choose after logging a dose."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically saves your medications and dose history to a location you choose after logging a dose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda automáticamente tus medicamentos e historial de dosis en una ubicación que elijas después de registrar una dosis."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda automáticamente tus medicamentos e historial de dosis en una ubicación que elijas después de registrar una dosis."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داروهای شما و تاریخ دوز را خودکار ذخیره می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallentaa lääkkeesi ja annoshistoriasi automaattisesti valitsemaasi sijaintiin annoksen kirjaamisen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde automatiquement vos médicaments et l’historique des prises à l’emplacement de votre choix après l’enregistrement d’une prise."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde automatiquement vos médicaments et l’historique des doses à l’emplacement de votre choix après la consignation d’une dose."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שומר תרופות וטפסי דוז באופן אוטומטי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक खुराक लॉग करने के बाद आपकी दवाओं और खुराक के इतिहास को एक ऐसे स्थान पर स्वचालित रूप से सहेजता है जो आप चुनते हैं।"
