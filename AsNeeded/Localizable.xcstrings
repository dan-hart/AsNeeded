        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مخزن بيانات بسيط لحفظ الأدوية والأحداث بشكل دائم"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאגר נתונים פשוט לשמירה מתמשכת של תרופות ואירועים"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ذخیره‌گاه سادهٔ داده برای نگهداری پایدار داروها و رویدادها"
