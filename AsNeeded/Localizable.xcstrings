    "You don't have any medications added to AsNeeded yet. Open the app to add your first medication.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تضف أي أدوية إلى AsNeeded بعد. افتح التطبيق لإضافة أدويتك الأولى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no tens cap medicament afegit a AsNeeded. Obre l'aplicació per afegir el teu primer medicament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do AsNeeded zatím nemáš přidané žádné léky. Otevři aplikaci a přidej svůj první lék."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har endnu ikke tilføjet nogen medicin til AsNeeded. Åbn appen for at tilføje din første medicin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast noch keine Medikamente zu AsNeeded hinzugefügt. Öffne die App, um dein erstes Medikament hinzuzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχεις προσθέσει ακόμη φάρμακα στο AsNeeded. Άνοιξε την εφαρμογή για να προσθέσεις το πρώτο σου φάρμακο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have any medications added to AsNeeded yet. Open the app to add your first medication."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have any medications added to AsNeeded yet. Open the app to add your first medication."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have any medicines added to AsNeeded yet. Open the app to add your first medicine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no tienes ningún medicamento añadido en AsNeeded. Abre la app para añadir tu primer medicamento."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has agregado ningún medicamento a AsNeeded. Abre la app para añadir tu primer medicamento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز هیچ دارویی به AsNeeded اضافه نکرده‌اید. برنامه را باز کنید تا اولین داروی خود را اضافه کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinulla ei ole vielä lääkkeitä lisättynä AsNeedediin. Avaa sovellus lisätäksesi ensimmäisen lääkkeesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n'as encore ajouté aucun médicament à AsNeeded. Ouvre l'app pour ajouter ton premier médicament."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n'as pas encore ajouté de médicaments à AsNeeded. Ouvre l’app pour ajouter ton premier médicament."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין לך עדיין תרופות שנוספו ל‑AsNeeded. פתח את האפליקציה כדי להוסיף את התרופה הראשונה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded में अभी आपके पास कोई दवा नहीं जोड़ी गई है। अपनी पहली दवा जोड़ने के लिए ऐप खोलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs AsNeededhez hozzáadott gyógyszered. Nyisd meg az alkalmazást, és add hozzá az első gyógyszeredet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu belum menambahkan obat apa pun ke AsNeeded. Buka aplikasi untuk menambahkan obat pertamamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora aggiunto farmaci in AsNeeded. Apri l'app per aggiungere il tuo primo farmaco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeededにはまだ薬が登録されていません。アプリを開いて最初の薬を追加してください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сенде AsNeeded-ке әлі ешқандай дәрі қосылмаған. Бағдарламаны ашып бірінші дәріні қос."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded에 약물이 아직 추가되어 있지 않습니다. 앱을 열어 첫 약물을 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
