    "Unable to locate your medication data. Please try again or contact support if the problem persists.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden localizar los datos de tus medicamentos. Vuelve a intentarlo o contacta con el servicio de asistencia si el problema persiste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Medikamentendaten konnten nicht gefunden werden. Versuche es erneut oder kontaktiere den Support, falls das Problem weiterhin besteht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de localiser les données de vos médicaments. Réessayez ou contactez l’assistance si le problème persiste."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر العثور على بيانات أدويتك. يرجى المحاولة مجددًا أو الاتصال بالدعم إذا استمرت المشكلة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לאתר את נתוני התרופות שלך. יש לנסות שוב או לפנות לתמיכה אם הבעיה נמשכת."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌های دارویی شما پیدا نشد. دوباره تلاش کنید یا اگر مشکل ادامه داشت، با پشتیبانی تماس بگیرید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "薬のデータが見つかりません。もう一度お試しいただくか、問題が解決しない場合はサポートにお問い合わせください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Данните за лекарствата ви не могат да бъдат намерени. Опитайте отново или се свържете с поддръжката, ако проблемът продължава."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No es poden localitzar les dades dels teus medicaments. Torna-ho a provar o contacta amb el servei d’assistència si el problema persisteix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše údaje o lécích nelze najít. Zkuste to znovu, a pokud problém přetrvává, kontaktujte podporu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke finde dine medicindata. Prøv igen, eller kontakt support, hvis problemet fortsætter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι δυνατός ο εντοπισμός των δεδομένων των φαρμάκων σας. Δοκιμάστε ξανά ή επικοινωνήστε με την υποστήριξη αν το πρόβλημα επιμένει."
          }
        },
        "en": {
          "stringUnit": {
