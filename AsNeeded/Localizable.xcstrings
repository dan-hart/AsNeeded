    "Show refill guidance this many days before your saved refill date or estimated run-out date.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar indicaciones de reposición con esta cantidad de días de antelación respecto a la fecha de reposición guardada o la fecha estimada en que se agotará el medicamento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige Hinweise zum Auffüllen so viele Tage vor deinem gespeicherten Nachfülldatum oder dem geschätzten Datum an, an dem dein Vorrat aufgebraucht ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les indications de renouvellement ce nombre de jours avant la date de renouvellement enregistrée ou la date estimée d’épuisement du stock."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار إرشادات إعادة الصرف قبل تاريخ إعادة الصرف المحفوظ أو تاريخ النفاد المقدّر بهذا العدد من الأيام."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצגת הנחיות לחידוש מלאי התרופה מספר ימים זה לפני תאריך החידוש השמור או התאריך המשוער שבו יאזל המלאי."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "راهنمای تهیهٔ مجدد دارو را این تعداد روز پیش از تاریخ ذخیره‌شدهٔ تهیهٔ مجدد یا تاریخ تخمینی تمام‌شدن دارو نمایش دهید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの補充日または薬がなくなる予測日の何日前から、補充のガイダンスを表示するかを設定します。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Показване на насоки за попълване на запаса толкова дни преди запазената дата за попълване или прогнозната дата на изчерпване."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra les orientacions de reposició aquest nombre de dies abans de la data de reposició desada o de la data estimada en què s'esgotarà el medicament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit pokyny k doplnění zásob tento počet dní před uloženým datem doplnění nebo odhadovaným datem vyčerpání zásob."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis vejledning om genopfyldning så mange dage før din gemte genopfyldningsdato eller den anslåede dato, hvor medicinen slipper op."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση οδηγιών αναπλήρωσης τόσες ημέρες πριν από την αποθηκευμένη ημερομηνία αναπλήρωσης ή την εκτιμώμενη ημερομηνία εξάντλησης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show refill guidance this many days before your saved refill date or estimated run-out date."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Show refill guidance this many days before your saved refill date or estimated run-out date."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Show refill guidance this many days before your saved refill date or estimated run-out date."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar indicaciones de reposición con esta cantidad de días de anticipación a la fecha de reposición guardada o a la fecha estimada en que se agotará el medicamento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä täydennysohjeet näin monta päivää ennen tallennettua täydennyspäivää tai arvioitua lääkkeen loppumispäivää."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les indications de renouvellement ce nombre de jours avant la date de renouvellement enregistrée ou la date estimée d’épuisement du médicament."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोबारा दवा लेने का मार्गदर्शन आपकी सहेजी गई रीफ़िल तारीख या दवा खत्म होने की अनुमानित तारीख से इतने दिन पहले दिखाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaži smjernice za obnovu zalihe ovoliko dana prije spremljenog datuma obnove zalihe ili procijenjenog datuma potrošnje zalihe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennyi nappal a mentett utánpótlási dátum vagy a készlet várható kifogyása előtt jelenjen meg az utánpótlásra vonatkozó útmutatás."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan panduan isi ulang sejumlah hari ini sebelum tanggal isi ulang yang disimpan atau perkiraan tanggal persediaan habis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra le indicazioni per il rifornimento con questo numero di giorni di anticipo rispetto alla data di rifornimento salvata o alla data stimata di esaurimento."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сақталған қор толықтыру күнінен немесе дәрінің болжамды таусылу күнінен осынша күн бұрын қорды толықтыру нұсқауын көрсету."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 약 보충 날짜 또는 예상 소진일로부터 설정한 일수만큼 앞서 약 보충 안내를 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan panduan isi semula sebilangan hari ini sebelum tarikh isi semula tersimpan atau tarikh anggaran ubat habis."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis veiledning om påfylling så mange dager før den lagrede påfyllingsdatoen eller den anslåtte datoen for når beholdningen tar slutt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon aanwijzingen voor het aanvullen dit aantal dagen vóór je opgeslagen aanvuldatum of de geschatte datum waarop je voorraad op is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuj wskazówki dotyczące uzupełnienia zapasu na tyle dni przed zapisaną datą uzupełnienia lub szacowaną datą wyczerpania zapasu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar orientações de reposição com esta quantidade de dias de antecedência em relação à data de reposição salva ou à data estimada de término do estoque."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar orientações de reposição com este número de dias de antecedência em relação à data de reposição guardada ou à data estimada em que o medicamento se esgotará."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează indicațiile pentru reaprovizionare cu acest număr de zile înainte de data salvată pentru reaprovizionare sau de data estimată a epuizării stocului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать подсказку о пополнении запаса за указанное число дней до сохранённой даты пополнения или предполагаемой даты исчерпания запаса."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobraziť pokyny na doplnenie zásoby tento počet dní pred uloženým dátumom doplnenia alebo odhadovaným dátumom minutia zásoby."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa vägledning om påfyllning så här många dagar före ditt sparade påfyllningsdatum eller det beräknade datum då läkemedlet tar slut."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงคำแนะนำการรับยาเพิ่มล่วงหน้าตามจำนวนวันนี้ ก่อนวันที่รับยาเพิ่มที่บันทึกไว้หรือวันที่คาดว่ายาจะหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stok yenileme yönergelerini, kaydedilen stok yenileme tarihinizden veya tahmini tükenme tarihinden bu kadar gün önce göster."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати вказівки щодо поповнення запасу за стільки днів до збереженої дати поповнення або очікуваної дати вичерпання запасу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị hướng dẫn bổ sung thuốc trước ngày bổ sung đã lưu hoặc ngày dự kiến hết thuốc theo số ngày này."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在你儲存的補藥日期或預計用完日期前，提前此天數顯示補藥指引。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在已保存的补药日期或预计用完日期前，提前这些天数显示补药提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在已儲存的補藥日期或預估用完日期前的指定天數，顯示補藥指引。"
          }
        }
      }
    },
    "Showing complete days through yesterday. Today’s doses appear after the day is complete.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestran los días completos hasta ayer. Las dosis de hoy aparecen cuando termina el día."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden abgeschlossene Tage bis einschließlich gestern angezeigt. Die heutigen Dosen erscheinen nach Tagesende."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichage des journées complètes jusqu’à hier. Les prises d’aujourd’hui apparaîtront une fois la journée terminée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعرض الأيام المكتملة حتى يوم أمس. تظهر جرعات اليوم بعد انتهاء اليوم."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוצגים ימים שהושלמו עד אתמול. המנות של היום יופיעו לאחר סיום היום."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روزهای کامل تا دیروز نمایش داده می‌شوند. نوبت‌های مصرف امروز پس از پایان روز نمایش داده می‌شوند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昨日までの終了した日を表示しています。今日の服用は、今日が終了した後に表示されます。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Показани са завършените дни до вчера включително. Днешните дози ще се покажат след края на деня."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es mostren els dies complets fins ahir. Les dosis d'avui apareixeran quan s'acabi el dia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazují se celé dny až do včerejška. Dnešní dávky se zobrazí po skončení dne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser hele dage til og med i går. Dagens doser vises, når dagen er slut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζονται οι ολοκληρωμένες ημέρες έως και χθες. Οι σημερινές δόσεις εμφανίζονται μετά την ολοκλήρωση της ημέρας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing complete days through yesterday. Today’s doses appear after the day is complete."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing complete days through yesterday. Today’s doses appear after the day is complete."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing complete days through yesterday. Today’s doses appear after the day is complete."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestran días completos hasta ayer. Las dosis de hoy aparecerán cuando termine el día."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytetään kokonaiset päivät eiliseen asti. Tämän päivän annokset näkyvät päivän päätyttyä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les journées complètes jusqu’à hier sont affichées. Les doses d’aujourd’hui apparaîtront une fois la journée terminée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कल तक के पूरे दिनों का डेटा दिखाया जा रहा है। आज की खुराकें दिन पूरा होने के बाद दिखाई देंगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuju se dovršeni dani zaključno s jučerašnjim. Današnje doze pojavit će se nakon završetka dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljes napok adatai láthatók tegnapig. A mai adagok a nap lezárulta után jelennek meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan hari yang sudah selesai hingga kemarin. Dosis hari ini akan muncul setelah hari ini berakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono mostrati i giorni completi fino a ieri. Le dosi di oggi appariranno al termine della giornata."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кешегі күнге дейінгі толық күндер көрсетілген. Бүгінгі дозалар күн аяқталғаннан кейін көрінеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어제까지 하루가 완료된 날짜의 데이터를 표시합니다. 오늘의 복용 기록은 오늘이 끝난 후 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memaparkan hari yang telah lengkap hingga semalam. Dos hari ini akan dipaparkan selepas hari berakhir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser hele dager til og med i går. Dagens doser vises når dagen er over."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volledige dagen tot en met gisteren worden getoond. De doses van vandaag verschijnen zodra de dag voorbij is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetlane są pełne dni do wczoraj włącznie. Dzisiejsze dawki pojawią się po zakończeniu dnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibindo dias completos até ontem. As doses de hoje aparecem após o fim do dia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A mostrar dias completos até ontem. As doses de hoje aparecem quando o dia terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt afișate zilele complete până ieri inclusiv. Dozele de astăzi apar după încheierea zilei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показаны завершённые дни по вчерашний день включительно. Сегодняшние приёмы появятся после завершения дня."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazujú sa celé dni až do včerajška. Dnešné dávky sa zobrazia po skončení dňa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar hela dagar till och med igår. Dagens doser visas när dagen är slut."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงข้อมูลของวันที่สิ้นสุดแล้วจนถึงเมื่อวาน การใช้ยาของวันนี้จะปรากฏหลังจากสิ้นสุดวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dün de dahil olmak üzere tamamlanmış günler gösteriliyor. Bugünkü dozlar, gün tamamlandıktan sonra görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показано повні дні включно з учорашнім. Сьогоднішні дози з’являться після завершення дня."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang hiển thị các ngày đã kết thúc, tính đến hết hôm qua. Các liều hôm nay sẽ xuất hiện sau khi ngày kết thúc."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示截至昨天的完整日資料。今天的用藥記錄會在今天結束後顯示。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示截至昨天的完整日期数据。今天的用药将在今天结束后显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示截至昨天的完整日期資料。今天的用藥紀錄會在當天結束後顯示。"
          }
        }
      }
    },
