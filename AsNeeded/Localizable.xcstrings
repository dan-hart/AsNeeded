    "Recent dose quantities or units do not match. Review your dose history.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cantidades o unidades de las dosis recientes no coinciden. Revisa tu historial de dosis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mengen oder Einheiten der letzten Dosen stimmen nicht überein. Prüfe deinen Dosisverlauf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les quantités ou les unités des doses récentes ne correspondent pas. Vérifiez votre historique des prises."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كميات الجرعات الأخيرة أو وحداتها غير متطابقة. راجع سجل جرعاتك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכמויות או יחידות המידה של המנות האחרונות אינן תואמות. יש לעיין בהיסטוריית המנות שלך."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مقادیر یا واحدهای دوزهای اخیر با هم مطابقت ندارند. تاریخچهٔ دوز خود را بررسی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の投与量または単位が一致していません。投与履歴を確認してください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
