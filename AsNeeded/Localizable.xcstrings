    "Add dose timing or refill guardrails in medication settings if you want more guidance.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade límites de tiempo entre dosis o de reposición en los ajustes del medicamento si quieres más orientación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie in den Medikamenteneinstellungen Dosisabstände oder Grenzen für das Nachfüllen fest, wenn Sie mehr Orientierung wünschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des limites relatives à l’intervalle entre les doses ou aux renouvellements dans les réglages du médicament si vous souhaitez davantage de repères."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف ضوابط لتوقيت الجرعات أو إعادة الصرف في إعدادات الدواء إذا أردت مزيدًا من الإرشاد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לקבלת הכוונה נוספת, אפשר להוסיף בהגדרות התרופה מגבלות על תזמון מנות או חידוש מלאי."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر راهنمایی بیشتری می‌خواهید، در تنظیمات دارو، زمان‌بندی دوز یا محدودیت‌های تهیهٔ مجدد را اضافه کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さらに目安が必要な場合は、薬の設定で服薬間隔や補充に関する制限を追加してください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавете ограничения за интервалите между дозите или за попълването на запаса в настройките на лекарството, ако искате повече насоки."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix límits d’interval entre dosis o de reposició a la configuració del medicament si vols més orientació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud chcete více vodítek, přidejte v nastavení léku časové rozestupy dávek nebo upozornění na doplnění zásob."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj grænser for dosisintervaller eller genopfyldning i medicinindstillingerne, hvis du ønsker mere vejledning."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε χρονικά όρια δόσεων ή όρια αναπλήρωσης στις ρυθμίσεις του φαρμάκου αν θέλετε περισσότερη καθοδήγηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add dose timing or refill guardrails in medication settings if you want more guidance."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Add dose timing or refill guardrails in medication settings if you want more guidance."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Add dose timing or refill guardrails in medication settings if you want more guidance."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega límites para los intervalos entre dosis o las reposiciones en la configuración del medicamento si quieres más orientación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää lääkkeen asetuksissa annosten ajoitusta tai lääkevaraston täydennystä koskevia rajoja, jos haluat lisää ohjausta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des balises pour l’intervalle entre les doses ou les renouvellements dans les réglages du médicament si vous souhaitez davantage de repères."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिक मार्गदर्शन के लिए दवा की सेटिंग में खुराक के समय या दवा दोबारा भरवाने संबंधी सीमाएँ जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za dodatne smjernice u postavkama lijeka dodaj ograničenja razmaka između doza ili nadopune zaliha."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha további útmutatást szeretne, állítson be az adagolás időzítésére vagy a készletfeltöltésre vonatkozó korlátokat a gyógyszer beállításaiban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan batas waktu pemberian dosis atau batas pengaman isi ulang di pengaturan obat jika Anda menginginkan panduan lebih lanjut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desideri maggiori indicazioni, aggiungi nelle impostazioni del farmaco limiti per gli intervalli tra le dosi o per il rifornimento."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қосымша нұсқау қажет болса, дәрі параметрлерінде дозалар арасындағы уақытқа немесе қорды толықтыруға қатысты шектеулер қосыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 많은 안내를 원하면 약물 설정에서 복용 시간이나 보충 관련 제한 기준을 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah tetapan masa dos atau had bekalan semula dalam tetapan ubat jika anda mahukan lebih banyak panduan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til dosetidspunkter eller påfyllingsgrenser i legemiddelinnstillingene hvis du ønsker mer veiledning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg in de medicijninstellingen dosisintervallen of grenzen voor het aanvullen toe als je meer begeleiding wilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli chcesz uzyskać więcej wskazówek, dodaj w ustawieniach leku odstępy między dawkami lub ograniczenia dotyczące uzupełniania zapasu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione limites de intervalo entre doses ou de reposição nas configurações do medicamento se quiser mais orientação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione limites de intervalo entre doses ou de reposição nas definições do medicamento se pretender mais orientação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă limite privind intervalul dintre doze sau reaprovizionarea în setările medicamentului dacă dorești mai multă îndrumare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для дополнительных ориентиров добавьте в настройках лекарства ограничения по времени приёма или пополнению запаса."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete viac usmernení, v nastaveniach lieku pridajte časové odstupy medzi dávkami alebo pravidlá dopĺňania zásob."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till dosintervall eller gränser för påfyllning i läkemedelsinställningarna om du vill ha mer vägledning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มช่วงเวลาการใช้ยาหรือเกณฑ์เตือนการเติมยาในการตั้งค่ายา หากต้องการคำแนะนำเพิ่มเติม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha fazla yönlendirme isterseniz ilaç ayarlarında doz zamanlaması veya yeniden temin için koruyucu sınırlar ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте обмеження щодо часу між дозами або поповнення запасу в налаштуваннях препарату, якщо хочете отримувати додаткові підказки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm thời gian dùng thuốc hoặc ngưỡng cảnh báo bổ sung thuốc trong cài đặt thuốc nếu bạn muốn được hướng dẫn thêm."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如需更多指引，可在藥物設定中加入用藥時間或補充藥物的限制設定。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如需更多指引，可在药物设置中添加用药时间或药物补充限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如需更多指引，可在藥物設定中新增用藥時間或補藥限制設定。"
          }
        }
      }
    },
