    "Last recorded dose and saved timing or supply.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Última dosis registrada y datos guardados de horarios o existencias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt erfasste Dosis und gespeicherte Zeitangaben oder Vorratsdaten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière dose enregistrée et horaires ou stock sauvegardés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "آخر جرعة مسجلة والتوقيت أو المخزون المحفوظ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המנה האחרונה שנרשמה והתזמון או המלאי שנשמרו."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آخرین دوز ثبت‌شده و زمان‌بندی یا موجودی ذخیره‌شده."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の服薬記録と、保存済みの服薬タイミングまたは残量。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Последна записана доза и запазени данни за времето на прием или запаса."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Última dosi registrada i horaris o existències desats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslední zaznamenaná dávka a uložené časové údaje nebo zásoba."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Senest registrerede dosis og gemte tidsoplysninger eller beholdning."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τελευταία καταγεγραμμένη δόση και αποθηκευμένα στοιχεία χρονισμού ή αποθέματος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last recorded dose and saved timing or supply."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Last recorded dose and saved timing or supply."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Last recorded dose and saved timing or supply."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Última dosis registrada y datos guardados de horarios o suministro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeksi kirjattu annos ja tallennettu ajoitus tai lääkevaranto."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière dose enregistrée et horaires ou réserves sauvegardés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आखिरी दर्ज खुराक और सहेजा गया समय या उपलब्ध मात्रा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posljednja zabilježena doza i spremljeni podaci o vremenu uzimanja ili zalihi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legutóbb rögzített adag és a mentett időzítés vagy készlet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosis terakhir yang dicatat serta pengaturan waktu atau persediaan yang disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultima dose registrata e intervalli o scorte salvati."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы тіркелген доза және сақталған уақыт не қор туралы мәлімет."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로 기록한 복용 내역과 저장된 시간 또는 잔여량."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos terakhir yang direkodkan serta masa atau bekalan yang disimpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sist registrerte dose og lagret tidsinformasjon eller beholdning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laatst geregistreerde dosis en opgeslagen tijdsinstellingen of voorraad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnia zarejestrowana dawka oraz zapisane informacje o czasie lub zapasie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Última dose registrada e horários ou estoque salvos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Última dose registada e horário ou reserva guardados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultima doză înregistrată și intervalele sau stocul salvate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последняя записанная доза и сохранённые данные о времени приёма или запасе."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Posledná zaznamenaná dávka a uložené časové údaje alebo zásoby."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Senast registrerade dos och sparade tidsuppgifter eller förråd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การใช้ยาครั้งล่าสุดที่บันทึกไว้ และเวลาหรือปริมาณยาคงเหลือที่บันทึกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son kaydedilen doz ve kayıtlı zamanlama veya stok bilgileri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Остання записана доза та збережені часові параметри або запас."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liều được ghi nhận gần nhất và thời gian dùng hoặc lượng thuốc dự trữ đã lưu."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一次用藥記錄，以及已儲存的用藥時間或存量。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一次用药记录，以及已保存的时间或余量信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一次用藥記錄，以及已儲存的用藥時間或存量。"
          }
        }
      }
    },
    "Last refill must be today or earlier.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última reposición debe ser de hoy o de una fecha anterior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzte Nachfüllung muss heute oder früher erfolgt sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dernier renouvellement doit dater d’aujourd’hui ou d’une date antérieure."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون تاريخ آخر إعادة تعبئة اليوم أو قبله."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תאריך חידוש המלאי האחרון חייב להיות היום או קודם לכן."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ آخرین تأمین مجدد باید امروز یا پیش از آن باشد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の補充日は今日以前の日付にしてください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Последното попълване на запаса трябва да е с днешна или по-ранна дата."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La data de l’última reposició ha de ser avui o una data anterior."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum posledního doplnění zásoby musí být dnešní nebo dřívější."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Seneste genopfyldning skal være i dag eller tidligere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η τελευταία αναπλήρωση πρέπει να είναι σήμερα ή νωρίτερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last refill must be today or earlier."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Last refill must be today or earlier."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Last refill must be today or earlier."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha de la última reposición debe ser hoy o una fecha anterior."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeisimmän täydennyksen on oltava tänään tai aiemmin."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La date du dernier renouvellement doit être aujourd’hui ou avant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आखिरी रीफ़िल की तारीख आज की या उससे पहले की होनी चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posljednja nadopuna zalihe mora biti danas ili ranije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utolsó készletfeltöltés dátuma csak mai vagy korábbi lehet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal pengisian ulang terakhir harus hari ini atau sebelumnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
