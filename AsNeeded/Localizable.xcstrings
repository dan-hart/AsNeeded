        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दवा का इतिहास, उपलब्ध मात्रा और सहेजी गई समयावधियाँ एक नज़र में।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povijest uzimanja lijeka, zalihe i spremljeni vremenski rasponi na prvi pogled."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyógyszerszedési előzmények, készlet és mentett időablakok egy pillantással."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekilas riwayat obat, persediaan, dan rentang waktu yang tersimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronologia dei farmaci, scorte e finestre temporali salvate a colpo d'occhio."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дәрінің тарихы, қоры және сақталған уақыт аралықтары бір қарағанда."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복약 이력, 남은 약, 저장된 복용 가능 시간대를 한눈에 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejarah ubat, bekalan dan tempoh yang disimpan sepintas lalu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legemiddelhistorikk, beholdning og lagrede tidsvinduer i et overblikk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicijngeschiedenis, voorraad en opgeslagen tijdvensters in één oogopslag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia leku, zapas i zapisane przedziały czasowe w skrócie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Histórico de medicamentos, estoque e janelas de horário salvas em um só lugar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Histórico de medicação, reserva e intervalos guardados num relance."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Istoricul medicamentului, stocul și intervalele salvate, dintr-o privire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История приёма, запас и сохранённые окна приёма — всё под рукой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "História užívania lieku, zásoby a uložené časové okná na jednom mieste."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läkemedelshistorik, förråd och sparade tidsfönster i en överblick."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูประวัติการใช้ยา ปริมาณยาคงเหลือ และช่วงเวลาที่บันทึกไว้ได้อย่างรวดเร็ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bakışta ilaç geçmişi, stok ve kayıtlı zaman aralıkları."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історія прийому, запас і збережені часові проміжки — одним поглядом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem nhanh lịch sử dùng thuốc, lượng thuốc dự trữ và các khung thời gian đã lưu."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "藥物記錄、存量及已儲存時段一目了然。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一览用药历史、余量和已保存的用药时间段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一覽用藥紀錄、存量與已儲存的用藥時段。"
          }
        }
      }
    },
