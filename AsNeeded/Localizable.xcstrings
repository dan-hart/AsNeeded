        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminnelsesinnstillingene dine kunne ikke oppdateres. Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je herinneringsinstellingen konden niet worden bijgewerkt. Probeer het opnieuw."
