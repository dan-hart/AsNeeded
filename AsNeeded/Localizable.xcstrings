    "Switch between 14, 30, and 90 complete days to explore your recorded doses.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna entre 14, 30 y 90 días completos para explorar las dosis registradas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle zwischen 14, 30 und 90 abgeschlossenen Tagen, um deine erfassten Dosen zu erkunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez d’une période de 14, 30 ou 90 jours complets à une autre pour explorer vos prises enregistrées."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدّل بين 14 و30 و90 يومًا كاملاً لاستعراض جرعاتك المسجلة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לעבור בין 14, 30 ו-90 ימים שהושלמו כדי לבחון את המנות שנרשמו."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای بررسی نوبت‌های مصرف ثبت‌شدهٔ خود، بین بازه‌های ۱۴، ۳۰ و ۹۰ روز کامل جابه‌جا شوید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了した14日間、30日間、90日間を切り替えて、記録した服用を確認できます。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Превключвайте между 14, 30 и 90 завършени дни, за да разгледате записаните си дози."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna entre 14, 30 i 90 dies complets per explorar les dosis registrades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepínejte mezi 14, 30 a 90 celými dny a prozkoumejte zaznamenané dávky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift mellem 14, 30 og 90 hele dage for at udforske dine registrerede doser."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε μεταξύ 14, 30 και 90 πλήρων ημερών για να εξερευνήσετε τις καταγεγραμμένες δόσεις σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch between 14, 30, and 90 complete days to explore your recorded doses."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch between 14, 30, and 90 complete days to explore your recorded doses."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch between 14, 30, and 90 complete days to explore your recorded doses."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna entre 14, 30 y 90 días completos para explorar tus dosis registradas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkastele kirjattuja annoksia vaihtamalla 14, 30 ja 90 kokonaisen päivän jaksojen välillä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez entre des périodes de 14, 30 et 90 jours complets pour explorer vos doses enregistrées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी दर्ज खुराकों को जानने के लिए 14, 30 और 90 पूरे दिनों के बीच बदलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prebacujte se između 14, 30 i 90 dovršenih dana kako biste istražili zabilježene doze."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válts 14, 30 vagy 90 teljes nap között a naplózott adagok áttekintéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beralih antara rentang 14, 30, dan 90 hari yang sudah selesai untuk menelusuri dosis yang Anda catat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa tra 14, 30 e 90 giorni completi per esplorare le dosi registrate."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тіркелген дозаларыңызды зерттеу үшін 14, 30 және 90 толық күндік кезеңдер арасында ауысыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료된 날짜 기준으로 14일, 30일, 90일 사이를 전환하며 복용 기록을 살펴보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Beralih antara 14, 30 dan 90 hari penuh untuk meneroka dos yang telah anda rekodkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt mellom 14, 30 og 90 hele dager for å utforske de registrerte dosene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel tussen 14, 30 en 90 volledige dagen om je geregistreerde doses te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełączaj między okresami 14, 30 i 90 pełnych dni, aby przeglądać zapisane dawki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterne entre 14, 30 e 90 dias completos para explorar suas doses registradas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterne entre 14, 30 e 90 dias completos para explorar as suas doses registadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comută între 14, 30 și 90 de zile complete pentru a explora dozele înregistrate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключайтесь между периодами в 14, 30 и 90 завершённых дней, чтобы изучить записанные приёмы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepínajte medzi obdobiami 14, 30 a 90 celých dní a preskúmajte zaznamenané dávky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Växla mellan 14, 30 och 90 hela dagar för att utforska dina registrerade doser."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สลับระหว่างช่วง 14, 30 และ 90 วันเต็มเพื่อดูการใช้ยาที่คุณบันทึกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettiğiniz dozları incelemek için tamamlanmış 14, 30 ve 90 günlük dönemler arasında geçiş yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемикайтеся між 14, 30 і 90 повними днями, щоб дослідити записані дози."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển giữa các khoảng 14, 30 và 90 ngày trọn vẹn để xem các liều đã ghi lại."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "切換查看 14、30 或 90 個完整日的資料，了解你記錄的用藥情況。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换查看14、30或90个完整日期，了解您记录的用药情况。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換查看 14、30 或 90 個完整日期的資料，探索您的用藥紀錄。"
          }
        }
      }
    },
