        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח את AsNeeded ב־iPhone הסמוך שלך ולאחר מכן לרענן."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded را در iPhone نزدیک خود باز کنید، سپس تازه‌سازی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くのiPhoneでAsNeededを開いてから、更新してください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворете AsNeeded на своя iPhone наблизо, след което обновете."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre AsNeeded a l’iPhone que tens a prop i després actualitza."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete AsNeeded na svém iPhonu v blízkosti a poté obnovte zobrazení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn AsNeeded på din iPhone i nærheden, og opdatér derefter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε το AsNeeded στο κοντινό σας iPhone και μετά κάντε ανανέωση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open AsNeeded on your nearby iPhone, then refresh."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Open AsNeeded on your nearby iPhone, then refresh."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Open AsNeeded on your nearby iPhone, then refresh."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
