    "Your feedback helps make As Needed better for everyone. Choose the type of feedback you'd like to send:": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملاحظاتك تساعد في جعل As Needed أفضل للجميع. اختر نوع الملاحظات التي تريد إرسالها:"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els teus comentaris ajuden a millorar As Needed per a tothom. Tria el tipus de comentari que vols enviar:"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvá zpětná vazba pomáhá zlepšit As Needed pro všechny. Vyber typ zpětné vazby, kterou chceš odeslat:"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din feedback hjælper med at gøre As Needed bedre for alle. Vælg hvilken type feedback du vil sende:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Feedback hilft, As Needed für alle besser zu machen. Wähle die Art des Feedbacks, die du senden möchtest:"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα σχόλιά σου βοηθούν το As Needed να βελτιωθεί για όλους. Επίλεξε τον τύπο σχολίου που θέλεις να στείλεις:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your feedback helps make As Needed better for everyone. Choose the type of feedback you'd like to send:"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your feedback helps make As Needed better for everyone. Choose the type of feedback you'd like to send:"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your feedback helps make As Needed better for everyone. Choose the type of feedback you'd like to send:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus comentarios ayudan a mejorar As Needed para todos. Elige el tipo de comentario que quieres enviar:"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus comentarios ayudan a que As Needed mejore para todos. Elige el tipo de comentario que quieres enviar:"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازخورد شما به بهتر شدن As Needed برای همه کمک می‌کند. نوع بازخوردی را که می‌خواهید ارسال کنید انتخاب کنید:"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palautteesi auttaa tekemään As Neededistä paremman kaikille. Valitse, millaista palautetta haluat lähettää:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes retours aident à améliorer As Needed pour tout le monde. Choisis le type de retour que tu souhaites envoyer :"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes commentaires aident à améliorer As Needed pour tout le monde. Choisis le type de rétroaction que tu souhaites envoyer :"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשוב שלך עוזר לשפר את As Needed עבור כולם. בחר/י את סוג המשוב שברצונך לשלוח:"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी प्रतिक्रिया As Needed को और बेहतर बनाने में मदद करती है। भेजने के लिए प्रतिक्रिया का प्रकार चुनें:"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A visszajelzésed segít, hogy az As Needed jobb legyen mindenki számára. Válaszd ki, milyen típusú visszajelzést szeretnél küldeni:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukanmu membantu membuat As Needed lebih baik untuk semua orang. Pilih jenis masukan yang ingin kamu kirim:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo feedback aiuta a rendere As Needed migliore per tutti. Scegli il tipo di feedback che vuoi inviare:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "皆さんのためにAs Neededをより良くするために、ご意見をお寄せください。送信するフィードバックの種類を選んでください："
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сенің пікірің As Needed-ті баршаға жақсырақ етеді. Жібергің келетін пікір түрін таңда:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러분의 피드백은 As Needed을 모두에게 더 나은 앱으로 만드는 데 도움이 됩니다. 보내실 피드백 유형을 선택하세요:"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Maklum balas anda membantu menjadikan As Needed lebih baik untuk semua. Pilih jenis maklum balas yang ingin anda hantar:"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbakemeldingen din hjelper med å gjøre As Needed bedre for alle. Velg hvilken type tilbakemelding du vil sende:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je feedback helpt As Needed voor iedereen te verbeteren. Kies het type feedback dat je wilt versturen:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja opinia pomaga uczynić As Needed lepszym dla wszystkich. Wybierz rodzaj opinii, którą chcesz wysłać:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu feedback ajuda a melhorar o As Needed para todos. Escolha o tipo de feedback que você quer enviar:"
          }
        },
        "pt-PT": {
