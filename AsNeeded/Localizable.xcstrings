        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 백업이 복원 전에 활성화되었지만 백업 위치 설정이 장치별이므로 재구성이 필요합니다.\n\n보호를 재개하려면 자동 백업을 재구성하세요."
          }
        },
        "ms": {
