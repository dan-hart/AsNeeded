    "%@ must be a positive, finite number.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ debe ser un número positivo y finito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muss eine positive, endliche Zahl sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doit être un nombre fini strictement positif."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تكون قيمة %@ عددًا موجبًا ومحدودًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ חייב להיות מספר חיובי וסופי."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ باید عددی مثبت و متناهی باشد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@には、正の有限数を入力してください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ трябва да е положително крайно число."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha de ser un nombre positiu i finit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodnota %@ musí být kladné konečné číslo."
