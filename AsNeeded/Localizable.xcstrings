        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקשה להתאמה אישית של המנה, לחיצה ממושכת לרישום מנה בברירת המחדל"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खुराक बदलने के लिए टैप करें, डिफ़ॉल्ट खुराक दर्ज करने के लिए दबाकर रखें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
