    "No dose limits saved. Add dose timing or a 24-hour quantity limit in medication settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay límites de dosis guardados. Añade un intervalo entre dosis o un límite de cantidad en 24 horas en los ajustes del medicamento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Dosisgrenzen gespeichert. Füge in den Medikamenteneinstellungen Zeitvorgaben für Dosen oder eine Höchstmenge für 24 Stunden hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune limite de prise enregistrée. Ajoutez un intervalle entre les doses ou une quantité limite sur 24 heures dans les paramètres du médicament."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد حدود محفوظة للجرعات. أضف توقيت الجرعات أو حدًا للكمية خلال 24 ساعة في إعدادات الدواء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נשמרו מגבלות מינון. ניתן להוסיף תזמון מנות או מגבלת כמות ל־24 שעות בהגדרות התרופה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ محدودیتی برای دوز ذخیره نشده است. زمان‌بندی دوز یا محدودیت مقدار مصرف در ۲۴ ساعت را در تنظیمات دارو اضافه کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投与制限が保存されていません。薬の設定で投与のタイミングまたは24時間あたりの量の上限を追加してください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма запазени ограничения за дозите. Добавете интервал между дозите или ограничение на количеството за 24 часа в настройките на лекарството."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hi ha límits de dosi desats. Afegeix un interval entre dosis o un límit de quantitat en 24 hores a la configuració del medicament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejsou uloženy žádné limity dávek. V nastavení léku přidejte časový odstup mezi dávkami nebo limit množství za 24 hodin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen dosisgrænser gemt. Tilføj tidsinterval mellem doser eller en mængdegrænse for 24 timer i medicinindstillingerne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχουν αποθηκευτεί όρια δόσεων. Προσθέστε χρονισμό δόσεων ή όριο ποσότητας ανά 24ωρο στις ρυθμίσεις του φαρμάκου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No dose limits saved. Add dose timing or a 24-hour quantity limit in medication settings."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "No dose limits saved. Add dose timing or a 24-hour quantity limit in medication settings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "No dose limits saved. Add dose timing or a 24-hour quantity limit in medication settings."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay límites de dosis guardados. Agrega un intervalo entre dosis o un límite de cantidad en 24 horas en la configuración del medicamento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Annosrajoja ei ole tallennettu. Lisää lääkkeen asetuksissa annostuksen ajoitus tai 24 tunnin määräraj a."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune limite de dose sauvegardée. Ajoutez un intervalle entre les doses ou une limite de quantité sur 24 heures dans les réglages du médicament."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खुराक की कोई सीमा सहेजी नहीं गई है। दवा की सेटिंग्स में खुराक का समय या 24 घंटे में मात्रा की सीमा जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema spremljenih ograničenja doziranja. U postavkama lijeka dodajte vremenski razmak između doza ili ograničenje količine u 24 sata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincsenek mentett adagolási korlátok. Adjon meg adagolási időzítést vagy 24 órás mennyiségi korlátot a gyógyszer beállításaiban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada batas dosis yang tersimpan. Tambahkan pengaturan waktu dosis atau batas jumlah dalam 24 jam di pengaturan obat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun limite di dosaggio salvato. Aggiungi gli intervalli tra le dosi o un limite di quantità nelle 24 ore nelle impostazioni del farmaco."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доза шектеулері сақталмаған. Дәрі баптауларында дозаны қабылдау уақытын немесе 24 сағаттағы мөлшер шегін қосыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 복용 제한이 없습니다. 약 설정에서 복용 시간 간격이나 24시간 최대 복용량을 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada had dos disimpan. Tambahkan masa dos atau had kuantiti 24 jam dalam tetapan ubat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen dosegrenser er lagret. Legg til et doseintervall eller en mengdegrense for 24 timer i legemiddelinnstillingene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen doseringslimieten opgeslagen. Voeg in de medicijninstellingen een tijdsinterval tussen doses of een hoeveelheidslimiet per 24 uur toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zapisano limitów dawkowania. Dodaj odstępy między dawkami lub limit ilości w ciągu 24 godzin w ustawieniach leku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum limite de dose salvo. Adicione um intervalo entre doses ou um limite de quantidade em 24 horas nas configurações do medicamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem limites de dose guardados. Adicione um intervalo entre doses ou um limite de quantidade em 24 horas nas definições do medicamento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu sunt salvate limite de dozare. Adaugă un interval între doze sau o limită de cantitate pentru 24 de ore în setările medicamentului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничения приёма не сохранены. Добавьте интервал между приёмами или ограничение количества за 24 часа в настройках лекарства."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie sú uložené žiadne limity dávok. V nastaveniach lieku pridajte časový odstup medzi dávkami alebo limit množstva za 24 hodín."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga dosgränser har sparats. Lägg till ett dosintervall eller en mängdgräns för 24 timmar i läkemedelsinställningarna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้บันทึกขีดจำกัดการใช้ยา เพิ่มระยะเวลาระหว่างการใช้ยาหรือขีดจำกัดปริมาณใน 24 ชั่วโมงได้ในการตั้งค่ายา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı doz sınırı yok. İlaç ayarlarından doz zamanlaması veya 24 saatlik miktar sınırı ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обмеження дозування не збережено. Додайте інтервал між прийомами або обмеження кількості за 24 години в налаштуваннях ліків."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa lưu giới hạn liều dùng. Thêm thời gian dùng liều hoặc giới hạn lượng trong 24 giờ ở phần cài đặt thuốc."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未儲存用藥限制。請在藥物設定中加入用藥時間限制或 24 小時用量上限。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未保存用药限制。请在药物设置中添加用药时间限制或 24 小时用量上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未儲存用藥限制。請在藥物設定中新增用藥時間或 24 小時內的用量上限。"
          }
        }
      }
    },
