    "healthkit.migration.warning.skip": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحذير: سيؤدي تخطي الترحيل إلى البدء بحالة نظيفة. لن يتم نقل البيانات الحالية."
          }
        },
        "bg": {
          "stringUnit": {
