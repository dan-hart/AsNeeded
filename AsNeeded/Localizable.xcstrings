    "Reset all preferences on this screen to their original default values.": {
      "comment": "A description of what happens when the \"Reset to Defaults\" button in the \"Reset\" section of the app preferences view is tapped.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
