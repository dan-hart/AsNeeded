    "Please enable notifications in Settings to set medication reminders.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى تفعيل الإشعارات في الإعدادات لتعيين تذكيرات الأدوية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa les notificacions a Configuració per establir recordatoris de medicació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte oznámení v Nastavení, abyste mohli nastavit připomenutí léků."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivér venligst notifikationer i Indstillinger for at oprette medicinpåmindelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte aktiviere Mitteilungen in den Einstellungen, um Medikamentenerinnerungen festzulegen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποίησε τις ειδοποιήσεις στις Ρυθμίσεις για να ορίσεις υπενθυμίσεις φαρμάκων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enable notifications in Settings to set medication reminders."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enable notifications in Settings to set medication reminders."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enable notifications in Settings to set medicine reminders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las notificaciones en Ajustes para poder establecer recordatorios de medicación."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las notificaciones en Configuración para poder establecer recordatorios de medicamentos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای تعیین یادآوری دارو لطفاً اعلان‌ها را در تنظیمات فعال کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota ilmoitukset käyttöön Asetuksissa, jotta voit asettaa lääkemuistutuksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez activer les notifications dans Réglages pour définir des rappels de médicaments."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Active les notifications dans Réglages pour définir des rappels de médicaments."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנא אפשר התראות בהגדרות כדי להגדיר תזכורות לתרופות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दवा रिमाइंडर सेट करने के लिए कृपया सेटिंग्स में सूचनाएँ सक्षम करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be az értesítéseket a Beállításokban, hogy gyógyszeremlékeztetőket állíthass be."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Silakan aktifkan notifikasi di Pengaturan untuk mengatur pengingat obat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilita le notifiche nelle Impostazioni per impostare i promemoria dei farmaci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "薬のリマインダーを設定するには、設定で通知を有効にしてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дәрі еске салғыштарын орнату үшін баптауларда хабарламаларды қосыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약물 알림을 설정하려면 설정에서 알림을 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila aktifkan pemberitahuan dalam Tetapan untuk menetapkan peringatan ubat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiver varsler i Innstillinger for å sette medisinpåminnelser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel meldingen in bij Instellingen om medicijnherinneringen in te stellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz powiadomienia w Ustawieniach, aby ustawić przypomnienia o lekach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, ative as notificações em Ajustes para definir lembretes de medicação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, ativa as notificações em Definições para definir lembretes de medicação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activați notificările din Setări pentru a seta mementouri pentru medicamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включи уведомления в «Настройках», чтобы установить напоминания о приёме лекарств."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera aviseringar i Inställningar för att ställa in medicinspåminnelser."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรุณาเปิดการแจ้งเตือนในการตั้งค่าเพื่อกำหนดการเตือนยา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlaç hatırlatmaları ayarlamak için Ayarlar'da bildirimleri açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng bật thông báo trong Cài đặt để đặt lời nhắc thuốc."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中啟用通知，以設定藥物提醒。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中启用通知以设置用药提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中啟用通知以設定用藥提醒。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Моля, включете известията в Настройки, за да зададете напомняния за лекарства."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućite obavijesti u Postavkama da biste postavili podsjetnike za lijekove."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete nastaviť pripomienky liekov, povoľte hlásenia v Nastaveniach."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть сповіщення в налаштуваннях, щоб налаштувати нагадування про ліки."
          }
        }
      }
    },
    "Please specify which medication you'd like information about.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرجى تحديد الدواء الذي تريد معلومات عنه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Especifica de quin medicament vols informació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upřesněte prosím, o kterém léku chcete získat informace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv venligst hvilken medicin du gerne vil have information om."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte geben Sie an, über welches Medikament Sie Informationen möchten."
          }
        },
        "el": {
