        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De seneste dosismængder eller enheder stemmer ikke overens. Gennemgå din dosishistorik."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ποσότητες ή οι μονάδες των πρόσφατων δόσεων δεν ταιριάζουν. Ελέγξτε το ιστορικό δόσεών σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent dose quantities or units do not match. Review your dose history."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent dose quantities or units do not match. Review your dose history."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent dose quantities or units do not match. Review your dose history."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
