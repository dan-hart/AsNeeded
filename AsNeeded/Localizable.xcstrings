    "Notifications are off. Open Settings to turn on next-dose alerts.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Abre Ajustes para activar las alertas de próxima dosis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind deaktiviert. Öffne die Einstellungen, um Hinweise zur nächsten Dosis zu aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Ouvrez les réglages pour activer les alertes de prochaine dose."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات متوقفة. افتح الإعدادات لتفعيل تنبيهات الجرعة التالية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתראות כבויות. יש לפתוח את ההגדרות כדי להפעיל התראות למנה הבאה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعلان‌ها خاموش هستند. برای روشن کردن هشدارهای دوز بعدی، تنظیمات را باز کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がオフになっています。設定を開いて、次の投与の通知をオンにしてください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Известията са изключени. Отворете Настройки, за да включите известията за следваща доза."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notificacions estan desactivades. Obre Configuració per activar els avisos de la propera dosi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení jsou vypnutá. Otevřete Nastavení a zapněte upozornění na další dávku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer er slået fra. Åbn Indstillinger for at slå beskeder om næste dosis til."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι γνωστοποιήσεις είναι απενεργοποιημένες. Ανοίξτε τις Ρυθμίσεις για να ενεργοποιήσετε τις ειδοποιήσεις επόμενης δόσης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off. Open Settings to turn on next-dose alerts."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off. Open Settings to turn on next-dose alerts."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off. Open Settings to turn on next-dose alerts."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Abre Configuración para activar las alertas de la próxima dosis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitukset ovat pois päältä. Ota seuraavan annoksen ilmoitukset käyttöön avaamalla Asetukset."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Ouvrez Réglages pour activer les alertes de prochaine dose."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाएँ बंद हैं। अगली खुराक के अलर्ट चालू करने के लिए सेटिंग्स खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti su isključene. Otvorite Postavke da biste uključili upozorenja za sljedeću dozu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítések ki vannak kapcsolva. A következő adag értesítéseinek bekapcsolásához nyissa meg a Beállításokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan dinonaktifkan. Buka Pengaturan untuk mengaktifkan peringatan dosis berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate. Apri Impostazioni per attivare gli avvisi per la prossima dose."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хабарландырулар өшірулі. Келесі доза туралы ескертулерді қосу үшін Баптауларды ашыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 꺼져 있습니다. 설정을 열어 다음 복용 알림을 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan dimatikan. Buka Tetapan untuk menghidupkan amaran dos seterusnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varslinger er av. Åpne Innstillinger for å slå på varsler om neste dose."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen staan uit. Open Instellingen om meldingen voor de volgende dosis in te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są wyłączone. Otwórz Ustawienia, aby włączyć powiadomienia o następnej dawce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. Abra os Ajustes para ativar os alertas da próxima dose."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. Abra as Definições para ativar os alertas da próxima dose."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificările sunt dezactivate. Deschide Setări pentru a activa alertele pentru următoarea doză."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления отключены. Откройте «Настройки», чтобы включить уведомления о следующем приёме."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlásenia sú vypnuté. Otvorte Nastavenia a zapnite upozornenia na ďalšiu dávku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiser är avstängda. Öppna Inställningar för att slå på aviseringar om nästa dos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดการแจ้งเตือนอยู่ เปิดการตั้งค่าเพื่อเปิดการแจ้งเตือนการใช้ยาครั้งถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler kapalı. Sonraki doz uyarılarını açmak için Ayarları açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення вимкнено. Відкрийте налаштування, щоб увімкнути сповіщення про наступну дозу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo đang tắt. Mở Cài đặt để bật thông báo liều tiếp theo."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已關閉。請開啟「設定」以啟用下次用藥提示。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已关闭。请打开“设置”以开启下次用药提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已關閉。請開啟「設定」以啟用下次用藥通知。"
          }
        }
      }
    },
    "Notifications are on. Add a dose limit and log a dose to start receiving alerts.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están activadas. Añade un límite de dosis y registra una dosis para empezar a recibir alertas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind aktiviert. Füge eine Dosisgrenze hinzu und erfasse eine Dosis, um Hinweise zu erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont activées. Ajoutez une limite de prise et enregistrez une dose pour commencer à recevoir des alertes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات مفعّلة. أضف حدًا للجرعات وسجّل جرعة لبدء تلقي التنبيهات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתראות מופעלות. יש להוסיף מגבלת מינון ולרשום מנה כדי להתחיל לקבל התראות."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعلان‌ها روشن هستند. برای شروع دریافت هشدارها، یک محدودیت دوز اضافه کنید و یک دوز ثبت کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がオンになっています。投与制限を追加して投与を記録すると、通知を受け取れるようになります。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Известията са включени. Добавете ограничение за дозите и регистрирайте доза, за да започнете да получавате известия."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notificacions estan activades. Afegeix un límit de dosi i registra una dosi per començar a rebre avisos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení jsou zapnutá. Přidejte limit dávkování a zaznamenejte dávku, abyste začali dostávat upozornění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer er slået til. Tilføj en dosisgrænse, og registrér en dosis for at begynde at modtage beskeder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι γνωστοποιήσεις είναι ενεργοποιημένες. Προσθέστε ένα όριο δόσεων και καταγράψτε μια δόση για να αρχίσετε να λαμβάνετε ειδοποιήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are on. Add a dose limit and log a dose to start receiving alerts."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are on. Add a dose limit and log a dose to start receiving alerts."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are on. Add a dose limit and log a dose to start receiving alerts."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están activadas. Agrega un límite de dosis y registra una dosis para empezar a recibir alertas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitukset ovat päällä. Lisää annosraja ja kirjaa annos, jotta alat saada ilmoituksia."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont activées. Ajoutez une limite de dose et enregistrez une dose pour commencer à recevoir des alertes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाएँ चालू हैं। अलर्ट पाना शुरू करने के लिए खुराक की सीमा जोड़ें और एक खुराक दर्ज करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti su uključene. Dodajte ograničenje doze i zabilježite dozu da biste počeli primati upozorenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítések be vannak kapcsolva. Adjon meg egy adagolási korlátot, és naplózzon egy adagot az értesítések fogadásának megkezdéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan diaktifkan. Tambahkan batas dosis dan catat dosis untuk mulai menerima peringatan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono attive. Aggiungi un limite di dosaggio e registra una dose per iniziare a ricevere avvisi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хабарландырулар қосулы. Ескертулерді ала бастау үшін доза шектеуін қосып, дозаны тіркеңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 켜져 있습니다. 복용 제한을 추가하고 복용을 기록하면 알림을 받기 시작합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan dihidupkan. Tambahkan had dos dan rekodkan dos untuk mula menerima amaran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varslinger er på. Legg til en dosegrense og registrer en dose for å begynne å motta varsler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen staan aan. Voeg een doseringslimiet toe en registreer een dosis om meldingen te ontvangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są włączone. Dodaj limit dawkowania i zapisz dawkę, aby zacząć otrzymywać powiadomienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão ativadas. Adicione um limite de dose e registre uma dose para começar a receber alertas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão ativadas. Adicione um limite de dose e registe uma dose para começar a receber alertas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificările sunt activate. Adaugă o limită de dozare și înregistrează o doză pentru a începe să primești alerte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления включены. Добавьте ограничение приёма и запишите приём, чтобы начать получать уведомления."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlásenia sú zapnuté. Pridajte limit dávok a zaznamenajte dávku, aby ste začali dostávať upozornenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiser är på. Lägg till en dosgräns och logga en dos för att börja få aviseringar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดการแจ้งเตือนอยู่ เพิ่มขีดจำกัดการใช้ยาและบันทึกการใช้ยาเพื่อเริ่มรับการแจ้งเตือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler açık. Uyarı almaya başlamak için bir doz sınırı ekleyin ve bir doz kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення ввімкнено. Додайте обмеження дозування та запишіть прийом, щоб почати отримувати сповіщення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo đang bật. Thêm giới hạn liều dùng và ghi nhận một liều để bắt đầu nhận thông báo."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已開啟。加入用藥限制並記錄一次用藥，即可開始接收提示。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已开启。添加用药限制并记录一次用药后，即可开始接收提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已開啟。新增用藥限制並記錄一次用藥，即可開始接收通知。"
          }
        }
      }
    },
