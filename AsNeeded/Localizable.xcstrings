        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह तय करता है कि ऐप की सेटिंग वाला डेटा आयात करने पर क्या होता है। आप आयात के दौरान हमेशा अपना चयन बदल सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez szabályozza, hogy mi történjen, amikor alkalmazásbeállításokat tartalmazó adatokat importálsz. Importálás közben bármikor módosíthatod a választásodat."
          }
