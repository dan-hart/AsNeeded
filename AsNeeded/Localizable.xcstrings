        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per personalizzare la dose, tieni premuto per registrare la dose predefinita"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозаны өзгерту үшін түртіңіз, әдепкі дозаны тіркеу үшін басып тұрыңыз"
