    "Update or clear the past next-refill date in Supply & Refills.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza o borra la fecha de la próxima reposición que ya ha pasado en Existencias y reposiciones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere oder lösche unter „Vorrat & Nachfüllen“ das vergangene Datum für das nächste Nachfüllen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez ou effacez la date de prochain réapprovisionnement passée dans Stock et réapprovisionnements."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّث تاريخ إعادة الصرف التالية الذي مضى أو امسحه في «المخزون وإعادة الصرف»."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לעדכן או לנקות את תאריך חידוש המלאי הבא שכבר חלף, תחת ״מלאי וחידושים״."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ گذشتهٔ تهیهٔ مجدد بعدی را در «موجودی و تهیهٔ مجدد» به‌روزرسانی یا پاک کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「残量と補充」で、過去の日付になっている次回補充日を更新またはクリアしてください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Актуализирайте или изчистете отминалата дата за следващо зареждане в „Наличност и зареждания“."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualitza o esborra la data de la pròxima reposició que ja ha passat a Existències i reposicions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V části Zásoby a doplňování aktualizujte nebo vymažte datum příštího doplnění, které již uplynulo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdater eller fjern den overskredne dato for næste genopfyldning under Beholdning og genopfyldning."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενημερώστε ή διαγράψτε την ημερομηνία επόμενης ανανέωσης αποθέματος που έχει παρέλθει, στην ενότητα Απόθεμα και ανανεώσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update or clear the past next-refill date in Supply & Refills."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Update or clear the past next-refill date in Supply & Refills."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Update or clear the past next-refill date in Supply & Refills."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza o borra la fecha vencida de la próxima reposición en Existencias y reposiciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivitä tai poista menneisyyteen jäänyt seuraavan täydennyksen päivämäärä kohdassa Lääkevarasto ja täydennykset."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour ou effacez la date de prochain renouvellement déjà passée dans Réserves et renouvellements."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दवा की उपलब्ध मात्रा और रीफ़िल में अगली बार दवा भरवाने की बीत चुकी तारीख अपडेट करें या हटाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ažurirajte ili uklonite prošli datum sljedeće obnove zaliha u odjeljku Zalihe i obnove."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Frissítsd vagy töröld a következő utánpótlás már elmúlt dátumát a Készlet és utánpótlás részen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbarui atau hapus tanggal isi ulang berikutnya yang sudah lewat di Persediaan & Isi Ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna o cancella la data del prossimo rifornimento ormai trascorsa in Scorta e rifornimenti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Қор және толықтыру» бөлімінде келесі толықтырудың өтіп кеткен күнін жаңартыңыз немесе өшіріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수량 및 약 보충에서 이미 지난 다음 약 보충 날짜를 변경하거나 지우세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemas kini atau kosongkan tarikh isi semula seterusnya yang telah berlalu dalam Bekalan & Isi Semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdater eller fjern datoen for neste påfyll som har passert, under Beholdning og påfyll."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werk de verstreken datum voor de volgende aanvulling bij of wis deze in Voorraad en aanvullingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaktualizuj lub wyczyść minioną datę następnego uzupełnienia zapasu w sekcji Zapas i uzupełnienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize ou apague a data de próxima reposição que já passou em Estoque e reposições."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize ou apague a data de próxima reposição que já passou em Quantidade e reposições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizează sau șterge data următoarei reaprovizionări care a trecut, în Stoc și reaprovizionări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновите или удалите прошедшую дату следующего пополнения в разделе «Запас и пополнения»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V časti Zásoba a dopĺňanie aktualizujte alebo vymažte dátum nasledujúceho doplnenia, ktorý už uplynul."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdatera eller rensa det passerade datumet för nästa påfyllning i Förråd och påfyllningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตหรือล้างวันที่เติมยาครั้งถัดไปที่ผ่านไปแล้วในยาคงเหลือและการเติมยา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stok ve Yenilemeler bölümünde geçmişte kalan bir sonraki stok yenileme tarihini güncelleyin veya temizleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновіть або очистьте минулу дату наступного поповнення в розділі «Запас і поповнення»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật hoặc xóa ngày bổ sung thuốc tiếp theo đã qua trong Lượng thuốc và bổ sung."
          }
