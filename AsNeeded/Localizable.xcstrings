        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si As Needed vous est utile, envisagez de soutenir son développement"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان As Needed مفيدًا لك، ففكّر في دعم تطويره"
