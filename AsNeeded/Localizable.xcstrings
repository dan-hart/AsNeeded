    "Scan recovery sources to check for orphaned data from older storage locations.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Examina las fuentes de recuperación para buscar datos huérfanos en ubicaciones de almacenamiento antiguas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuche Wiederherstellungsquellen nach verwaisten Daten an älteren Speicherorten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysez les sources de récupération pour rechercher des données orphelines dans d’anciens emplacements de stockage."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افحص مصادر الاسترداد للتحقق من وجود بيانات يتيمة في مواقع التخزين القديمة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סריקת מקורות שחזור כדי לבדוק אם נותרו נתונים יתומים במיקומי אחסון ישנים."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "منابع بازیابی را برای یافتن داده‌های بی‌ارتباط باقی‌مانده در محل‌های ذخیره‌سازی قدیمی پویش کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧元をスキャンして、以前の保存場所に取り残されたデータがないか確認します。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирайте източниците за възстановяване, за да проверите за данни без връзка с текущото хранилище в по-стари местоположения за съхранение."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora les fonts de recuperació per cercar dades òrfenes en ubicacions d'emmagatzematge antigues."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prohledat zdroje pro obnovení a vyhledat osiřelá data ve starších umístěních úložiště."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan gendannelseskilder for at finde data uden tilknytning fra ældre lagringsplaceringer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σαρώστε τις πηγές ανάκτησης για να ελέγξετε αν υπάρχουν ορφανά δεδομένα σε παλαιότερες τοποθεσίες αποθήκευσης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan recovery sources to check for orphaned data from older storage locations."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan recovery sources to check for orphaned data from older storage locations."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan recovery sources to check for orphaned data from older storage locations."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza las fuentes de recuperación para buscar datos huérfanos en ubicaciones de almacenamiento anteriores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Etsi palautuslähteistä vanhoihin tallennuspaikkoihin jääneitä irrallisia tietoja."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyser les sources de récupération pour rechercher des données orphelines dans d’anciens emplacements de stockage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुराने संग्रहण स्थानों में छूटे हुए डेटा की जाँच करने के लिए डेटा पुनर्प्राप्ति के स्रोत स्कैन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretražite izvore za oporavak kako biste provjerili postoje li nepovezani podaci na starijim lokacijama pohrane."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vizsgáld át a helyreállítási forrásokat a korábbi tárolási helyeken maradt, leválasztott adatok felkutatásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindai sumber pemulihan untuk memeriksa data tanpa rujukan dari lokasi penyimpanan lama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona le fonti di recupero per cercare dati orfani nelle vecchie posizioni di archiviazione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұрынғы сақтау орындарында иесіз қалған деректердің бар-жоғын тексеру үшін қалпына келтіру дереккөздерін сканерлеңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 소스를 검색하여 이전 저장 위치에 남겨진 데이터가 있는지 확인합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imbas sumber pemulihan untuk menyemak data tanpa pautan daripada lokasi storan lama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Undersøk gjenopprettingskilder for å se etter data uten tilknytning fra eldre lagringsplasseringer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan herstelbronnen om te zoeken naar niet-gekoppelde gegevens uit oudere opslaglocaties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeszukaj źródła odzyskiwania, aby sprawdzić, czy w starszych lokalizacjach przechowywania pozostały osierocone dane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique as fontes de recuperação para procurar dados órfãos em locais de armazenamento antigos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisar fontes de recuperação para procurar dados órfãos em localizações de armazenamento antigas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanează sursele de recuperare pentru a căuta date rămase fără asociere în locații de stocare mai vechi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте источники восстановления, чтобы найти потерянные данные в прежних местах хранения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prehľadajte zdroje obnovy a skontrolujte, či v starších umiestneniach úložiska nezostali osirelé údaje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sök igenom återställningskällor för att hitta data utan koppling från äldre lagringsplatser."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนแหล่งข้อมูลสำหรับกู้คืนเพื่อตรวจหาข้อมูลที่ตกค้างจากตำแหน่งจัดเก็บเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski depolama konumlarında sahipsiz kalmış verileri kontrol etmek için kurtarma kaynaklarını tarayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скануйте джерела відновлення, щоб перевірити наявність даних, що втратили зв’язок із застосунком, у попередніх місцях зберігання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét các nguồn khôi phục để tìm dữ liệu bị bỏ sót tại các vị trí lưu trữ cũ."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描復原來源，檢查舊儲存位置中有否遺留的資料。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描恢复来源，检查旧存储位置是否存在遗留数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描復原來源，檢查舊儲存位置中是否有遺留的孤立資料。"
          }
        }
      }
    },
