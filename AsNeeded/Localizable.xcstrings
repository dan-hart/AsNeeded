          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeaikaisten annosten määrät tai yksiköt eivät täsmää. Tarkista annoshistoriasi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les quantités ou les unités des doses récentes ne correspondent pas. Vérifiez votre historique des doses."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाल की खुराकों की मात्राएँ या इकाइयाँ मेल नहीं खाती हैं। अपने खुराक इतिहास की समीक्षा करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Količine ili jedinice nedavnih doza ne podudaraju se. Pregledajte povijest doza."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legutóbbi adagok mennyisége vagy mértékegysége eltér. Tekintse át az adagolási előzményeket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah atau satuan dosis terbaru tidak cocok. Tinjau riwayat dosis Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quantità o le unità delle dosi recenti non corrispondono. Controlla la cronologia delle dosi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы дозалардың мөлшерлері немесе өлшем бірліктері сәйкес келмейді. Доза тарихын қарап шығыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 복용량이나 단위가 일치하지 않습니다. 복용 이력을 검토하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuantiti atau unit dos terkini tidak sepadan. Semak sejarah dos anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengder eller enheter for nylige doser samsvarer ikke. Se gjennom dosehistorikken din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Recente dosishoeveelheden of eenheden komen niet overeen. Controleer je dosisgeschiedenis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilości lub jednostki ostatnich dawek nie są zgodne. Sprawdź historię dawek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As quantidades ou unidades das doses recentes não correspondem. Revise seu histórico de doses."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As quantidades ou unidades das doses recentes não correspondem. Reveja o seu histórico de doses."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cantitățile sau unitățile dozelor recente nu corespund. Verifică istoricul dozelor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Количество или единицы измерения в недавних записях о приёме не совпадают. Проверьте историю приёма."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Množstvá alebo jednotky nedávnych dávok sa nezhodujú. Skontrolujte históriu dávok."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De senaste dosernas mängder eller enheter stämmer inte överens. Granska din doshistorik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปริมาณหรือหน่วยของการใช้ยาครั้งล่าสุดไม่ตรงกัน โปรดตรวจสอบประวัติการใช้ยาของคุณ"
          }
