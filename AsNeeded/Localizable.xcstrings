        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट सहेजने की प्रक्रिया पूरी नहीं हो सकी। कुछ बदलाव सहेजे गए हो सकते हैं। दोबारा प्रयास करने से पहले इतिहास की समीक्षा करें।"
