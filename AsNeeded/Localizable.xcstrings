    "Backup settings changed or a backup is in progress. Please try selecting the location again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes de copia de seguridad han cambiado o hay una copia en curso. Intenta seleccionar la ubicación de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherungseinstellungen wurden geändert oder eine Sicherung läuft gerade. Bitte versuche erneut, den Speicherort auszuwählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages de sauvegarde ont changé ou une sauvegarde est en cours. Veuillez réessayer de sélectionner l’emplacement."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت إعدادات النسخ الاحتياطي أو توجد عملية نسخ احتياطي قيد التنفيذ. يُرجى محاولة اختيار الموقع مجددًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרות הגיבוי השתנו או שמתבצע גיבוי. יש לנסות לבחור שוב את המיקום."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظیمات پشتیبان‌گیری تغییر کرده است یا پشتیبان‌گیری در حال انجام است. لطفاً دوباره محل ذخیره را انتخاب کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップ設定が変更されたか、バックアップが進行中です。保存先をもう一度選択してください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройките за архивиране са променени или в момента се създава резервно копие. Опитайте да изберете местоположението отново."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuració de les còpies de seguretat ha canviat o hi ha una còpia en curs. Torna a seleccionar la ubicació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavení zálohování se změnilo nebo právě probíhá zálohování. Zkuste umístění vybrat znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstillingerne for sikkerhedskopiering er ændret, eller en sikkerhedskopiering er i gang. Prøv at vælge placeringen igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ρυθμίσεις αντιγράφων ασφαλείας άλλαξαν ή βρίσκεται σε εξέλιξη η δημιουργία αντιγράφου ασφαλείας. Δοκιμάστε να επιλέξετε ξανά την τοποθεσία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup settings changed or a backup is in progress. Please try selecting the location again."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup settings changed or a backup is in progress. Please try selecting the location again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup settings changed or a backup is in progress. Please try selecting the location again."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración de las copias de seguridad cambió o hay una copia en curso. Intenta seleccionar la ubicación de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmuuskopioinnin asetukset ovat muuttuneet tai varmuuskopiointi on käynnissä. Yritä valita sijainti uudelleen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages de sauvegarde ont changé ou une sauvegarde est en cours. Veuillez sélectionner l’emplacement de nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकअप सेटिंग्स बदल गई हैं या बैकअप चल रहा है। कृपया स्थान फिर से चुनने का प्रयास करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavke sigurnosnog kopiranja su promijenjene ili je izrada sigurnosne kopije u tijeku. Pokušaj ponovno odabrati lokaciju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A biztonsági mentés beállításai megváltoztak, vagy biztonsági mentés van folyamatban. Próbálja meg újra kiválasztani a helyet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan pencadangan berubah atau pencadangan sedang berlangsung. Silakan coba pilih lokasi lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni di backup sono cambiate oppure è in corso un backup. Prova a selezionare di nuovo la posizione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сақтық көшірме параметрлері өзгерді немесе сақтық көшірме жасалып жатыр. Орынды қайта таңдап көріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업 설정이 변경되었거나 백업이 진행 중입니다. 위치를 다시 선택해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapan sandaran telah berubah atau sandaran sedang dijalankan. Sila cuba pilih lokasi sekali lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innstillingene for sikkerhetskopiering er endret, eller en sikkerhetskopiering pågår. Prøv å velge plasseringen på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De reservekopie-instellingen zijn gewijzigd of er wordt een reservekopie gemaakt. Probeer de locatie opnieuw te selecteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia kopii zapasowych zostały zmienione lub trwa tworzenie kopii. Spróbuj ponownie wybrać lokalizację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações de cópia de segurança foram alteradas ou uma cópia está em andamento. Tente selecionar o local novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As definições da cópia de segurança foram alteradas ou está em curso uma cópia de segurança. Tente selecionar a localização novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setările copierii de siguranță s-au schimbat sau o copie de siguranță este în curs de creare. Încearcă să selectezi din nou locația."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки резервного копирования изменились или сейчас создаётся резервная копия. Попробуйте выбрать место хранения ещё раз."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavenia zálohovania sa zmenili alebo prebieha zálohovanie. Skúste umiestnenie vybrať znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inställningarna för säkerhetskopiering har ändrats eller så pågår en säkerhetskopiering. Försök välja platsen igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่าการสำรองข้อมูลมีการเปลี่ยนแปลง หรือกำลังสำรองข้อมูลอยู่ โปรดลองเลือกตำแหน่งอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekleme ayarları değişti veya bir yedekleme işlemi sürüyor. Lütfen konumu tekrar seçmeyi deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування резервного копіювання змінилися або триває резервне копіювання. Спробуйте вибрати місце ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt sao lưu đã thay đổi hoặc quá trình sao lưu đang diễn ra. Vui lòng thử chọn lại vị trí."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "備份設定已變更，或正在進行備份。請重新選擇位置。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份设置已更改，或备份正在进行中。请尝试重新选择位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份設定已變更，或備份正在進行中。請再次嘗試選擇位置。"
          }
        }
      }
    },
