    "Share your experience and help others discover the app": {
      "comment": "A description of how to rate and review the app on the App Store.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شارك تجربتك وساعد الآخرين على اكتشاف التطبيق"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparteix la teva experiència i ajuda altres persones a descobrir l'app"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podělte se o své zkušenosti a pomozte ostatním objevit aplikaci"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del din erfaring og hjælp andre med at opdage appen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen Sie Ihre Erfahrung und helfen Sie anderen, die App zu entdecken"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μοιραστείτε την εμπειρία σας και βοηθήστε άλλους να ανακαλύψουν την εφαρμογή"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Share your experience and help others discover the app"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Share your experience and help others discover the app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte tu experiencia y ayuda a otros a descubrir la aplicación"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte tu experiencia y ayuda a otros a descubrir la aplicación"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تجربهٔ خود را به اشتراک بگذارید و به دیگران در پیدا کردن برنامه کمک کنید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaa kokemuksesi ja auta muita löytämään sovellus"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez votre expérience et aidez d’autres personnes à découvrir l’app"
