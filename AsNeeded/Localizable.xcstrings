          "stringUnit": {
            "state": "translated",
            "value": "Se o As Needed é útil para você, considere apoiar o desenvolvimento"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o As Needed lhe é útil, considere apoiar o desenvolvimento"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă As Needed îți este de ajutor, ia în considerare susținerea dezvoltării"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если As Needed помогает вам, поддержите разработку"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak vám As Needed pomáha, zvážte podporu vývoja"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om As Needed hjälper dig kan du överväga att stödja utvecklingen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หาก As Needed มีประโยชน์สำหรับคุณ โปรดพิจารณาสนับสนุนการพัฒนา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed işinize yarıyorsa geliştirilmesini desteklemeyi düşünebilirsiniz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо As Needed вам допомагає, підтримайте розробку"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu As Needed hữu ích, hãy cân nhắc ủng hộ việc phát triển ứng dụng"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 As Needed 對你有幫助，歡迎考慮支持開發工作"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 As Needed 对您有帮助，欢迎考虑支持开发"
          }
