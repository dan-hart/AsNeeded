          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако As Needed ви е полезно, обмислете подкрепа за разработката"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si As Needed et resulta útil, considera donar suport al desenvolupament"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
