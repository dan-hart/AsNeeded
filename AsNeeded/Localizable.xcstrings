        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar as definições dos seus lembretes. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setările mementourilor nu au putut fi actualizate. Încearcă din nou."
