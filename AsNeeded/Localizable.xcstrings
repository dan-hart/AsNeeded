    "Show a caution message while a dose is still close to the last one.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar un mensaje de precaución cuando aún haya pasado poco tiempo desde la última dosis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Warnhinweis anzeigen, solange eine Dosis zeitlich noch nahe an der letzten liegt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher un message de prudence lorsqu’une prise est encore rapprochée de la précédente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار رسالة تنبيه عندما لا يزال الفاصل الزمني بين الجرعة والجرعة السابقة قصيرًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצגת הודעת זהירות כאשר המנה עדיין סמוכה בזמן למנה הקודמת."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی فاصلهٔ نوبت مصرف با نوبت قبلی هنوز کم است، پیام احتیاط نمایش داده شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の服用からまだ時間があまり経っていない場合に、注意メッセージを表示します。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Показване на предупреждение, когато дозата е твърде близо по време до предходната."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un missatge de precaució quan una dosi encara és propera a l'anterior."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit upozornění, pokud je časový odstup dávky od předchozí stále krátký."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis en advarsel, mens en dosis stadig ligger tæt på den foregående."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση προειδοποιητικού μηνύματος όταν μια δόση εξακολουθεί να απέχει λίγο χρονικά από την προηγούμενη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a caution message while a dose is still close to the last one."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a caution message while a dose is still close to the last one."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a caution message while a dose is still close to the last one."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar un mensaje de precaución mientras una dosis aún esté muy próxima a la anterior."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä varoitus, kun annos on vielä ajallisesti lähellä edellistä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher un message de mise en garde lorsque la prise d’une dose est encore rapprochée de la précédente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब पिछली खुराक के बाद अभी कम समय बीता हो, तो सावधानी का संदेश दिखाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaži poruku opreza dok je vremenski razmak od prethodne doze još kratak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Figyelmeztető üzenet megjelenítése, ha az adag időben még közel van az előzőhöz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan pesan peringatan jika waktu dosis masih berdekatan dengan dosis terakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un messaggio di cautela quando una dose è ancora ravvicinata rispetto all’ultima."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы дозадан бері аз уақыт өтсе, сақтық хабарын көрсету."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 복용 후 시간이 얼마 지나지 않았을 때 주의 메시지를 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan mesej peringatan apabila jarak masa antara dos dengan dos terakhir masih dekat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis en advarsel når det fortsatt er kort tid siden forrige dose."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon een waarschuwing wanneer er nog weinig tijd is verstreken sinds de vorige dosis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuj ostrzeżenie, gdy odstęp od poprzedniej dawki jest nadal krótki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
