            "value": "Ingen oppføringer ble funnet i de undersøkte historiske kildene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen gegevens gevonden in de gescande historische bronnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono wpisów w przeszukanych źródłach historycznych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum registro foi encontrado nas fontes históricas examinadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foram encontrados registos nas fontes históricas analisadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-au găsit înregistrări în sursele istorice scanate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В проверенных исторических источниках записи не найдены."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V prehľadaných historických zdrojoch sa nenašli žiadne záznamy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga poster hittades i de historiska källor som genomsöktes."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบบันทึกในแหล่งข้อมูลย้อนหลังที่สแกน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taranan geçmiş kaynaklarında kayıt bulunamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У перевірених джерелах історичних даних записів не знайдено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy bản ghi nào trong các nguồn dữ liệu lịch sử đã quét."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在已掃描的歷史資料來源中找不到任何記錄。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在扫描的历史数据来源中未找到记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在已掃描的歷史資料來源中找不到任何紀錄。"
          }
        }
      }
    },
    "No refill alerts based on your saved quantities, dates, and logged doses. Check any medications you aren’t tracking in AsNeeded.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay alertas de reposición según las cantidades, fechas y dosis registradas que tienes guardadas. Revisa los medicamentos que no estés siguiendo en AsNeeded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basierend auf deinen gespeicherten Mengen, Datumsangaben und erfassten Dosen gibt es keine Nachfüllhinweise. Prüfe alle Medikamente, die du nicht in AsNeeded erfasst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune alerte de renouvellement d’après vos quantités, dates et doses enregistrées. Vérifiez les médicaments que vous ne suivez pas dans AsNeeded."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد تنبيهات لإعادة التعبئة بناءً على الكميات والتواريخ المحفوظة والجرعات المسجلة. تحقّق من أي أدوية لا تتتبعها في AsNeeded."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין התראות לחידוש מלאי על סמך הכמויות והתאריכים שנשמרו והמנות שנרשמו. יש לבדוק גם תרופות שאינן במעקב שלך ב־AsNeeded."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بر اساس مقادیر و تاریخ‌های ذخیره‌شده و دوزهای ثبت‌شدهٔ شما، هشداری برای تهیهٔ مجدد وجود ندارد. داروهایی را که در AsNeeded پیگیری نمی‌کنید بررسی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの数量、日付、投与記録に基づく補充の通知はありません。AsNeededで管理していない薬についても確認してください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма известия за попълване на запасите въз основа на запазените количества, дати и регистрирани дози. Проверете лекарствата, които не проследявате в AsNeeded."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hi ha avisos de reposició segons les quantitats i dates desades i les dosis registrades. Comprova els medicaments dels quals no fas seguiment a AsNeeded."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na základě uložených množství, dat a zaznamenaných dávek nejsou žádná upozornění na doplnění zásoby. Zkontrolujte všechny léky, které v AsNeeded nesledujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen genopfyldningsbeskeder baseret på dine gemte mængder, datoer og registrerede doser. Kontrollér de lægemidler, du ikke holder styr på i AsNeeded."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν ειδοποιήσεις αναπλήρωσης με βάση τις αποθηκευμένες ποσότητες, τις ημερομηνίες και τις καταγεγραμμένες δόσεις σας. Ελέγξτε τυχόν φάρμακα που δεν παρακολουθείτε στο AsNeeded."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No refill alerts based on your saved quantities, dates, and logged doses. Check any medications you aren’t tracking in AsNeeded."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "No refill alerts based on your saved quantities, dates, and logged doses. Check any medications you aren’t tracking in AsNeeded."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "No refill alerts based on your saved quantities, dates, and logged doses. Check any medications you aren’t tracking in AsNeeded."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay alertas de reposición según las cantidades, fechas y dosis registradas que guardaste. Revisa los medicamentos que no estés siguiendo en AsNeeded."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettujen määrien, päivämäärien ja kirjattujen annosten perusteella ei ole täydennysilmoituksia. Tarkista myös lääkkeet, joita et seuraa AsNeeded-sovelluksessa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune alerte de renouvellement selon vos quantités et dates sauvegardées et vos doses enregistrées. Vérifiez les médicaments dont vous ne faites pas le suivi dans AsNeeded."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सहेजी गई मात्राओं, तारीखों और दर्ज खुराकों के आधार पर दवा फिर भरवाने का कोई अलर्ट नहीं है। जिन दवाओं का हिसाब आप AsNeeded में नहीं रख रहे हैं, उन्हें जाँचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na temelju spremljenih količina, datuma i zabilježenih doza nema obavijesti o obnovi zaliha. Provjerite sve lijekove koje ne pratite u aplikaciji AsNeeded."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mentett mennyiségek, dátumok és naplózott adagok alapján nincsenek készletfeltöltési értesítések. Ellenőrizze azokat a gyógyszereket is, amelyeket nem követ nyomon az AsNeeded alkalmazásban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada peringatan pengisian ulang berdasarkan jumlah, tanggal, dan dosis tercatat yang Anda simpan. Periksa obat apa pun yang tidak Anda lacak di AsNeeded."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun avviso di rifornimento in base alle quantità e alle date salvate e alle dosi registrate. Controlla gli eventuali farmaci che non stai monitorando in AsNeeded."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сақталған мөлшерлерге, күндерге және тіркелген дозаларға негізделген қорды толықтыру ескертулері жоқ. AsNeeded қолданбасында қадағаламайтын дәрілеріңізді тексеріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 수량, 날짜, 복용 기록을 기준으로 한 약 보충 알림이 없습니다. AsNeeded에서 추적하지 않는 약도 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada amaran pengisian semula berdasarkan kuantiti dan tarikh yang anda simpan serta dos yang direkodkan. Semak mana-mana ubat yang tidak anda jejaki dalam AsNeeded."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen påfyllingsvarsler basert på lagrede mengder, datoer og registrerte doser. Sjekk eventuelle legemidler du ikke følger opp i AsNeeded."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen waarschuwingen om de voorraad aan te vullen op basis van je opgeslagen hoeveelheden, datums en geregistreerde doses. Controleer ook de medicijnen die je niet bijhoudt in AsNeeded."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak powiadomień o uzupełnieniu zapasu na podstawie zapisanych ilości, dat i dawek. Sprawdź leki, których nie śledzisz w AsNeeded."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum alerta de reposição com base nas quantidades, datas e doses registradas que você salvou. Verifique os medicamentos que você não acompanha no AsNeeded."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem alertas de reposição com base nas quantidades, datas e doses registadas que guardou. Verifique os medicamentos que não está a acompanhar em AsNeeded."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există alerte de reaprovizionare pe baza cantităților și datelor salvate și a dozelor înregistrate. Verifică medicamentele pe care nu le urmărești în AsNeeded."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По сохранённым количествам, датам и записям о приёме уведомлений о пополнении запаса нет. Проверьте лекарства, которые вы не отслеживаете в AsNeeded."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na základe uložených množstiev, dátumov a zaznamenaných dávok nie sú žiadne upozornenia na doplnenie zásob. Skontrolujte aj lieky, ktoré v AsNeeded nesledujete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga påfyllningsvarningar utifrån dina sparade mängder, datum och loggade doser. Kontrollera de läkemedel du inte följer i AsNeeded."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการแจ้งเตือนให้เติมยาตามปริมาณ วันที่ และการใช้ยาที่คุณบันทึกไว้ โปรดตรวจสอบยาที่คุณไม่ได้ติดตามใน AsNeeded"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı miktarlarınıza, tarihlerinize ve dozlarınıza göre ilaç temini uyarısı yok. AsNeeded uygulamasında takip etmediğiniz ilaçları kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За збереженими кількостями, датами та записами про прийоми немає сповіщень про поповнення запасу. Перевірте ліки, які ви не відстежуєте в AsNeeded."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có thông báo bổ sung thuốc dựa trên số lượng, ngày tháng đã lưu và các liều đã ghi nhận. Hãy kiểm tra các loại thuốc bạn không theo dõi trong AsNeeded."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "根據你已儲存的存量、日期及用藥記錄，目前沒有補充藥物提示。請檢查你未有在 AsNeeded 追蹤的藥物。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据已保存的数量、日期和用药记录，目前没有补药提醒。请检查未在 AsNeeded 中跟踪的药物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據你已儲存的數量、日期與用藥紀錄，目前沒有補藥通知。請檢查未在 AsNeeded 中追蹤的藥物。"
          }
        }
      }
    },
