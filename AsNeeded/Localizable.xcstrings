    "Choose how to handle app settings when importing data.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر كيف تتعامل مع الإعدادات عند الاستيراد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria com es gestiona la configuració de l'app en importar dades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, jak při importu dat zacházet s nastavením aplikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg hvordan du vil håndtere app-indstillinger når du importerer data."
          }
