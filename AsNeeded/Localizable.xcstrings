        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр нұсқада алдын ала қарау үлгісі бар. Қолданбада пайдалану үшін қаріпті таңдаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 옵션에는 미리보기가 포함되어 있습니다. 앱에서 사용할 글꼴을 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap pilihan disertakan pratonton. Pilih fon untuk menggunakannya dalam aplikasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert alternativ har en forhåndsvisning. Velg en skrifttype for å bruke den i appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
