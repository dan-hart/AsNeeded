    "Scheduled reminders use dates and times you choose. Optional next-dose alerts are managed separately.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios programados usan las fechas y horas que elijas. Las alertas opcionales de próxima dosis se gestionan por separado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geplante Erinnerungen verwenden die von dir gewählten Daten und Uhrzeiten. Optionale Hinweise zur nächsten Dosis werden separat verwaltet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels programmés utilisent les dates et heures de votre choix. Les alertes facultatives de prochaine prise sont gérées séparément."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم التذكيرات المجدولة التواريخ والأوقات التي تختارها. تُدار تنبيهات الجرعة التالية الاختيارية بشكل منفصل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תזכורות מתוזמנות משתמשות בתאריכים ובשעות שנבחרו. התראות אופציונליות על המנה הבאה מנוהלות בנפרד."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یادآورهای زمان‌بندی‌شده از تاریخ‌ها و زمان‌هایی استفاده می‌کنند که انتخاب می‌کنید. هشدارهای اختیاری نوبت مصرف بعدی جداگانه مدیریت می‌شوند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日時指定のリマインダーには、選択した日時が使用されます。任意で設定する次回服用の通知は別途管理されます。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Планираните напомняния използват избрани от вас дати и часове. Незадължителните известия за следваща доза се управляват отделно."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els recordatoris programats fan servir les dates i hores que triïs. Els avisos opcionals de la dosi següent es gestionen per separat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naplánované připomínky používají vámi zvolená data a časy. Volitelná upozornění na další dávku se spravují samostatně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlagte påmindelser bruger datoer og tidspunkter, du vælger. Valgfrie beskeder om næste dosis administreres separat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προγραμματισμένες υπενθυμίσεις χρησιμοποιούν ημερομηνίες και ώρες που επιλέγετε. Οι προαιρετικές ειδοποιήσεις επόμενης δόσης ρυθμίζονται ξεχωριστά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled reminders use dates and times you choose. Optional next-dose alerts are managed separately."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled reminders use dates and times you choose. Optional next-dose alerts are managed separately."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled reminders use dates and times you choose. Optional next-dose alerts are managed separately."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios programados usan las fechas y horas que elijas. Las alertas opcionales de la próxima dosis se administran por separado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajastetut muistutukset käyttävät valitsemiasi päivämääriä ja kellonaikoja. Valinnaisia seuraavan annoksen ilmoituksia hallitaan erikseen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels programmés utilisent les dates et les heures de votre choix. Les alertes facultatives de prochaine dose sont gérées séparément."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्धारित अनुस्मारक आपकी चुनी हुई तारीखों और समयों का उपयोग करते हैं। अगली खुराक के वैकल्पिक अलर्ट अलग से प्रबंधित किए जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakazani podsjetnici upotrebljavaju datume i vremena koja odaberete. Neobaveznim upozorenjima za sljedeću dozu upravlja se zasebno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ütemezett emlékeztetők az általad választott dátumokat és időpontokat használják. A következő adagra vonatkozó opcionális értesítések külön kezelhetők."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat terjadwal menggunakan tanggal dan waktu yang Anda pilih. Peringatan dosis berikutnya yang opsional dikelola secara terpisah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria programmati usano le date e gli orari che scegli. Gli avvisi facoltativi per la dose successiva vengono gestiti separatamente."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоспарланған еске салғыштар сіз таңдаған күндер мен уақыттарды пайдаланады. Келесі доза туралы қосымша хабарландырулар бөлек басқарылады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약 알림은 선택한 날짜와 시간을 사용합니다. 선택 사항인 다음 복용 알림은 별도로 관리합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan berjadual menggunakan tarikh dan masa yang anda pilih. Amaran dos seterusnya yang bersifat pilihan diurus secara berasingan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlagte påminnelser bruker datoer og tidspunkter du velger. Valgfrie varsler om neste dose administreres separat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geplande herinneringen gebruiken datums en tijdstippen die je kiest. Optionele meldingen voor de volgende dosis worden afzonderlijk beheerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaplanowane przypomnienia korzystają z wybranych dat i godzin. Opcjonalnymi alertami o kolejnej dawce zarządza się osobno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes agendados usam as datas e os horários que você escolhe. Os alertas opcionais da próxima dose são gerenciados separadamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes agendados usam as datas e horas que escolher. Os alertas opcionais da próxima dose são geridos separadamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mementourile programate folosesc datele și orele pe care le alegi. Alertele opționale pentru următoarea doză sunt gestionate separat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания по расписанию используют выбранные вами даты и время. Дополнительные уведомления о следующем приёме настраиваются отдельно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naplánované pripomienky používajú dátumy a časy, ktoré si zvolíte. Voliteľné upozornenia na ďalšiu dávku sa spravujú samostatne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Schemalagda påminnelser använder datum och tider som du väljer. Valfria aviseringar om nästa dos hanteras separat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเตือนตามกำหนดเวลาใช้วันที่และเวลาที่คุณเลือก ส่วนการแจ้งเตือนการใช้ยาครั้งถัดไปซึ่งเลือกเปิดได้จะจัดการแยกต่างหาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlanmış hatırlatıcılar, seçtiğiniz tarihleri ve saatleri kullanır. İsteğe bağlı sonraki doz uyarıları ayrı olarak yönetilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заплановані нагадування використовують вибрані вами дати й час. Необов’язкові сповіщення про наступну дозу налаштовуються окремо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời nhắc theo lịch sử dụng ngày và giờ bạn chọn. Cảnh báo liều tiếp theo tùy chọn được quản lý riêng."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "排程提醒會使用你選擇的日期和時間。可選的下次用藥提示會另行管理。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定时提醒使用您选择的日期和时间。可选的下次用药提醒单独管理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排程提醒使用您選擇的日期與時間。選用的下次用藥通知另行管理。"
          }
        }
      }
    },
    "Screen privacy only. Saved data, exports, notifications, and widgets are unchanged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacidad solo en pantalla. Los datos guardados, las exportaciones, las notificaciones y los widgets no cambian."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schützt nur die Anzeige. Gespeicherte Daten, Exporte, Mitteilungen und Widgets bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confidentialité de l’écran uniquement. Les données enregistrées, les exportations, les notifications et les widgets restent inchangés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خصوصية الشاشة فقط. لا تتغير البيانات المحفوظة أو الملفات المصدّرة أو الإشعارات أو الأدوات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פרטיות המסך בלבד. נתונים שמורים, קבצים מיוצאים, התראות ווידג׳טים נשארים ללא שינוי."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط حریم خصوصی صفحه را پوشش می‌دهد. داده‌های ذخیره‌شده، خروجی‌ها، اعلان‌ها و ویجت‌ها تغییری نمی‌کنند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上のプライバシーのみを保護します。保存データ、書き出し、通知、ウィジェットは変更されません。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поверителност само на екрана. Запазените данни, експортираните файлове, известията и уиджетите остават непроменени."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només afecta la privadesa en pantalla. Les dades desades, les exportacions, les notificacions i els ginys no canvien."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soukromí pouze na obrazovce. Uložená data, exporty, oznámení a widgety zůstávají beze změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun beskyttelse mod indblik på skærmen. Gemte data, eksporter, notifikationer og widgets er uændrede."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απόρρητο μόνο στην οθόνη. Τα αποθηκευμένα δεδομένα, οι εξαγωγές, οι γνωστοποιήσεις και τα widget παραμένουν αμετάβλητα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen privacy only. Saved data, exports, notifications, and widgets are unchanged."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen privacy only. Saved data, exports, notifications, and widgets are unchanged."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen privacy only. Saved data, exports, notifications, and widgets are unchanged."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo protege la privacidad en pantalla. Los datos guardados, las exportaciones, las notificaciones y los widgets no cambian."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suojaa yksityisyyttä vain näytöllä. Tallennetut tiedot, viennit, ilmoitukset ja widgetit pysyvät ennallaan."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Confidentialité à l’écran seulement. Les données enregistrées, les exportations, les notifications et les widgets restent inchangés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल स्क्रीन की गोपनीयता के लिए। सहेजा गया डेटा, निर्यात, सूचनाएँ और विजेट अपरिवर्तित रहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privatnost samo na zaslonu. Spremljeni podaci, izvozi, obavijesti i widgeti ostaju nepromijenjeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a képernyőn megjelenő adatokat rejti el. A mentett adatok, az exportok, az értesítések és a widgetek változatlanok maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya privasi layar. Data tersimpan, ekspor, pemberitahuan, dan widget tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy solo sullo schermo. Dati salvati, esportazioni, notifiche e widget restano invariati."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құпиялық тек экранға қатысты. Сақталған деректер, экспорттар, хабарландырулар мен виджеттер өзгермейді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에 표시되는 정보만 가립니다. 저장된 데이터, 내보내기, 알림 및 위젯은 변경되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Privasi skrin sahaja. Data tersimpan, eksport, pemberitahuan dan widget tidak berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun personvern på skjermen. Lagrede data, eksporter, varslinger og widgeter er uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen privacy op het scherm. Opgeslagen gegevens, exports, meldingen en widgets blijven ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prywatność dotyczy tylko ekranu. Zapisane dane, eksporty, powiadomienia i widżety pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacidade apenas na tela. Dados salvos, exportações, notificações e widgets permanecem inalterados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacidade apenas no ecrã. Os dados guardados, as exportações, as notificações e os widgets mantêm-se inalterados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Confidențialitate doar pe ecran. Datele salvate, exporturile, notificările și widgeturile rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывает данные только на экране. Сохранённые данные, экспорт, уведомления и виджеты остаются без изменений."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ochrana súkromia sa týka iba obrazovky. Uložené údaje, exporty, hlásenia a widgety zostávajú nezmenené."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Integritetsskydd endast på skärmen. Sparade data, exporter, notiser och widgetar påverkas inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปกป้องความเป็นส่วนตัวบนหน้าจอเท่านั้น ข้อมูลที่บันทึกไว้ ข้อมูลที่ส่งออก การแจ้งเตือน และวิดเจ็ตยังคงเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca ekran gizliliği. Kaydedilen veriler, dışa aktarımlar, bildirimler ve araç takımları değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише конфіденційність на екрані. Збережені дані, експортовані файли, сповіщення та віджети залишаються без змін."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ bảo vệ quyền riêng tư trên màn hình. Dữ liệu đã lưu, bản xuất, thông báo và tiện ích không thay đổi."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只保護畫面私隱。已儲存的資料、匯出內容、通知及小工具均不受影響。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保护屏幕隐私。已保存的数据、导出文件、通知和小组件均保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅保護畫面隱私。已儲存的資料、匯出內容、通知與小工具皆不受影響。"
          }
        }
      }
    },
    "Scroll to the dose check warning": {
      "localizations": {
