        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Времето за изчакване според запазените от вас указания за дозиране изтече. Прегледайте указанията за лекарството си, преди да приемете доза."
          }
        },
        "ca": {
          "stringUnit": {
