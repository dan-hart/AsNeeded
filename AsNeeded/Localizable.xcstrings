    "This product uses publicly available data from the U.S. National Library of Medicine (NLM), National Institutes of Health, Department of Health and Human Services.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المنتج يستخدم بيانات متاحة للعامة من المكتبة الوطنية الأمريكية للطب (NLM)، والمعاهد الوطنية للصحة، ووزارة الصحة والخدمات الإنسانية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest producte utilitza dades de domini públic de la U.S. National Library of Medicine (NLM), els National Institutes of Health i el Department of Health and Human Services."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento produkt používá veřejně dostupná data z U.S. National Library of Medicine (NLM), National Institutes of Health, Department of Health and Human Services."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette produkt bruger offentligt tilgængelige data fra U.S. National Library of Medicine (NLM), National Institutes of Health, Department of Health and Human Services."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Produkt verwendet öffentlich verfügbare Daten der U.S. National Library of Medicine (NLM), National Institutes of Health, Department of Health and Human Services."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το προϊόν χρησιμοποιεί δημόσια διαθέσιμα δεδομένα από τη Βιβλιοθήκη Ιατρικής των ΗΠΑ (U.S. National Library of Medicine, NLM), τα Εθνικά Ινστιτούτα Υγείας (National Institutes of Health), και το Υπουργείο Υγείας και Ανθρωπίνων Υπηρεσιών (Department of Health and Human Services)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This product uses publicly available data from the U.S. National Library of Medicine (NLM), National Institutes of Health, Department of Health and Human Services."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This product uses publicly available data from the U.S. National Library of Medicine (NLM), National Institutes of Health, Department of Health and Human Services."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This product uses publicly available data from the US National Library of Medicine (NLM), National Institutes of Health, Department of Health and Human Services."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este producto utiliza datos disponibles públicamente de la Biblioteca Nacional de Medicina de EE. UU. (NLM), los Institutos Nacionales de la Salud, del Departamento de Salud y Servicios Humanos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Este producto utiliza datos de acceso público de la U.S. National Library of Medicine (NLM), National Institutes of Health, Department of Health and Human Services."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این محصول از داده‌های در دسترس عموم کتابخانه ملی پزشکی آمریکا (NLM)، مؤسسه ملی سلامت، وزارت بهداشت و خدمات انسانی استفاده می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tuote käyttää Yhdysvaltain National Library of Medicinein (NLM) julkisesti saatavilla olevia tietoja, National Institutes of Healthilta, Department of Health and Human Servicesiltä."
          }
        },
        "fr": {
