    "Based only on your saved limits and logged doses. Follow your prescription and care instructions.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basado únicamente en tus límites guardados y las dosis registradas. Sigue tu prescripción y las indicaciones de atención médica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausschließlich auf Grundlage deiner gespeicherten Grenzwerte und erfassten Dosen. Befolge deine Verordnung und die Anweisungen zur Behandlung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement d’après vos limites enregistrées et vos prises consignées. Suivez votre ordonnance et vos consignes de soins."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استنادًا فقط إلى حدودك المحفوظة وجرعاتك المسجلة. اتبع وصفتك الطبية وتعليمات الرعاية الخاصة بك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מבוסס רק על המגבלות ששמרת ועל המנות שתועדו. יש לפעול לפי המרשם והנחיות הטיפול שלך."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط بر اساس محدودیت‌های ذخیره‌شده و دوزهای ثبت‌شدهٔ شما است. از نسخه و دستورهای مراقبتی خود پیروی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した制限と服薬記録のみに基づいています。処方および療養上の指示に従ってください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Само въз основа на запазените от вас ограничения и записаните дози. Следвайте предписанието и указанията за грижа."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es basa únicament en els límits que has desat i les dosis registrades. Segueix la teva prescripció i les instruccions assistencials."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vychází pouze z vašich uložených limitů a zaznamenaných dávek. Řiďte se předepsaným dávkováním a pokyny k péči."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun baseret på dine gemte grænser og registrerede doser. Følg din ordination og dine behandlingsanvisninger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βασίζεται μόνο στα αποθηκευμένα όριά σας και στις καταγεγραμμένες δόσεις. Ακολουθήστε τη συνταγή σας και τις οδηγίες φροντίδας σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based only on your saved limits and logged doses. Follow your prescription and care instructions."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Based only on your saved limits and logged doses. Follow your prescription and care instructions."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Based only on your saved limits and logged doses. Follow your prescription and care instructions."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se basa únicamente en tus límites guardados y tus dosis registradas. Sigue tu receta y las indicaciones de atención médica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Perustuu vain tallentamiisi rajoihin ja kirjattuihin annoksiin. Noudata lääkemääräystäsi ja hoito-ohjeitasi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Selon uniquement vos limites enregistrées et les doses consignées. Suivez votre ordonnance et vos consignes de soins."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल आपकी सहेजी गई सीमाओं और दर्ज की गई खुराकों पर आधारित। अपने नुस्खे और देखभाल संबंधी निर्देशों का पालन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo na temelju tvojih spremljenih ograničenja i zabilježenih doza. Slijedi propisanu terapiju i upute za skrb."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kizárólag az Ön mentett korlátain és rögzített adagjain alapul. Kövesse az orvosi rendelvényt és az ellátási utasításokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya berdasarkan batas yang Anda simpan dan dosis yang tercatat. Ikuti resep dan petunjuk perawatan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo in base ai limiti salvati e alle dosi registrate. Segui la prescrizione e le indicazioni di cura."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек сақталған шектеріңіз бен тіркелген дозаларға негізделген. Рецептіңізді және күтім жөніндегі нұсқауларды орындаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 한도와 복용 기록만을 기준으로 합니다. 처방 및 치료 지침을 따르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdasarkan had yang anda simpan dan dos yang direkodkan sahaja. Ikut preskripsi dan arahan penjagaan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun basert på de lagrede grensene dine og registrerte doser. Følg resepten din og instruksjonene fra helsepersonell."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitsluitend gebaseerd op je opgeslagen limieten en geregistreerde doses. Volg je voorschrift en zorginstructies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącznie na podstawie zapisanych limitów i dawek. Przestrzegaj przepisanych zaleceń i instrukcji dotyczących leczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base apenas nos seus limites salvos e nas doses registradas. Siga sua prescrição e as instruções de cuidados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base apenas nos limites guardados e nas doses registadas. Siga a sua prescrição e as instruções de cuidados de saúde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar pe baza limitelor salvate și a dozelor înregistrate. Respectă prescripția și instrucțiunile de îngrijire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только на основе сохранённых вами ограничений и записанных приёмов. Следуйте назначениям и указаниям по лечению."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Iba na základe vašich uložených limitov a zaznamenaných dávok. Dodržiavajte predpis a pokyny k liečbe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Baserat enbart på dina sparade gränser och loggade doser. Följ din ordination och vårdens anvisningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ้างอิงเฉพาะจากขีดจำกัดที่คุณบันทึกไว้และบันทึกการใช้ยาเท่านั้น โปรดปฏิบัติตามใบสั่งยาและคำแนะนำในการดูแลรักษา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kaydettiğiniz sınırlara ve doz kayıtlarına dayanır. Reçetenize ve bakım talimatlarınıza uyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише на основі збережених вами обмежень і записаних доз. Дотримуйтеся призначення та вказівок щодо лікування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ dựa trên các giới hạn bạn đã lưu và các liều đã ghi lại. Hãy tuân theo đơn thuốc và hướng dẫn chăm sóc của bạn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "僅根據你已儲存的限制及用藥記錄。請遵循處方及護理指示。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅根据您保存的用药限制和用药记录计算。请遵循处方和护理说明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅依據您已儲存的限制與用藥紀錄。請遵循您的處方與照護指示。"
          }
        }
      }
    },
