    "Technical logs help diagnose issues faster. Your privacy is protected—no medication names are ever stored in logs.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تساعد السجلات التقنية على تشخيص المشكلات بشكل أسرع. خصوصيتك محمية، فلا تُخزَّن أسماء الأدوية في السجلات مطلقًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els registres tècnics ajuden a diagnosticar els problemes més ràpidament. La teva privadesa està protegida: mai no es desen noms de medicaments als registres."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Technické protokoly pomáhají rychleji diagnostikovat problémy. Vaše soukromí je chráněno — názvy léků se do protokolů nikdy neukládají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekniske logs hjælper med at diagnosticere problemer hurtigere. Dit privatliv er beskyttet—ingen medicin navne gemmes nogensinde i logs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Technische Protokolle helfen, Probleme schneller zu diagnostizieren. Ihre Privatsphäre ist geschützt – Medikamentennamen werden niemals in Protokollen gespeichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα τεχνικά αρχεία καταγραφής βοηθούν στην ταχύτερη διάγνωση προβλημάτων. Το απόρρητό σας προστατεύεται — κανένα όνομα φαρμάκου δεν αποθηκεύεται ποτέ στα αρχεία καταγραφής."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Technical logs help diagnose issues faster. Your privacy is protected—no medication names are ever stored in logs."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Technical logs help diagnose issues faster. Your privacy is protected—no medication names are ever stored in logs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros técnicos ayudan a diagnosticar problemas más rápidamente. Tu privacidad está protegida: los nombres de medicamentos nunca se almacenan en registros."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros técnicos ayudan a diagnosticar problemas más rápidamente. Tu privacidad está protegida: los nombres de medicamentos nunca se almacenan en registros."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گزارش‌های فنی به تشخیص سریع‌تر مشکلات کمک می‌کنند. حریم خصوصی شما حفظ می‌شود؛ نام داروها هرگز در گزارش‌ها ذخیره نمی‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekniset lokit auttavat selvittämään ongelmat nopeammin. Yksityisyytesi on suojattu: lääkkeiden nimiä ei koskaan tallenneta lokeihin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les journaux techniques aident à diagnostiquer les problèmes plus rapidement. Votre vie privée est protégée : aucun nom de médicament n’est jamais enregistré dans les journaux."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les journaux techniques aident à diagnostiquer les problèmes plus rapidement. Votre vie privée est protégée : aucun nom de médicament n’est jamais conservé dans les journaux."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יומנים טכניים עוזרים לאבחן בעיות מהר יותר. הפרטיות שלך מוגנת — שמות תרופות לעולם אינם נשמרים ביומנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तकनीकी लॉग समस्याओं का जल्दी पता लगाने में मदद करते हैं। आपकी गोपनीयता सुरक्षित रहती है—दवाओं के नाम कभी भी लॉग में सहेजे नहीं जाते।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A technikai naplók segítenek a problémák gyorsabb felderítésében. A magánszférád védett – a naplókban soha nem tárolunk gyógyszerneveket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Log teknis membantu mendiagnosis masalah lebih cepat. Privasi Anda dilindungi—nama obat tidak pernah disimpan dalam log."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I log tecnici aiutano a diagnosticare i problemi più rapidamente. La tua privacy è protetta: i nomi dei farmaci non vengono mai memorizzati nei log."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Техникалық журналдар ақауларды жылдам анықтауға көмектеседі. Құпиялылығыңыз қорғалған — дәрі атаулары журналдарда ешқашан сақталмайды."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log teknikal membantu mendiagnosis masalah dengan lebih cepat. Privasi anda dilindungi—nama ubat tidak pernah disimpan dalam log."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekniske logger hjelper til å diagnostisere problemer raskere. Personvernet ditt er beskyttet—ingen legemiddel navn lagres noen gang i logger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Technische logboeken helpen problemen sneller te diagnosticeren. Uw privacy is beschermd – medicijnamen worden nooit in logboeken opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzienniki techniczne pomagają szybciej diagnozować problemy. Twoja prywatność jest chroniona — nazwy leków nigdy nie są zapisywane w dziennikach."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Jurnalele tehnice ajută la diagnosticarea mai rapidă a problemelor. Confidențialitatea ta este protejată — denumirile medicamentelor nu sunt stocate niciodată în jurnale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Технические журналы помогают диагностировать проблемы быстрее. Ваша конфиденциальность защищена — названия лекарств никогда не хранятся в журналах."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekniska loggar hjälper till att diagnostisera problem snabbare. Din sekretess är skyddad - läkemedelnamn lagras aldrig i loggar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกทางเทคนิคช่วยวินิจฉัยปัญหาได้เร็วขึ้น ความเป็นส่วนตัวของคุณได้รับการปกป้อง โดยจะไม่มีการเก็บชื่อยาไว้ในบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teknik günlükler, sorunların daha hızlı teşhis edilmesine yardımcı olur. Gizliliğiniz korunur; günlüklerde hiçbir zaman ilaç adları saklanmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhật ký kỹ thuật giúp chẩn đoán sự cố nhanh hơn. Quyền riêng tư của bạn được bảo vệ—tên thuốc không bao giờ được lưu trong nhật ký."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "技術日誌有助更快診斷問題。你的私隱受到保障，日誌絕不會儲存藥物名稱。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "技术日志有助于更快诊断问题。您的隐私受到保护，日志绝不会存储药物名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "技術記錄有助於更快診斷問題。您的隱私受到保護，記錄中絕不會儲存藥物名稱。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "技術ログは、問題の迅速な診断に役立ちます。プライバシーは保護され、薬の名前がログに保存されることは一切ありません。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Техническите журнали помагат за по-бързото диагностициране на проблеми. Поверителността ви е защитена — в журналите никога не се съхраняват имена на лекарства."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Technical logs help diagnose issues faster. Your privacy is protected—no medication names are ever stored in logs."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehnički zapisnici pomažu u bržem dijagnosticiranju problema. Vaša je privatnost zaštićena — nazivi lijekova nikada se ne pohranjuju u zapisnike."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기술 로그는 문제를 더 빠르게 진단하는 데 도움이 됩니다. 개인정보는 보호되며, 약 이름은 로그에 절대 저장되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros técnicos ajudam a diagnosticar problemas mais rapidamente. Sua privacidade é protegida — nomes de medicamentos nunca são armazenados nos registros técnicos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registos técnicos ajudam a diagnosticar problemas mais rapidamente. A sua privacidade está protegida — os nomes dos medicamentos nunca são guardados nos registos técnicos."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Technické záznamy pomáhajú rýchlejšie diagnostikovať problémy. Vaše súkromie je chránené — názvy liekov sa do záznamov nikdy neukladajú."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Технічні журнали допомагають швидше діагностувати проблеми. Вашу конфіденційність захищено — назви ліків ніколи не зберігаються в журналах."
          }
        }
      }
    },
    "Temporarily hide medication names while showing the app. Everything stays tappable. Turns off when the app relaunches.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta temporalmente los nombres de los medicamentos mientras muestras la app. Todos los elementos siguen respondiendo al tacto. Se desactiva al volver a iniciar la app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blende Medikamentennamen vorübergehend aus, während du die App zeigst. Alles bleibt antippbar. Wird beim Neustart der App deaktiviert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquez temporairement les noms des médicaments lorsque vous montrez l’app. Tous les éléments restent utilisables au toucher. Cette option se désactive au prochain lancement de l’app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء أسماء الأدوية مؤقتًا أثناء عرض التطبيق. تظل جميع العناصر قابلة للضغط. يتوقف الإخفاء عند إعادة تشغيل التطبيق."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסתרה זמנית של שמות התרופות בזמן הצגת היישום. כל הרכיבים נשארים ניתנים להקשה. ההסתרה מתבטלת כשהיישום מופעל מחדש."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام نشان دادن برنامه، نام داروها را موقتاً پنهان کنید. همهٔ بخش‌ها همچنان قابل لمس هستند. با اجرای دوبارهٔ برنامه غیرفعال می‌شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを人に見せる際に、薬の名前を一時的に非表示にします。すべての項目は引き続きタップできます。アプリを再起動するとオフになります。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Временно скрива имената на лекарствата, докато показвате приложението. Всички елементи остават достъпни за докосване. Изключва се при повторно стартиране на приложението."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaga temporalment els noms dels medicaments mentre mostres l'app. Tots els elements continuen responent als tocs. Es desactiva quan es torna a iniciar l'app."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dočasně skryje názvy léků při ukazování aplikace. Na vše lze nadále klepnout. Po opětovném spuštění aplikace se vypne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjul midlertidigt medicinnavne, mens du viser appen. Du kan stadig trykke på alt. Slås fra, når appen startes igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποκρύψτε προσωρινά τα ονόματα των φαρμάκων όταν δείχνετε την εφαρμογή. Όλα τα στοιχεία παραμένουν διαθέσιμα για πάτημα. Απενεργοποιείται όταν ανοίξετε ξανά την εφαρμογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporarily hide medication names while showing the app. Everything stays tappable. Turns off when the app relaunches."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporarily hide medication names while showing the app. Everything stays tappable. Turns off when the app relaunches."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporarily hide medication names while showing the app. Everything stays tappable. Turns off when the app relaunches."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta temporalmente los nombres de los medicamentos mientras muestras la app. Todos los controles siguen respondiendo al tacto. Se desactiva al volver a abrir la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piilota lääkkeiden nimet tilapäisesti, kun esittelet sovellusta. Kaikki kohteet pysyvät napautettavina. Toiminto poistuu käytöstä, kun sovellus käynnistetään uudelleen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquez temporairement les noms des médicaments lorsque vous montrez l’app. Tous les éléments restent utilisables au toucher. Cette option se désactive au prochain lancement de l’app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप दिखाते समय दवाओं के नाम अस्थायी रूप से छिपाएँ। सभी चीज़ों पर टैप किया जा सकता है। ऐप दोबारा खुलने पर यह बंद हो जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privremeno sakrij nazive lijekova dok pokazujete aplikaciju. Sve se i dalje može dodirnuti. Isključuje se pri ponovnom pokretanju aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideiglenesen elrejti a gyógyszerneveket, amikor megmutatod az alkalmazást. Minden elem továbbra is koppintható. Az alkalmazás újraindításakor kikapcsol."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembunyikan sementara nama obat saat memperlihatkan aplikasi. Semua elemen tetap dapat diketuk. Dinonaktifkan saat aplikasi dibuka ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi temporaneamente i nomi dei farmaci mentre mostri l’app. Tutti gli elementi restano toccabili. Si disattiva al riavvio dell’app."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданбаны көрсету кезінде дәрі атауларын уақытша жасырыңыз. Барлық элементтерді түртуге болады. Қолданба қайта іске қосылғанда бұл режим өшеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 다른 사람에게 보여줄 때 약 이름을 일시적으로 숨깁니다. 모든 항목은 계속 탭할 수 있습니다. 앱을 다시 실행하면 이 기능이 꺼집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembunyikan nama ubat buat sementara waktu semasa menunjukkan app. Semua elemen masih boleh diketik. Dimatikan apabila app dilancarkan semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjul legemiddelnavn midlertidig mens du viser frem appen. Alt kan fortsatt trykkes på. Slås av når appen startes på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verberg medicatienamen tijdelijk terwijl je de app laat zien. Alles blijft aantikbaar. Wordt uitgeschakeld wanneer de app opnieuw wordt gestart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tymczasowo ukryj nazwy leków podczas pokazywania aplikacji. Wszystkie elementy nadal reagują na stuknięcia. Funkcja wyłącza się po ponownym uruchomieniu aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculte temporariamente os nomes dos medicamentos ao mostrar o app. Todos os elementos continuam respondendo ao toque. A função é desativada quando o app é reaberto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculte temporariamente os nomes dos medicamentos enquanto mostra a aplicação. Todos os elementos continuam a responder ao toque. A opção desativa-se quando a aplicação é reaberta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascunde temporar denumirile medicamentelor când arăți aplicația. Toate elementele pot fi în continuare atinse. Se dezactivează la relansarea aplicației."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временно скрывать названия лекарств, когда вы показываете приложение. Все элементы остаются доступными для нажатия. Отключается при перезапуске приложения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dočasne skryje názvy liekov pri ukazovaní aplikácie. Všetky prvky zostanú ovládateľné klepnutím. Vypne sa pri opätovnom spustení aplikácie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dölj läkemedelsnamnen tillfälligt när du visar appen. Allt går fortfarande att trycka på. Stängs av när appen startas om."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ่อนชื่อยาชั่วคราวขณะแสดงแอป ทุกอย่างยังแตะได้ ฟังก์ชันนี้จะปิดเมื่อเปิดแอปใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı gösterirken ilaç adlarını geçici olarak gizleyin. Tüm öğeler dokunulabilir durumda kalır. Uygulama yeniden başlatıldığında kapanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тимчасово приховує назви ліків, коли ви показуєте застосунок. Усі елементи залишаються доступними для натискання. Вимикається після повторного запуску застосунку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm thời ẩn tên thuốc khi cho người khác xem ứng dụng. Mọi mục vẫn có thể chạm được. Tự tắt khi ứng dụng được khởi chạy lại."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "向他人展示 app 時暫時隱藏藥物名稱。所有項目仍可輕點操作。重新啟動 app 後，此功能會關閉。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展示应用时暂时隐藏药物名称。所有项目仍可轻点操作。重新启动应用后此功能会关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "展示 App 時暫時隱藏藥物名稱。所有項目仍可點按。重新啟動 App 時，此功能會關閉。"
          }
        }
      }
    },
