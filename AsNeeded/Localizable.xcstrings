    "Based on saved limits and logged doses. Follow your prescription and care instructions.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basado en los límites guardados y las dosis registradas. Sigue tu prescripción y las indicaciones de atención médica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Grundlage gespeicherter Grenzwerte und erfasster Dosen. Befolge deine Verordnung und die Anweisungen zur Behandlung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’après les limites enregistrées et les prises consignées. Suivez votre ordonnance et vos consignes de soins."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استنادًا إلى الحدود المحفوظة والجرعات المسجلة. اتبع وصفتك الطبية وتعليمات الرعاية الخاصة بك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מבוסס על המגבלות ששמרת ועל המנות שתועדו. יש לפעול לפי המרשם והנחיות הטיפול שלך."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بر اساس محدودیت‌های ذخیره‌شده و دوزهای ثبت‌شده است. از نسخه و دستورهای مراقبتی خود پیروی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した制限と服薬記録に基づいています。処方および療養上の指示に従ってください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въз основа на запазените ограничения и записаните дози. Следвайте предписанието и указанията за грижа."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es basa en els límits desats i les dosis registrades. Segueix la teva prescripció i les instruccions assistencials."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vychází z uložených limitů a zaznamenaných dávek. Řiďte se předepsaným dávkováním a pokyny k péči."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baseret på gemte grænser og registrerede doser. Følg din ordination og dine behandlingsanvisninger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βασίζεται στα αποθηκευμένα όρια και στις καταγεγραμμένες δόσεις. Ακολουθήστε τη συνταγή σας και τις οδηγίες φροντίδας σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on saved limits and logged doses. Follow your prescription and care instructions."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on saved limits and logged doses. Follow your prescription and care instructions."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on saved limits and logged doses. Follow your prescription and care instructions."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se basa en los límites guardados y las dosis registradas. Sigue tu receta y las indicaciones de atención médica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Perustuu tallennettuihin rajoihin ja kirjattuihin annoksiin. Noudata lääkemääräystäsi ja hoito-ohjeitasi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Selon les limites enregistrées et les doses consignées. Suivez votre ordonnance et vos consignes de soins."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजी गई सीमाओं और दर्ज की गई खुराकों पर आधारित। अपने नुस्खे और देखभाल संबंधी निर्देशों का पालन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na temelju spremljenih ograničenja i zabilježenih doza. Slijedi propisanu terapiju i upute za skrb."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mentett korlátokon és a rögzített adagokon alapul. Kövesse az orvosi rendelvényt és az ellátási utasításokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdasarkan batas yang tersimpan dan dosis yang tercatat. Ikuti resep dan petunjuk perawatan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In base ai limiti salvati e alle dosi registrate. Segui la prescrizione e le indicazioni di cura."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сақталған шектер мен тіркелген дозаларға негізделген. Рецептіңізді және күтім жөніндегі нұсқауларды орындаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 한도와 복용 기록을 기준으로 합니다. 처방 및 치료 지침을 따르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdasarkan had yang disimpan dan dos yang direkodkan. Ikut preskripsi dan arahan penjagaan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Basert på lagrede grenser og registrerte doser. Følg resepten din og instruksjonene fra helsepersonell."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebaseerd op opgeslagen limieten en geregistreerde doses. Volg je voorschrift en zorginstructies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podstawie zapisanych limitów i dawek. Przestrzegaj przepisanych zaleceń i instrukcji dotyczących leczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base nos limites salvos e nas doses registradas. Siga sua prescrição e as instruções de cuidados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base nos limites guardados e nas doses registadas. Siga a sua prescrição e as instruções de cuidados de saúde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe baza limitelor salvate și a dozelor înregistrate. Respectă prescripția și instrucțiunile de îngrijire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На основе сохранённых ограничений и записанных приёмов. Следуйте назначениям и указаниям по лечению."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na základe uložených limitov a zaznamenaných dávok. Dodržiavajte predpis a pokyny k liečbe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Baserat på sparade gränser och loggade doser. Följ din ordination och vårdens anvisningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ้างอิงจากขีดจำกัดที่บันทึกไว้และบันทึกการใช้ยา โปรดปฏิบัติตามใบสั่งยาและคำแนะนำในการดูแลรักษา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen sınırlara ve doz kayıtlarına dayanır. Reçetenize ve bakım talimatlarınıza uyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На основі збережених обмежень і записаних доз. Дотримуйтеся призначення та вказівок щодо лікування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dựa trên các giới hạn đã lưu và các liều đã ghi lại. Hãy tuân theo đơn thuốc và hướng dẫn chăm sóc của bạn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "根據已儲存的限制及用藥記錄。請遵循處方及護理指示。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据已保存的用药限制和用药记录计算。请遵循处方和护理说明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依據已儲存的限制與用藥紀錄。請遵循您的處方與照護指示。"
          }
        }
      }
    },
