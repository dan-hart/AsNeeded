    "No active medications are available. Open AsNeeded to add one.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay medicamentos activos disponibles. Abre AsNeeded para añadir uno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine aktiven Medikamente verfügbar. Öffne AsNeeded, um eines hinzuzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun médicament actif n’est disponible. Ouvrez AsNeeded pour en ajouter un."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتوفر أدوية نشطة. افتح AsNeeded لإضافة دواء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין תרופות פעילות זמינות. יש לפתוח את AsNeeded כדי להוסיף תרופה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ داروی فعالی در دسترس نیست. برای افزودن دارو، AsNeeded را باز کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中の薬はありません。AsNeededを開いて追加してください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма налични активни лекарства. Отворете AsNeeded, за да добавите лекарство."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hi ha cap medicament actiu disponible. Obre AsNeeded per afegir-ne un."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejsou dostupné žádné aktivní léky. Otevřete AsNeeded a přidejte lék."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen aktive lægemidler er tilgængelige. Åbn AsNeeded for at tilføje et."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν διαθέσιμα ενεργά φάρμακα. Ανοίξτε το AsNeeded για να προσθέσετε ένα."
          }
