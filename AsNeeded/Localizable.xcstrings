    "All reminders for this medication will be removed. Your medication and dose history will stay unchanged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todos los recordatorios de este medicamento. Tu medicamento y el historial de dosis permanecerán sin cambios."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Erinnerungen für dieses Medikament werden entfernt. Ihr Medikament und der Dosisverlauf bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les rappels pour ce médicament seront supprimés. Votre médicament et l’historique des prises resteront inchangés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُزال جميع التذكيرات لهذا الدواء. سيبقى الدواء وسجل جرعاتك دون تغيير."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל התזכורות לתרופה זו יוסרו. התרופה והיסטוריית המנות שלך יישארו ללא שינוי."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همهٔ یادآورهای این دارو حذف می‌شوند. دارو و سابقهٔ دوزهای شما بدون تغییر می‌مانند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この薬のリマインダーがすべて削除されます。薬と服薬履歴は変更されません。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всички напомняния за това лекарство ще бъдат премахнати. Лекарството и историята на дозите ще останат непроменени."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'eliminaran tots els recordatoris d'aquest medicament. El medicament i l'historial de dosis es mantindran sense canvis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny připomínky pro tento lék budou odstraněny. Lék a historie dávek zůstanou beze změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle påmindelser om denne medicin bliver fjernet. Din medicin og dosishistorik forbliver uændret."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλες οι υπενθυμίσεις για αυτό το φάρμακο θα καταργηθούν. Το φάρμακό σας και το ιστορικό δόσεων θα παραμείνουν αμετάβλητα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All reminders for this medication will be removed. Your medication and dose history will stay unchanged."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "All reminders for this medication will be removed. Your medication and dose history will stay unchanged."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "All reminders for this medication will be removed. Your medication and dose history will stay unchanged."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todos los recordatorios de este medicamento. Tu medicamento y tu historial de dosis permanecerán sin cambios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki tämän lääkkeen muistutukset poistetaan. Lääkkeesi ja annoshistoriasi säilyvät ennallaan."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les rappels pour ce médicament seront supprimés. Votre médicament et l’historique des doses resteront inchangés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस दवा के सभी रिमाइंडर हटा दिए जाएँगे। आपकी दवा और खुराक का इतिहास यथावत रहेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi podsjetnici za ovaj lijek bit će uklonjeni. Lijek i povijest doza ostat će nepromijenjeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gyógyszerhez tartozó összes emlékeztető törlődik. A gyógyszer és az adagolási előzmények változatlanul megmaradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua pengingat untuk obat ini akan dihapus. Obat dan riwayat dosis Anda akan tetap sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i promemoria per questo farmaco verranno rimossi. Il farmaco e la cronologia delle dosi rimarranno invariati."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы дәрінің барлық еске салғыштары жойылады. Дәріңіз бен дозалар тарихы өзгеріссіз қалады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 약물의 모든 미리 알림이 삭제됩니다. 약물과 복용 기록은 그대로 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua peringatan untuk ubat ini akan dibuang. Ubat dan sejarah dos anda akan kekal tidak berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle påminnelser for dette legemidlet blir fjernet. Legemidlet og dosehistorikken din forblir uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle herinneringen voor dit medicijn worden verwijderd. Je medicijn en dosisgeschiedenis blijven ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie przypomnienia dotyczące tego leku zostaną usunięte. Lek i historia dawek pozostaną bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os lembretes deste medicamento serão removidos. Seu medicamento e o histórico de doses permanecerão inalterados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os lembretes deste medicamento serão removidos. O medicamento e o histórico de doses permanecerão inalterados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate mementourile pentru acest medicament vor fi eliminate. Medicamentul și istoricul dozelor vor rămâne neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все напоминания для этого лекарства будут удалены. Само лекарство и история приёмов останутся без изменений."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky pripomienky pre tento liek budú odstránené. Váš liek a história dávok zostanú nezmenené."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla påminnelser för detta läkemedel tas bort. Läkemedlet och doshistoriken förblir oförändrade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเตือนทั้งหมดสำหรับยานี้จะถูกลบ ข้อมูลยาและประวัติการใช้ยาของคุณจะยังคงเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ilaca ait tüm hatırlatıcılar kaldırılacak. İlaç bilgileriniz ve doz geçmişiniz değişmeyecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі нагадування для цього препарату буде видалено. Препарат та історія доз залишаться без змін."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả lời nhắc cho thuốc này sẽ bị xóa. Thông tin thuốc và lịch sử liều dùng của bạn sẽ giữ nguyên."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "將移除此藥物的所有提醒。你的藥物資料及用藥記錄將維持不變。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将移除此药物的所有提醒。您的药物和用药历史将保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此藥物的所有提醒都將移除。你的藥物及用藥歷史記錄將維持不變。"
          }
        }
      }
    },
