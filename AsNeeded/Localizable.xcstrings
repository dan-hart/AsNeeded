    "%@: %@ Follow your prescription and care instructions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Follow your prescription and care instructions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Sigue tu prescripción y las instrucciones de cuidado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Befolgen Sie Ihre Verordnung und die Anweisungen zu Ihrer Behandlung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : %2$@ Suivez votre ordonnance et les consignes de soins."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ اتبع وصفتك الطبية وتعليمات الرعاية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ יש לפעול לפי המרשם והוראות הטיפול שלך."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ از نسخه و دستورالعمل‌های مراقبتی خود پیروی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：%2$@ 処方および療養上の指示に従ってください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Следвайте предписанието си и указанията за грижи."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Segueix la prescripció i les instruccions d’atenció mèdica."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Dodržujte předepsané dávkování a pokyny k péči."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Følg din ordination og dine behandlingsanvisninger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Ακολουθήστε τη συνταγή σας και τις οδηγίες φροντίδας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Follow your prescription and care instructions."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Follow your prescription and care instructions."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Sigue tu receta y las indicaciones de cuidado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Noudata lääkemääräystäsi ja hoito-ohjeitasi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : %2$@ Respectez votre ordonnance et vos consignes de soins."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ अपने नुस्खे और देखभाल संबंधी निर्देशों का पालन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Pridržavajte se propisane terapije i uputa za skrb."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Kövesse az orvosi rendelvényben és az ellátása során kapott utasításokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Ikuti resep dan petunjuk perawatan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Segui la prescrizione e le indicazioni di cura."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Дәрігердің тағайындауын және күтім жөніндегі нұсқауларды орындаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ 처방과 관리 지침을 따르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Ikuti preskripsi dan arahan penjagaan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Følg forskrivningen og behandlingsinstruksjonene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Volg je voorschrift en zorginstructies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Stosuj się do zaleceń dotyczących przepisanych leków i opieki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Siga sua prescrição e as orientações de cuidado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Siga a sua prescrição e as instruções de cuidados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Respectă prescripția medicală și instrucțiunile de îngrijire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Следуйте назначению врача и указаниям по уходу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Dodržiavajte predpísané dávkovanie a pokyny k starostlivosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Följ din ordination och dina vårdinstruktioner."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ ปฏิบัติตามใบสั่งยาและคำแนะนำในการดูแลของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Reçetenizdeki ve bakım talimatlarınızdaki yönergelere uyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Дотримуйтеся призначення лікаря та вказівок щодо догляду."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Hãy tuân thủ đơn thuốc và hướng dẫn chăm sóc của bạn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：%2$@ 請遵照處方及護理指示。"
          }
