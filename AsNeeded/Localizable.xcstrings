    "Name required. Other fields optional. Enter dose amount and unit together.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre es obligatorio. Los demás campos son opcionales. Introduce la cantidad de la dosis y la unidad juntas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Name erforderlich. Andere Felder optional. Dosismenge und Einheit gemeinsam eingeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nom obligatoire. Autres champs facultatifs. Saisissez ensemble la quantité et l’unité de la dose."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاسم مطلوب. الحقول الأخرى اختيارية. أدخل مقدار الجرعة ووحدتها معًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השם הוא שדה חובה. שאר השדות הם רשות. יש להזין את כמות המנה ואת יחידת המידה יחד."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام الزامی است. سایر فیلدها اختیاری هستند. مقدار دوز و واحد را با هم وارد کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前は必須です。他の項目は任意です。投与量と単位は一緒に入力してください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Името е задължително. Останалите полета са незадължителни. Въведете заедно количеството на дозата и мерната единица."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El nom és obligatori. Els altres camps són opcionals. Introdueix la quantitat de la dosi i la unitat juntes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Název je povinný. Ostatní pole jsou nepovinná. Množství dávky a jednotku zadejte společně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Navn er påkrævet. Andre felter er valgfrie. Angiv dosismængde og enhed sammen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όνομα απαιτείται. Τα υπόλοιπα πεδία είναι προαιρετικά. Εισαγάγετε μαζί την ποσότητα δόσης και τη μονάδα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name required. Other fields optional. Enter dose amount and unit together."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Name required. Other fields optional. Enter dose amount and unit together."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Name required. Other fields optional. Enter dose amount and unit together."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre es obligatorio. Los demás campos son opcionales. Ingresa la cantidad de la dosis y la unidad juntas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimi on pakollinen. Muut kentät ovat valinnaisia. Syötä annoksen määrä ja yksikkö yhdessä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Nom obligatoire. Autres champs facultatifs. Saisissez ensemble la quantité de la dose et son unité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम आवश्यक है। अन्य फ़ील्ड वैकल्पिक हैं। खुराक की मात्रा और इकाई एक साथ दर्ज करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Naziv je obavezan. Ostala polja nisu obavezna. Unesite količinu doze i jedinicu zajedno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A név kötelező. A többi mező nem kötelező. Az adag mennyiségét és mértékegységét együtt adja meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama wajib diisi. Kolom lainnya opsional. Masukkan jumlah dosis beserta satuannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome è obbligatorio. Gli altri campi sono facoltativi. Inserisci insieme quantità della dose e unità di misura."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Атауы міндетті. Басқа өрістер міндетті емес. Доза мөлшері мен өлшем бірлігін бірге енгізіңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름은 필수입니다. 다른 항목은 선택 사항입니다. 복용량과 단위는 함께 입력하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama wajib diisi. Medan lain adalah pilihan. Masukkan jumlah dos dan unit bersama-sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Navn er obligatorisk. Andre felt er valgfrie. Angi dosemengde og enhet sammen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naam verplicht. Andere velden optioneel. Vul dosishoeveelheid en eenheid samen in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa jest wymagana. Pozostałe pola są opcjonalne. Podaj ilość dawki wraz z jednostką."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nome obrigatório. Os outros campos são opcionais. Informe a quantidade da dose e a unidade juntas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nome obrigatório. Os restantes campos são opcionais. Introduza a quantidade da dose e a unidade em conjunto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele este obligatoriu. Celelalte câmpuri sunt opționale. Introdu împreună cantitatea dozei și unitatea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название обязательно. Остальные поля необязательны. Укажите количество и единицу измерения дозы вместе."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Názov je povinný. Ostatné polia sú nepovinné. Množstvo dávky a jednotku zadajte spoločne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Namn krävs. Övriga fält är valfria. Ange dosmängd och enhet tillsammans."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องระบุชื่อ ช่องอื่นไม่บังคับ ระบุปริมาณยาต่อครั้งพร้อมหน่วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad zorunludur. Diğer alanlar isteğe bağlıdır. Doz miktarını ve birimini birlikte girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва обов’язкова. Інші поля необов’язкові. Кількість та одиницю вимірювання дози вводьте разом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên là bắt buộc. Các trường khác không bắt buộc. Nhập cả lượng mỗi liều và đơn vị."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱為必填，其他欄位則可選填。請同時輸入劑量及單位。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称为必填项，其他字段为选填项。剂量和单位需同时填写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱為必填，其他欄位為選填。劑量與單位須一併輸入。"
          }
        }
      }
    },
