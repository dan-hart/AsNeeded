        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para personalizar dosis, mantén presionado para registrar dosis predeterminada"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای شخصی‌سازی مقدار مصرف بزنید؛ برای ثبت مقدار مصرف پیش‌فرض نگه دارید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukauta annosta napauttamalla, kirjaa oletusannos painamalla pitkään"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour personnaliser la dose, appuyez longuement pour enregistrer une prise à la dose par défaut"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
