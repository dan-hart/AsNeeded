    "Always consult a licensed medical professional before making any changes to your medication regimen.": {
      "comment": "A text that advises the user to consult a medical professional before making changes to their medication regimen.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استشر دائمًا أخصائيًا طبيًا مرخّصًا قبل إجراء أي تغييرات على نظام أدويتك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta sempre un professional mèdic autoritzat abans de fer qualsevol canvi en el teu règim de medicació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vždy se poraďte s kvalifikovaným lékařem, než provedete jakékoli změny ve své medikační režimu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontakt altid en autoriseret sundhedsprofessionel, før du ændrer din medicinering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konsultiere vor Änderungen an deiner Medikation immer eine:n zugelassene:n Ärzt:in oder eine andere qualifizierte medizinische Fachperson."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συμβουλευτείτε πάντα έναν αδειοδοτημένο ιατρό πριν κάνετε οποιεσδήποτε αλλαγές στο σχήμα των φαρμάκων σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always consult a licensed medical professional before making any changes to your medication regimen."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Always consult a registered health professional before making any changes to your medication regimen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Always consult a licenced medical professional before making any changes to your medication regimen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta siempre a un profesional médico con licencia antes de hacer cualquier cambio en tu régimen de medicación."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre consulta con un profesional médico autorizado antes de hacer cualquier cambio en tu tratamiento farmacológico."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همیشه قبل از ایجاد هرگونه تغییر در رژیم دارویی خود با یک پزشک دارای مجوز مشورت کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysy aina lisätietoja laillistetulta terveydenhuollon ammattilaiselta ennen kuin teet muutoksia lääkitykseesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulte toujours un professionnel de santé agréé avant de modifier ton traitement médicamenteux."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulte toujours un professionnel de la santé autorisé avant de modifier ton traitement médicamenteux."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התייעץ תמיד עם איש מקצוע רפואי מורשה לפני ביצוע שינויים בסדר התרופות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी दवा-सम्बन्धी परिवर्तन से पहले हमेशा किसी लाइसेंसी चिकित्सक से परामर्श करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mielőtt bármilyen változtatást végzel a gyógyszeres kezeléseden, mindig konzultálj egy engedéllyel rendelkező egészségügyi szakemberrel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selalu konsultasikan dengan tenaga medis berlisensi sebelum melakukan perubahan pada rejimen pengobatanmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta sempre un professionista medico autorizzato prima di apportare modifiche alla tua terapia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "薬の服用方法を変更する前には、必ず医師などの有資格の医療専門家に相談してください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дәрі қабылдау тәртібіңізге қандай да бір өзгеріс енгізбес бұрын міндетті түрде лицензияланған медициналық кәсіпкермен кеңесіп алыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복용 계획을 변경하기 전에 항상 면허가 있는 의료 전문가와 상담하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentiasa rujuk kepada profesional perubatan bertauliah sebelum membuat sebarang perubahan kepada rejimen ubatan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rådfør deg alltid med en lisensiert medisinsk fagperson før du gjør endringer i medisinregimet ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raadpleeg altijd een bevoegde zorgverlener voordat je iets aan je medicatie verandert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze skonsultuj się z licencjonowanym specjalistą medycznym przed wprowadzeniem jakichkolwiek zmian w swoim schemacie przyjmowania leków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulte sempre um profissional médico licenciado antes de fazer qualquer alteração no seu esquema de medicação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta sempre um profissional de saúde licenciado antes de fazeres quaisquer alterações ao teu regime de medicação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta întotdeauna un profesionist medical autorizat înainte de a face orice modificare în regimul tău de medicație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда консультируйся с лицензированным врачом перед любыми изменениями в режиме приёма препаратов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rådgör alltid med en legitimerad vårdpersonal innan du gör några ändringar i din medicinering."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรึกษาผู้เชี่ยวชาญการแพทย์ที่ได้รับอนุญาตเสมอก่อนเปลี่ยนแปลงการใช้ยาของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlaç düzeninde herhangi bir değişiklik yapmadan önce her zaman yetkili bir sağlık uzmanına danış."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luôn hỏi ý kiến chuyên gia y tế có giấy phép trước khi thay đổi bất kỳ chế độ dùng thuốc nào."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "更改用藥方案前，請務必諮詢持牌醫療專業人員。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在对你的用药方案做任何更改之前，请务必咨询有执照的医疗专业人员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在對藥物療程做任何更動前，請務必諮詢有執照的醫療專業人員。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Винаги се консултирайте с правоспособен медицински специалист, преди да правите промени в режима си на прием на лекарства."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prije bilo kakve promjene režima uzimanja lijekova uvijek se posavjetuj s ovlaštenim zdravstvenim djelatnikom."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred akoukoľvek zmenou svojho liečebného režimu sa vždy poraďte so zdravotníckym pracovníkom s príslušným oprávnením."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завжди консультуйтеся з ліцензованим медичним фахівцем, перш ніж вносити будь-які зміни до схеми прийому ліків."
          }
        }
      }
    },
    "Always seek the advice of your physician or another qualified health provider with any questions you may have regarding a medical condition, medication, or treatment.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب دائمًا نصيحة طبيبك أو مقدم رعاية صحية مؤهل حول أي أسئلة قد تكون لديك بخصوص حالة طبية أو دواء أو علاج."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca sempre l'opinió del teu metge o d'un altre professional de la salut qualificat per a qualsevol dubte sobre una condició mèdica, medicació o tractament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vždy vyhledejte radu svého lékaře nebo jiného kvalifikovaného poskytovatele zdravotní péče, pokud máte otázky týkající se zdravotního stavu, léku nebo léčby."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søg altid råd hos din læge eller en anden kvalificeret sundhedsudbyder, hvis du har spørgsmål om en sygdom, medicin eller behandling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte suche bei Fragen zu einer Erkrankung, einem Medikament oder einer Behandlung stets den Rat deiner Ärzt:in oder einer anderen qualifizierten Gesundheitsfachperson."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ζητήστε πάντα τη συμβουλή του/της ιατρού σας ή ενός άλλου εξειδικευμένου επαγγελματία υγείας για οποιεσδήποτε ερωτήσεις σχετικά με μια ιατρική πάθηση, φάρμακο ή θεραπεία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always seek the advice of your physician or another qualified health provider with any questions you may have regarding a medical condition, medication, or treatment."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Always seek the advice of your doctor or another qualified health professional with any questions you may have regarding a medical condition, medicine, or treatment."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Always seek the advice of your doctor or another qualified health provider with any questions you may have regarding a medical condition, medication, or treatment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta siempre a tu médico u otro profesional sanitario cualificado si tienes preguntas sobre una condición médica, un medicamento o un tratamiento."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre busca el consejo de tu médico u otro proveedor de salud calificado si tienes preguntas sobre una condición médica, un medicamento o un tratamiento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همیشه در مورد هر سوالی که دربارهٔ یک بیماری، دارو یا درمان دارید، از پزشک خود یا یک ارائه‌دهنده خدمات بهداشتی واجد شرایط مشورت بگیرید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysy aina lääkäriltäsi tai muulta pätevältä terveydenhuollon ammattilaiselta, jos sinulla on kysymyksiä terveydentilasta, lääkityksestä tai hoidosta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande toujours conseil à ton médecin ou à un autre professionnel de santé qualifié pour toute question concernant un état de santé, un médicament ou un traitement."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulte toujours ton médecin ou un autre professionnel de la santé qualifié pour toute question concernant un problème de santé, un médicament ou un traitement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התייעץ תמיד עם רופאך או עם ספק בריאות מוסמך אחר לגבי כל שאלה בנוגע למצב רפואי, לתרופה או לטיפול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी चिकित्सा स्थिति, दवा, या उपचार के बारे में यदि आपके कोई प्रश्न हों तो हमेशा अपने चिकित्सक या किसी अन्य योग्य स्वास्थ्य प्रदाता से सलाह लें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármilyen kérdésed van egy egészségügyi állapottal, gyógyszerrel vagy kezeléssel kapcsolatban, mindig kérd ki orvosod vagy más képzett egészségügyi szakember tanácsát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selalu minta saran dari dokter atau penyedia layanan kesehatan berkualifikasi jika kamu memiliki pertanyaan mengenai kondisi medis, obat, atau pengobatan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi sempre il parere del tuo medico o di un altro operatore sanitario qualificato per qualunque dubbio relativo a una condizione medica, a un farmaco o a un trattamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "病状、薬、または治療に関して質問がある場合は、必ず担当医師や他の資格のある医療提供者に相談してください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Медицинаға, дәріге немесе емдеу тәсіліне қатысты сұрақтарыңыз болса, дәрігеріңізге немесе басқа білікті медициналық маманға жүгініңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의학적 상태, 약물 또는 치료에 관해 궁금한 점이 있으면 항상 담당 의사나 다른 자격 있는 의료 제공자에게 상담하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentiasa dapatkan nasihat daripada doktor anda atau penyedia kesihatan yang layak jika anda mempunyai sebarang pertanyaan mengenai keadaan perubatan, ubat, atau rawatan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søk alltid råd hos legen din eller en annen kvalifisert helsepersonell hvis du har spørsmål om en medisinsk tilstand, medisin eller behandling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag bij vragen over een medische aandoening, medicatie of behandeling altijd advies aan je huisarts of een andere gekwalificeerde zorgverlener."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze zasięgnij porady lekarza lub innego wykwalifikowanego specjalisty ds. zdrowia, jeśli masz pytania dotyczące stanu zdrowia, leku lub leczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre procure a orientação do seu médico ou de outro profissional de saúde qualificado se tiver dúvidas sobre uma condição médica, medicação ou tratamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Procura sempre o conselho do teu médico ou de outro profissional de saúde qualificado para quaisquer dúvidas que possas ter sobre uma condição médica, medicação ou tratamento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicită întotdeauna sfatul medicului tău sau al unui alt furnizor de sănătate calificat pentru orice întrebări legate de o afecțiune medicală, medicament sau tratament."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда обращайся за советом к своему врачу или другому квалифицированному медицинскому специалисту по любым вопросам, связанным с состоянием здоровья, медикаментами или лечением."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rådgör alltid med din läkare eller annan kvalificerad vårdgivare om du har frågor om ett medicinskt tillstånd, läkemedel eller behandling."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรึกษาแพทย์หรือผู้ให้บริการด้านสุขภาพที่มีคุณสมบัติเหมาะสมเสมอ หากคุณมีคำถามเกี่ยวกับภาวะทางการแพทย์ ยา หรือการรักษา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir tıbbi durum, ilaç veya tedaviyle ilgili soruların varsa her zaman doktoruna veya başka nitelikli bir sağlık uzmanına danış."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luôn tham khảo ý kiến bác sĩ hoặc nhân viên y tế có chuyên môn nếu bạn có thắc mắc liên quan đến tình trạng sức khỏe, thuốc hoặc phương pháp điều trị."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如對病情、藥物或治療有任何疑問，請務必諮詢醫生或其他合資格醫護人員。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如有任何关于病情、药物或治疗的问题，请始终咨询你的主治医师或其他合格的医疗提供者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如有任何關於病況、藥物或治療的疑問，請務必諮詢你的醫師或其他合格的醫療提供者。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Винаги се обръщайте към своя лекар или друг квалифициран медицински специалист при въпроси относно заболяване, лекарство или лечение."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za sva pitanja o zdravstvenom stanju, lijeku ili liječenju uvijek potraži savjet svojeg liječnika ili drugog kvalificiranog zdravstvenog djelatnika."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "S akýmikoľvek otázkami týkajúcimi sa zdravotného stavu, lieku alebo liečby sa vždy obráťte na svojho lekára alebo iného kvalifikovaného zdravotníckeho pracovníka."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завжди звертайтеся до свого лікаря або іншого кваліфікованого медичного фахівця з будь-якими запитаннями щодо стану здоров’я, ліків або лікування."
          }
        }
      }
    },
    "Always seek the advice of your physician or another qualified health provider with any questions you may have regarding a medical condition, medication, or treatment. Never disregard professional medical advice or delay seeking it because of something you have read or recorded in this app.": {
      "comment": "A paragraph explaining the importance of seeking medical advice.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب دائمًا نصيحة طبيبك أو أي مقدم رعاية صحية مؤهل إذا كانت لديك أسئلة حول حالة طبية أو دواء أو علاج. لا تتجاهل أبدًا نصيحة طبية مهنية ولا تؤخر طلبها بسبب ما قرأته أو سجلته في هذا التطبيق."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulteu sempre el vostre metge o un altre professional sanitari qualificat per a qualsevol dubte que tingueu sobre una condició mèdica, medicació o tractament. No ignoreu mai el consell mèdic professional ni endarreriu la seva recerca a causa d'alguna cosa que hàgiu llegit o registrat en aquesta app."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vždy se poraď se svým lékařem nebo jiným kvalifikovaným zdravotnickým odborníkem, pokud máš nějaké otázky týkající se zdravotního stavu, léku nebo léčby. Nikdy neignoruj odbornou lékařskou radu ani neodkládej její vyhledání kvůli něčemu, co jsi v této aplikaci přečetl nebo zaznamenal."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tal altid med din læge eller en anden kvalificeret sundhedsudbyder, hvis du har spørgsmål om en medicinsk tilstand, medicin eller behandling. Ignorer aldrig professionel medicinsk rådgivning eller udsæt at søge den på grund af noget, du har læst eller indtastet i denne app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte wende dich bei Fragen zu einer Erkrankung, Medikamenten oder einer Behandlung an deinen Arzt oder eine andere qualifizierte medizinische Fachkraft. Ignoriere niemals professionelle medizinische Ratschläge und zögere nicht, sie einzuholen – auch nicht aufgrund von Informationen, die du in dieser App gelesen oder aufgezeichnet hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ζητάτε πάντα τη συμβουλή του ιατρού σας ή άλλου εξειδικευμένου επαγγελματία υγείας για οποιεσδήποτε ερωτήσεις έχετε σχετικά με μια ιατρική κατάσταση, φάρμακο ή θεραπεία. Μη αγνοείτε ποτέ επαγγελματική ιατρική συμβουλή και μην καθυστερείτε την αναζήτησή της εξαιτίας κάποιου κειμένου που διαβάσατε ή καταγράψατε σε αυτήν την εφαρμογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always seek the advice of your physician or another qualified health provider with any questions you may have regarding a medical condition, medication, or treatment. Never disregard professional medical advice or delay seeking it because of something you have read or recorded in this app."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Always seek the advice of your physician or another qualified health provider with any questions you may have regarding a medical condition, medication, or treatment. Never disregard professional medical advice or delay seeking it because of something you have read or recorded in this app."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Always seek the advice of your doctor or another qualified health provider with any questions you may have regarding a medical condition, medication, or treatment. Never disregard professional medical advice or delay seeking it because of something you have read or recorded in this app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca siempre el consejo de tu médico u otro profesional sanitario cualificado si tienes alguna pregunta sobre una condición médica, un medicamento o un tratamiento. Nunca ignores el consejo médico profesional ni retrases su búsqueda por algo que hayas leído o registrado en esta app."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre consulta a tu médico o a otro profesional de la salud calificado si tienes preguntas sobre una condición médica, un medicamento o un tratamiento. Nunca ignores el consejo médico profesional ni retrases su búsqueda por algo que hayas leído o registrado en esta app."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همیشه برای هر سوال دربارهٔ وضعیت پزشکی، دارو یا درمان، از پزشک یا ارائه‌دهندهٔ مراقبت‌های بهداشتی واجد شرایط مشورت بگیرید. هرگز توصیهٔ حرفه‌ای پزشکی را نادیده نگیرید یا به‌خاطر چیزی که در این برنامه خوانده‌اید یا ثبت کرده‌اید، در طلب کمک تأخیر نیندازید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysy aina lääkäriltäsi tai muulta pätevältä terveydenhuollon ammattilaiselta neuvoa, jos sinulla on kysymyksiä sairaudesta, lääkityksestä tai hoidosta. Älä koskaan jätä huomioimatta ammatillista lääketieteellistä neuvontaa tai viivytä sen hakemista siksi, mitä olet lukenut tai tallentanut tässä sovelluksessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulte toujours l'avis de ton médecin ou d'un autre professionnel de santé qualifié pour toute question concernant un problème médical, un médicament ou un traitement. Ne néglige jamais un avis médical professionnel et ne reporte pas une consultation à cause de quelque chose que tu aurais lu ou enregistré dans cette app."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulte toujours ton médecin ou un autre professionnel de la santé qualifié pour toute question concernant un problème médical, un médicament ou un traitement. Ne méprise jamais un avis médical professionnel et ne tarde pas à le consulter à cause de quelque chose que tu as lu ou enregistré dans cette app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פנה תמיד לעצת הרופא שלך או לגורם רפואי מוסמך אחר בכל שאלה בנוגע למצב רפואי, לתרופה או לטיפול. אל תתעלם מעצה רפואית מקצועית ואל תתמהמה בבקשת סיוע רפואי בגלל משהו שקראת או רשמת באפליקציה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी मेडिकल स्थिति, दवा या उपचार के संबंध में यदि आपके कोई प्रश्न हों तो हमेशा अपने चिकित्सक या किसी अन्य योग्य स्वास्थ्य प्रदाता से सलाह लें। पेशेवर चिकित्सा सलाह को कभी अनदेखा न करें और न ही इस ऐप में पढ़ी या दर्ज किसी जानकारी के कारण सलाह लेने में देरी करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindig konzultálj kezelőorvosoddal vagy más képzett egészségügyi szakemberrel, ha bármilyen kérdésed van egészségi állapotot, gyógyszert vagy kezelést illetően. Soha ne hagyd figyelmen kívül a szakmai orvosi tanácsot, és ne halaszd el annak megkeresését azért, amit ebben az alkalmazásban olvastál vagy rögzítettél."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selalu minta saran dari dokter Anda atau penyedia kesehatan berkualifikasi lain jika Anda memiliki pertanyaan tentang kondisi medis, obat, atau perawatan. Jangan pernah mengabaikan saran medis profesional atau menunda mencarinya karena sesuatu yang Anda baca atau catat di aplikasi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta sempre il tuo medico o un altro professionista sanitario qualificato per qualsiasi domanda relativa a una condizione medica, a un farmaco o a un trattamento. Non ignorare mai consigli medici professionali né ritardare la loro richiesta a causa di qualcosa che hai letto o registrato in questa app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に主治医または他の資格を持つ医療提供者の助言を求めてください。病状、薬、治療に関して疑問がある場合は必ず相談してください。本アプリで読んだり記録したりした内容のために専門的な医療助言を無視したり、受診を遅らせたりしないでください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Медиалық жағдай, дәрі‑дәрмек немесе емдеу бойынша сұрақтарыңыз болса, әрдайым дәрігеріңізбен немесе басқа білікті медициналық маманмен кеңесіңіз. Бұл қосымшада оқығаныңызға немесе жазып алғаныңызға байланысты кәсіби медициналық кеңесті елемеу немесе оны іздеуді кейінге қалдырмаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의학적 상태, 약물 또는 치료에 대해 궁금한 점이 있으면 항상 주치의나 다른 자격 있는 의료 제공자에게 상담하십시오. 이 앱에서 읽은 내용이나 기록한 정보 때문에 전문적인 의학적 조언을 무시하거나 치료를 미루지 마십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentiasa dapatkan nasihat doktor anda atau penyedia kesihatan lain yang bertauliah jika anda ada sebarang pertanyaan mengenai keadaan perubatan, ubat, atau rawatan. Jangan sekali-kali mengabaikan nasihat perubatan profesional atau menangguhkan mendapatkan bantuan kerana sesuatu yang anda baca atau rekodkan dalam aplikasi ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rådfør deg alltid med legen din eller en annen kvalifisert helsepersonell hvis du har spørsmål om en medisinsk tilstand, medisin eller behandling. Ikke ignorér profesjonell medisinsk rådgivning eller utsett å søke slik hjelp på grunn av noe du har lest eller registrert i denne appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raadpleeg altijd je arts of een andere gekwalificeerde zorgverlener bij vragen over een medische aandoening, medicatie of behandeling. Negeer nooit professioneel medisch advies en stel het zoeken ervan niet uit vanwege iets dat je in deze app hebt gelezen of vastgelegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze skonsultuj się z lekarzem lub innym wykwalifikowanym pracownikiem służby zdrowia, jeśli masz pytania dotyczące stanu zdrowia, leków lub leczenia. Nigdy nie lekceważ fachowej porady medycznej ani nie odkładaj jej zasięgnięcia z powodu informacji, które przeczytałeś(-aś) lub zapisałeś(-aś) w tej aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre consulte o seu médico ou outro profissional de saúde qualificado se tiver qualquer dúvida sobre uma condição médica, medicação ou tratamento. Nunca ignore aconselhamento médico profissional nem demore a procurá‑lo por causa de algo que você tenha lido ou registrado neste app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Procure sempre o conselho do seu médico ou de outro profissional de saúde qualificado para qualquer questão sobre uma condição médica, medicação ou tratamento. Nunca ignore o conselho médico profissional nem adie a sua procura por esse conselho por causa de algo que leu ou registou nesta app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cere întotdeauna sfatul medicului tău sau al unui alt profesionist în sănătate calificat pentru orice întrebări legate de o afecțiune medicală, medicație sau tratament. Nu ignora sfatul medical profesionist și nu întârzia solicitarea acestuia din cauza a ceva ce ai citit sau înregistrat în această aplicație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда обращайся за советом к своему лечащему врачу или другому квалифицированному специалисту по вопросам, касающимся состояния здоровья, лекарств или лечения. Никогда не игнорируй профессиональные медицинские рекомендации и не откладывай обращение за помощью из‑за того, что прочитал или записал в этом приложении."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rådfråga alltid din läkare eller en annan kvalificerad vårdgivare om du har frågor om ett medicinskt tillstånd, medicin eller behandling. Förkasta aldrig professionell medicinsk rådgivning eller vänta med att söka vård på grund av något du läst eller registrerat i den här appen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ควรปรึกษาแพทย์หรือผู้ให้บริการด้านสุขภาพที่มีคุณสมบัติเหมาะสมเสมอหากคุณมีคำถามเกี่ยวกับภาวะทางการแพทย์ ยา หรือการรักษา อย่ามองข้ามคำแนะนำทางการแพทย์จากผู้เชี่ยวชาญหรือเลื่อนการขอความช่วยเหลือเพราะสิ่งที่คุณได้อ่านหรือบันทึกไว้ในแอปนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir tıbbi durum, ilaç veya tedaviyle ilgili sorularınız varsa her zaman doktorunuza veya başka bir nitelikli sağlık uzmanına danışın. Bu uygulamada okuduğunuz veya kaydettiğiniz bir şey yüzünden profesyonel tıbbi tavsiyeyi göz ardı etmeyin veya aramakta gecikmeyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luôn tìm lời khuyên từ bác sĩ của bạn hoặc một nhân viên y tế có trình độ khác nếu bạn có bất kỳ thắc mắc nào về tình trạng sức khỏe, thuốc men hoặc phương pháp điều trị. Không bao giờ phớt lờ lời khuyên y tế chuyên môn hoặc trì hoãn việc tìm kiếm sự trợ giúp chỉ vì một điều bạn đã đọc hoặc ghi lại trong ứng dụng này."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請務必在有任何關於病況、藥物或治療的疑問時，諮詢你的醫生或其他合資格的醫療提供者。不應只因在此應用內讀到或記錄了某些資訊而忽略專業醫療建議或延遲尋求治療。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如有任何关于病情、药物或治疗的问题，请始终咨询你的主治医师或其他有资质的医疗提供者。切勿忽视专业医疗建议，或因为在本应用中阅读或记录的内容而延迟就医。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請務必就任何疾病、藥物或治療相關問題，向你的醫師或其他合格的醫療人員諮詢。不要因為在此應用中看到或記錄的內容而忽視專業醫療建議或延遲就醫。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Винаги се обръщайте към своя лекар или друг квалифициран медицински специалист при въпроси относно заболяване, лекарство или лечение. Никога не пренебрегвайте професионален медицински съвет и не отлагайте търсенето му заради нещо, което сте прочели или записали в това приложение."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za sva pitanja o zdravstvenom stanju, lijeku ili liječenju uvijek potraži savjet svojeg liječnika ili drugog kvalificiranog zdravstvenog djelatnika. Nikada nemoj zanemariti stručni medicinski savjet niti odgađati njegovo traženje zbog nečega što je pročitano ili zabilježeno u ovoj aplikaciji."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "S akýmikoľvek otázkami týkajúcimi sa zdravotného stavu, lieku alebo liečby sa vždy obráťte na svojho lekára alebo iného kvalifikovaného zdravotníckeho pracovníka. Nikdy neignorujte odborné lekárske odporúčania ani neodkladajte ich vyhľadanie pre niečo, čo ste si prečítali alebo zaznamenali v tejto aplikácii."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завжди звертайтеся до свого лікаря або іншого кваліфікованого медичного фахівця з будь-якими запитаннями щодо стану здоров’я, ліків або лікування. Ніколи не нехтуйте професійною медичною порадою та не відкладайте звернення по неї через те, що ви прочитали або записали в цьому застосунку."
          }
        }
      }
    },
