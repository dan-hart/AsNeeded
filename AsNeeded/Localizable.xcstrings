          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NLM te recomienda consultar con un médico cualificado para recibir asesoramiento sobre medicamentos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "NLM te recomienda consultar con un médico calificado para recibir asesoramiento sobre medicamentos."
