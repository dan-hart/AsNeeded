    "healthkit.migration.warning.toAsNeeded": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم استيراد جميع الأدوية وأحداث الجرعات من Apple Health إلى AsNeeded. وسيتم دمج بيانات AsNeeded الحالية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всички лекарства и записи за дози от Apple Health ще бъдат импортирани в AsNeeded. Съществуващите данни в AsNeeded ще бъдат обединени с тях."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tots els medicaments i registres de dosis d’Apple Health s’importaran a AsNeeded. Es combinaran amb les dades existents d’AsNeeded."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny léky a záznamy o dávkách z Apple Health budou importovány do AsNeeded. Stávající data v AsNeeded budou sloučena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Al medicin og alle dosisregistreringer fra Apple Health importeres til AsNeeded. Eksisterende data i AsNeeded flettes sammen med de importerede data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Medikamente und Dosisereignisse aus Apple Health werden in AsNeeded importiert. Vorhandene AsNeeded-Daten werden zusammengeführt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα τα φάρμακα και οι καταγραφές δόσεων από το Apple Health θα εισαχθούν στο AsNeeded. Τα υπάρχοντα δεδομένα του AsNeeded θα συγχωνευτούν."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "All medications and dose events from Apple Health will be imported into AsNeeded. Existing AsNeeded data will be merged."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "All medications and dose events from Apple Health will be imported into AsNeeded. Existing AsNeeded data will be merged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los medicamentos y eventos de dosis de Apple Health se importarán a AsNeeded. Los datos existentes en AsNeeded se fusionarán."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los medicamentos y eventos de dosis de Apple Health se importarán a AsNeeded. Los datos existentes en AsNeeded se combinarán."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه داروها و رویدادهای دوز از Apple Health به AsNeeded وارد خواهند شد. داده‌های موجود AsNeeded ادغام خواهند شد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki lääkkeet ja annostapahtumat Apple Healthista tuodaan AsNeedediin. Olemassa olevat AsNeeded-tiedot yhdistetään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les médicaments et événements de doses d'Apple Health seront importés dans AsNeeded. Les données AsNeeded existantes seront fusionnées."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les médicaments et toutes les prises consignées dans Apple Health seront importés dans AsNeeded. Les données existantes d’AsNeeded seront fusionnées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל התרופות ואירועי נטילת המנות מ־Apple Health ייובאו ל־AsNeeded. הנתונים הקיימים ב־AsNeeded ימוזגו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health से सभी दवाएं और खुराक संबंधी प्रविष्टियां AsNeeded में आयात की जाएंगी। AsNeeded के मौजूदा डेटा को मिला दिया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi lijekovi i zapisi o dozama iz aplikacije Apple Health uvest će se u AsNeeded. Postojeći podaci u aplikaciji AsNeeded spojit će se s uvezenim podacima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Health összes gyógyszere és adagolási eseménye importálásra kerül az AsNeeded alkalmazásba. A meglévő AsNeeded-adatokkal összevonjuk őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua obat dan catatan dosis dari Apple Health akan diimpor ke AsNeeded. Data AsNeeded yang sudah ada akan digabungkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i farmaci e gli eventi di assunzione delle dosi di Salute di Apple verranno importati in AsNeeded. I dati esistenti di AsNeeded verranno uniti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Healthのすべての薬と服薬記録がAsNeededにインポートされます。既存のAsNeededデータと統合されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health қызметіндегі барлық дәрілер мен дозаларды қабылдау жазбалары AsNeeded қолданбасына импортталады. AsNeeded қолданбасындағы бар деректермен біріктіріледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health의 모든 약물과 투약 기록을 AsNeeded로 가져옵니다. 기존 AsNeeded 데이터와 병합됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua ubat dan rekod dos daripada Apple Health akan diimport ke AsNeeded. Data AsNeeded sedia ada akan digabungkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle legemidler og dosehendelser fra Apple Health importeres til AsNeeded. Eksisterende AsNeeded-data slås sammen med de importerte dataene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle medicatie en innamemomenten uit Apple Health worden geïmporteerd in AsNeeded. Bestaande AsNeeded-gegevens worden samengevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie leki i zdarzenia dotyczące dawek z Apple Health zostaną zaimportowane do AsNeeded. Istniejące dane AsNeeded zostaną scalone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os medicamentos e registros de doses do Saúde da Apple serão importados para o AsNeeded. Os dados existentes do AsNeeded serão mesclados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os medicamentos e eventos de doses da aplicação Saúde da Apple serão importados para o AsNeeded. Os dados existentes no AsNeeded serão combinados com os dados importados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate medicamentele și înregistrările dozelor din Apple Health vor fi importate în AsNeeded. Datele existente în AsNeeded vor fi îmbinate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все лекарства и записи о приёмах из Apple Health будут импортированы в AsNeeded. Существующие данные AsNeeded будут объединены с импортированными."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky lieky a záznamy o dávkach z Apple Health sa importujú do AsNeeded. Existujúce údaje v AsNeeded sa zlúčia s importovanými údajmi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla läkemedel och doshändelser från Apple Hälsa importeras till AsNeeded. Befintliga data i AsNeeded slås samman med de importerade uppgifterna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการยาและบันทึกการใช้ยาทั้งหมดจาก Apple Health จะถูกนำเข้าไปยัง AsNeeded โดยจะรวมเข้ากับข้อมูลที่มีอยู่ใน AsNeeded"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health'teki tüm ilaçlar ve doz kayıtları AsNeeded'e aktarılacak. Mevcut AsNeeded verileriyle birleştirilecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі препарати та записи про дози з Apple Health буде імпортовано до AsNeeded. Наявні дані AsNeeded буде об’єднано з імпортованими."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả thuốc và các lần dùng thuốc từ Apple Health sẽ được nhập vào AsNeeded. Dữ liệu AsNeeded hiện có sẽ được hợp nhất."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 中的所有藥物及用藥記錄都會匯入 AsNeeded，並與 AsNeeded 現有的資料合併。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 中的所有药物和用药事件都将导入 AsNeeded，并与 AsNeeded 中的现有数据合并。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 中的所有藥物與用藥紀錄都將匯入 AsNeeded，並與現有的 AsNeeded 資料合併。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All medications and dose events from Apple Health will be imported into AsNeeded. Existing AsNeeded data will be merged."
          }
        }
      }
    },
    "healthkit.migration.warning.toHealthKit": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحذير: سيحل هذا محل بيانات Apple Health الحالية ببيانات من AsNeeded."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Предупреждение: Това ще замени текущите данни на Apple Health с данни от AsNeeded."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Avís: Això reemplaçarà les dades actuals d'Apple Health amb dades d'AsNeeded."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornění: Toto nahradí aktuální data Apple Health daty z AsNeeded."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Advarsel: Dette vil erstatte nuværende Apple Health-data med data fra AsNeeded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnung: Dies ersetzt aktuelle Apple Health-Daten durch Daten aus AsNeeded."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προειδοποίηση: Αυτό θα αντικαταστήσει τα τρέχοντα δεδομένα του Apple Health με δεδομένα από το AsNeeded."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "All medications and dose events currently in AsNeeded will be copied to Apple Health. Existing Health data won't be modified."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "All medications and dose events currently in AsNeeded will be copied to Apple Health. Existing Health data won't be modified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los medicamentos y eventos de dosis actualmente en AsNeeded se copiarán a Apple Health. Los datos existentes en Salud no se modificarán."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los medicamentos y eventos de dosis actualmente en AsNeeded se copiarán a Apple Health. Los datos existentes en Salud no se modificarán."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه داروها و رویدادهای دوز موجود در AsNeeded به Apple Health کپی خواهند شد. داده‌های موجود سلامت تغییر نخواهند کرد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki lääkkeet ja annostapahtumat AsNeededissä kopioidaan Apple Healthiin. Olemassa olevia Terveys-tietoja ei muokata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les médicaments et événements de doses actuellement dans AsNeeded seront copiés vers Apple Health. Les données Santé existantes ne seront pas modifiées."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela copiera toutes vos données AsNeeded vers Santé. Assurez-vous d'avoir suffisamment de stockage iCloud si vous avez un historique de médicaments volumineux."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה יעתיק את כל נתוני ה-AsNeeded שלך ל-Health. ודא שיש לך מספיק שטח אחסון iCloud אם יש לך היסטוריית תרופות גדולה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपके सभी AsNeeded डेटा को Health पर कॉपी करेगा। यदि आपके पास बड़ा दवा इतिहास है तो सुनिश्चित करें कि आपके पास पर्याप्त iCloud स्टोरेज है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo će kopirati sve tvoje AsNeeded podatke u Health. Uvjeri se da imaš dovoljno iCloud prostora ako imaš veliku povijest lijekova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az összes AsNeeded adatát átmásolja a Health alkalmazásba. Győződjön meg arról, hogy elegendő iCloud-tárhelye van, ha nagy a gyógyszerelőzménye."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menyalin semua data AsNeeded Anda ke Health. Pastikan Anda memiliki penyimpanan iCloud yang cukup jika Anda memiliki riwayat obat yang besar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo copierà tutti i tuoi dati di AsNeeded su Salute. Assicurati di avere abbastanza spazio di archiviazione iCloud se hai una vasta cronologia dei farmaci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのAsNeededデータをHealthにコピーします。大量のお薬履歴がある場合は、十分なiCloudストレージがあることを確認してください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қазір AsNeeded қолданбасындағы барлық дәрілер мен дозаларды қабылдау жазбалары Apple Health қызметіне көшіріледі. Денсаулық қолданбасындағы бар деректер өзгертілмейді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 AsNeeded 데이터를 Health에 복사합니다. 대량의 약물 기록이 있는 경우 충분한 iCloud 저장 공간이 있는지 확인하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menyalin semua data AsNeeded anda ke Health. Pastikan anda mempunyai storan iCloud yang mencukupi jika anda mempunyai sejarah ubat yang besar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil kopiere alle AsNeeded-dataene dine til Health. Sørg for at du har nok iCloud-lagring hvis du har en stor medisinhistorikk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zal al je AsNeeded-gegevens naar Health kopiëren. Zorg ervoor dat je genoeg iCloud-opslag hebt als je een grote medicatiegeschiedenis hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to skopiowanie wszystkich danych AsNeeded do Zdrowia. Upewnij się, że masz wystarczającą ilość miejsca w iCloud, jeśli masz dużą historię leków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso copiará todos os seus dados do AsNeeded para o Saúde. Certifique-se de ter armazenamento iCloud suficiente se tiver um histórico grande de medicamentos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os medicamentos e eventos de doses atualmente no AsNeeded serão copiados para a aplicação Saúde da Apple. Os dados existentes na aplicação Saúde não serão alterados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate medicamentele și înregistrările dozelor aflate în prezent în AsNeeded vor fi copiate în Apple Health. Datele existente în Health nu vor fi modificate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все лекарства и записи о приёмах, которые сейчас есть в AsNeeded, будут скопированы в Apple Health. Существующие данные Apple Health не будут изменены."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky lieky a záznamy o dávkach, ktoré sú momentálne v AsNeeded, sa skopírujú do Apple Health. Existujúce údaje v Apple Health sa nezmenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla läkemedel och doshändelser som för närvarande finns i AsNeeded kopieras till Apple Hälsa. Befintliga data i Hälsa ändras inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการยาและบันทึกการใช้ยาทั้งหมดที่อยู่ใน AsNeeded ขณะนี้จะถูกคัดลอกไปยัง Apple Health ข้อมูลสุขภาพที่มีอยู่จะไม่ถูกแก้ไข"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, AsNeeded'teki mevcut verilerinizin yerine geçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це замінить ваші існуючі дані в AsNeeded."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều này sẽ thay thế dữ liệu hiện có của bạn trong AsNeeded."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded 目前的所有藥物及用藥記錄都會複製至 Apple Health。現有的健康資料不會被修改。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将替换您在 AsNeeded 中的现有数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將取代您在 AsNeeded 中的現有資料。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All medications and dose events currently in AsNeeded will be copied to Apple Health. Existing Health data won't be modified."
          }
        }
      }
    },
