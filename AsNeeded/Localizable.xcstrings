    "Open AsNeeded on your nearby iPhone. Changes made offline wait to sync.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre AsNeeded en tu iPhone cercano. Los cambios realizados sin conexión quedan pendientes de sincronización."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne AsNeeded auf deinem iPhone in der Nähe. Offline vorgenommene Änderungen warten auf die Synchronisierung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez AsNeeded sur votre iPhone à proximité. Les modifications effectuées hors ligne restent en attente de synchronisation."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح AsNeeded على جهاز iPhone القريب منك. تنتظر التغييرات التي أُجريت دون اتصال حتى تتم مزامنتها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח את AsNeeded ב־iPhone הסמוך שלך. שינויים שבוצעו ללא חיבור לאינטרנט ממתינים לסנכרון."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "AsNeeded را در iPhone نزدیک خود باز کنید. تغییرات آفلاین تا زمان همگام‌سازی منتظر می‌مانند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くのiPhoneでAsNeededを開いてください。オフラインでの変更は同期待ちになります。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворете AsNeeded на своя iPhone наблизо. Промените, направени офлайн, изчакват синхронизиране."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre AsNeeded a l’iPhone que tens a prop. Els canvis fets sense connexió queden pendents de sincronització."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete AsNeeded na svém iPhonu v blízkosti. Změny provedené bez připojení čekají na synchronizaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn AsNeeded på din iPhone i nærheden. Ændringer foretaget uden internetforbindelse venter på at blive synkroniseret."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε το AsNeeded στο κοντινό σας iPhone. Οι αλλαγές που έγιναν εκτός σύνδεσης περιμένουν να συγχρονιστούν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open AsNeeded on your nearby iPhone. Changes made offline wait to sync."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Open AsNeeded on your nearby iPhone. Changes made offline wait to sync."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Open AsNeeded on your nearby iPhone. Changes made offline wait to sync."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre AsNeeded en tu iPhone cercano. Los cambios realizados sin conexión quedan pendientes de sincronización."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa AsNeeded lähellä olevassa iPhonessasi. Ilman verkkoyhteyttä tehdyt muutokset odottavat synkronointia."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez AsNeeded sur votre iPhone à proximité. Les modifications effectuées hors ligne seront synchronisées plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पास के iPhone पर AsNeeded खोलें। ऑफ़लाइन किए गए बदलाव सिंक होने की प्रतीक्षा करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite AsNeeded na obližnjem iPhoneu. Promjene napravljene izvan mreže čekaju sinkronizaciju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyissa meg az AsNeeded alkalmazást a közelben lévő iPhone-on. Az offline végzett módosítások szinkronizálásra várnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka AsNeeded di iPhone Anda yang berada di dekat Anda. Perubahan yang dibuat saat luring menunggu untuk disinkronkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri AsNeeded sul tuo iPhone nelle vicinanze. Le modifiche effettuate senza connessione restano in attesa di sincronizzazione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жақын жердегі iPhone құрылғыңызда AsNeeded қолданбасын ашыңыз. Интернетсіз енгізілген өзгерістер синхрондауды күтеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근처의 iPhone에서 AsNeeded를 여세요. 오프라인에서 변경한 내용은 동기화될 때까지 대기합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
