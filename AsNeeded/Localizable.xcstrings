        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan pengingat Anda tidak dapat diperbarui. Silakan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile aggiornare le impostazioni dei promemoria. Riprova."
