    "You control and can delete backups anytime": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú controlas las copias de seguridad y puedes eliminarlas en cualquier momento"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du behältst die Kontrolle und kannst Sicherungen jederzeit löschen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous gérez vos sauvegardes et pouvez les supprimer à tout moment"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تتحكم في النسخ الاحتياطية ويمكنك حذفها في أي وقت"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגיבויים בשליטתך וניתן למחוק אותם בכל עת"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کنترل نسخه‌های پشتیبان در دست شماست و هر زمان می‌توانید آن‌ها را حذف کنید"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップはご自身で管理でき、いつでも削除できます"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вие управлявате резервните копия и можете да ги изтриете по всяко време"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu controles les còpies de seguretat i les pots suprimir quan vulguis"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zálohy máte pod kontrolou a můžete je kdykoli smazat"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har kontrollen og kan slette sikkerhedskopier når som helst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχετε τον έλεγχο των αντιγράφων ασφαλείας και μπορείτε να τα διαγράψετε οποιαδήποτε στιγμή"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You control and can delete backups anytime"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You control and can delete backups anytime"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You control and can delete backups any time"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú controlas las copias de seguridad y puedes eliminarlas en cualquier momento"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallitset varmuuskopioitasi ja voit poistaa ne milloin tahansa"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous gardez le contrôle des sauvegardes et pouvez les supprimer en tout temps"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकअप पर आपका नियंत्रण है और आप उन्हें कभी भी मिटा सकते हैं"
          }
