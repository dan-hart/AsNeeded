    "%@ must be zero or a positive, finite number. Leave it blank if unknown.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ debe ser cero o un número positivo y finito. Deja el campo en blanco si no lo sabes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muss null oder eine positive, endliche Zahl sein. Lassen Sie das Feld leer, wenn der Wert unbekannt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doit être égal à zéro ou être un nombre fini strictement positif. Laissez ce champ vide si la valeur est inconnue."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تكون قيمة %@ صفرًا أو عددًا موجبًا ومحدودًا. اترك الحقل فارغًا إذا كانت غير معروفة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ חייב להיות אפס או מספר חיובי וסופי. אם הערך אינו ידוע, יש להשאיר את השדה ריק."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ باید صفر یا عددی مثبت و متناهی باشد. اگر مشخص نیست، آن را خالی بگذارید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@には、0または正の有限数を入力してください。不明な場合は空欄にしてください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ трябва да е нула или положително крайно число. Оставете полето празно, ако стойността е неизвестна."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha de ser zero o un nombre positiu i finit. Deixa el camp en blanc si no ho saps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodnota %@ musí být nula nebo kladné konečné číslo. Pokud ji neznáte, nechte pole prázdné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ skal være nul eller et positivt, endeligt tal. Lad feltet stå tomt, hvis værdien er ukendt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πεδίο %@ πρέπει να είναι μηδέν ή θετικός, πεπερασμένος αριθμός. Αφήστε το κενό αν η τιμή είναι άγνωστη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ must be zero or a positive, finite number. Leave it blank if unknown."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ must be zero or a positive, finite number. Leave it blank if unknown."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ must be zero or a positive, finite number. Leave it blank if unknown."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ debe ser cero o un número positivo y finito. Deja el campo en blanco si no lo sabes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kentän %@ arvon on oltava nolla tai positiivinen, äärellinen luku. Jätä kenttä tyhjäksi, jos arvo ei ole tiedossa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doit être zéro ou un nombre fini strictement positif. Laissez ce champ vide si la valeur est inconnue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ शून्य या एक धनात्मक, परिमित संख्या होनी चाहिए। यदि ज्ञात न हो, तो इसे खाली छोड़ दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mora biti nula ili pozitivan, konačan broj. Ostavite prazno ako nije poznato."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ értékének nullának vagy pozitív, véges számnak kell lennie. Hagyja üresen, ha nem ismert."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ harus berupa nol atau angka positif yang berhingga. Biarkan kosong jika tidak diketahui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deve essere zero o un numero positivo e finito. Lascia il campo vuoto se il valore è sconosciuto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ нөл немесе оң әрі шекті сан болуы керек. Белгісіз болса, бос қалдырыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 값은 0 또는 유한한 양수여야 합니다. 모르는 경우 비워 두세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mestilah sifar atau nombor positif dan terhingga. Biarkan kosong jika tidak diketahui."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ må være null eller et positivt, endelig tall. La feltet stå tomt hvis verdien er ukjent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ moet nul of een positief, eindig getal zijn. Laat dit leeg als het onbekend is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ musi być zerem lub dodatnią, skończoną liczbą. Pozostaw pole puste, jeśli wartość jest nieznana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deve ser zero ou um número positivo e finito. Deixe em branco se não souber."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tem de ser zero ou um número positivo e finito. Deixe em branco se não souber."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ trebuie să fie zero sau un număr pozitiv și finit. Lasă câmpul gol dacă valoarea nu este cunoscută."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значение «%@» должно быть нулём или положительным конечным числом. Оставьте поле пустым, если значение неизвестно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ musí byť nula alebo kladné, konečné číslo. Ak hodnotu nepoznáte, nechajte pole prázdne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ måste vara noll eller ett positivt, ändligt tal. Lämna fältet tomt om värdet är okänt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ต้องเป็นศูนย์หรือจำนวนบวกที่มีค่าจำกัด เว้นว่างไว้หากไม่ทราบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sıfır veya pozitif ve sonlu bir sayı olmalıdır. Bilinmiyorsa boş bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Значення «%@» має бути нулем або додатним скінченним числом. Залиште поле порожнім, якщо значення невідоме."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ phải bằng không hoặc là một số dương, hữu hạn. Để trống nếu không biết."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 必須是零或大於零的有限數值。如不清楚，請留空。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 必须为零或有限正数。如果未知，请留空。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 必須是零或大於零的有限數值。若不確定，請留白。"
          }
        }
      }
    },
