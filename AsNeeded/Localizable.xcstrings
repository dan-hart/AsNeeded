    "healthkit.sync.mode.healthKitSOT.desc": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحكم Apple Health في بيانات الأدوية الخاصة بك. يستورد AsNeeded البيانات ولكن لا يمكنه إجراء تغييرات."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health контролира данните за вашите лекарства. AsNeeded импортира данни, но не може да прави промени."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health controla les teves dades de medicaments. AsNeeded importa dades però no pot fer canvis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health řídí data o vašich lécích. AsNeeded importuje data, ale nemůže provádět změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health styrer dine medicindata. AsNeeded importerer data, men kan ikke foretage ændringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health steuert Ihre Medikamentendaten. AsNeeded importiert Daten, kann aber keine Änderungen vornehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple Health ελέγχει τα δεδομένα των φαρμάκων σας. Το AsNeeded εισάγει δεδομένα αλλά δεν μπορεί να κάνει αλλαγές."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage medications in Apple Health, view in AsNeeded"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage medications in Apple Health, view in AsNeeded"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona los medicamentos en Apple Health, visualízalos en AsNeeded"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Administra los medicamentos en Apple Health, visualízalos en AsNeeded"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داروها را در Apple Health مدیریت کنید، در AsNeeded مشاهده کنید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallitse lääkkeitä Apple Healthissa, tarkastele AsNeededissä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez les médicaments dans Apple Health, consultez-les dans AsNeeded"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez les médicaments dans Apple Santé, consultez dans AsNeeded"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נהל תרופות ב-Apple Health, צפה ב-AsNeeded"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health में दवाओं का प्रबंधन करें, AsNeeded में देखें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravljaj lijekovima u Apple Health, pregledaj u AsNeeded"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyógyszerek kezelése az Apple Health alkalmazásban, megtekintés az AsNeeded alkalmazásban"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelola obat di Apple Health, lihat di AsNeeded"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci i farmaci in Apple Health, visualizza in AsNeeded"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Healthでお薬を管理し、AsNeededで表示"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дәрілерді Apple Health қызметінде басқарып, AsNeeded қолданбасында қараңыз"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health에서 약물 관리, AsNeeded에서 보기"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Urus ubat dalam Apple Health, lihat dalam AsNeeded"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrer medisiner i Apple Health, vis i AsNeeded"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer medicijnen in Apple Health, bekijk in AsNeeded"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarządzaj lekami w Apple Health, przeglądaj w AsNeeded"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie medicamentos no Apple Health, visualize no AsNeeded"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Health é a fonte principal; AsNeeded reflete os dados da Saúde"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health este sursa principală; AsNeeded reflectă datele din Sănătate"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health является основным источником; AsNeeded отражает данные из Здоровья"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health je hlavný zdroj; AsNeeded odráža údaje zo Zdravia"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health är den primära källan; AsNeeded återspeglar Hälsa-data"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health เป็นแหล่งหลัก AsNeeded สะท้อนข้อมูลจากสุขภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health ana kaynaktır. AsNeeded, Health'teki değişiklikleri yansıtır ancak yerel düzenlemelere izin vermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health є джерелом істини. AsNeeded відображає зміни з Health, але не дозволяє локальні редагування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health là nguồn chính thống. AsNeeded phản ánh thay đổi từ Health nhưng không cho phép chỉnh sửa cục bộ."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple Health 中管理藥物，並在 AsNeeded 中查看"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 是真实来源。AsNeeded 反映健康中的更改，但不允许本地编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 是真實來源。AsNeeded 反映健康中的更改，但不允許本機編輯。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage medications in Apple Health, view in AsNeeded"
          }
        }
      }
    },
