        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "NLM et recomana consultar un metge qualificat per aconsellament sobre medicaments."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "NLM vás vyzývá, abyste se poradili s kvalifikovaným lékařem ohledně léků."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "NLM opfordrer dig til at konsultere en kvalificeret læge for rådgivning om medicin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NLM empfiehlt, dass du dich für Medikationsrat an eine qualifizierte Ärztin oder einen qualifizierten Arzt wendest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το NLM σε προτρέπει να συμβουλευτείς έναν εξειδικευμένο γιατρό για συμβουλές σχετικά με τα φάρμακα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NLM urges you to consult with a qualified physician for advice about medications."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "NLM urges you to consult with a qualified physician for advice about medications."
          }
