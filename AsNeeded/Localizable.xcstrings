    ". Follow your prescription and care instructions.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ". Sigue tu prescripción y las instrucciones de cuidado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ". Befolgen Sie Ihre Verordnung und die Anweisungen zu Ihrer Behandlung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ". Suivez votre ordonnance et les consignes de soins."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": ". اتبع وصفتك الطبية وتعليمات الرعاية الخاصة بك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": ". יש לפעול לפי המרשם והוראות הטיפול שלך."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": ". از نسخه و دستورالعمل‌های مراقبتی خود پیروی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "。処方および療養上の指示に従ってください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": ". Следвайте предписанието си и указанията за грижи."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": ". Segueix la prescripció i les instruccions d’atenció mèdica."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": ". Dodržujte předepsané dávkování a pokyny k péči."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": ". Følg din ordination og dine behandlingsanvisninger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": ". Ακολουθήστε τη συνταγή σας και τις οδηγίες φροντίδας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ". Follow your prescription and care instructions."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": ". Follow your prescription and care instructions."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": ". Follow your prescription and care instructions."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": ". Sigue tu receta y las indicaciones de cuidado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": ". Noudata lääkemääräystäsi ja hoito-ohjeitasi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": ". Respectez votre ordonnance et vos consignes de soins."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ". अपने नुस्खे और देखभाल संबंधी निर्देशों का पालन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": ". Pridržavajte se propisane terapije i uputa za skrb."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": ". Kövesse az orvosi rendelvényben és az ellátása során kapott utasításokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ". Ikuti resep dan petunjuk perawatan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ". Segui la prescrizione e le indicazioni di cura."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": ". Дәрігердің тағайындауын және күтім жөніндегі нұсқауларды орындаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ". 처방과 관리 지침을 따르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": ". Ikuti preskripsi dan arahan penjagaan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ". Følg forskrivningen og behandlingsinstruksjonene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ". Volg je voorschrift en zorginstructies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ". Stosuj się do zaleceń dotyczących przepisanych leków i opieki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ". Siga sua prescrição e as orientações de cuidado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": ". Siga a sua prescrição e as instruções de cuidados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": ". Respectă prescripția medicală și instrucțiunile de îngrijire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ". Следуйте назначению врача и указаниям по уходу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": ". Dodržiavajte predpísané dávkovanie a pokyny týkajúce sa starostlivosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ". Följ din ordination och dina vårdinstruktioner."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ". ปฏิบัติตามใบสั่งยาและคำแนะนำในการดูแลของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ". Reçetenizdeki ve bakım talimatlarınızdaki yönergelere uyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": ". Дотримуйтеся призначень лікаря та вказівок щодо догляду."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ". Hãy tuân thủ đơn thuốc và hướng dẫn chăm sóc của bạn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "。請遵照處方及護理指示。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "。请遵循您的处方和护理指导。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "。請遵循處方及照護指示。"
          }
        }
      }
