        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下這裡，為此藥物選擇顏色與圖示。您可以選擇是否自訂。"
          }
        }
      }
    },
    "Tap the date and time to choose when you took it, or use a quick time below.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la fecha y la hora para elegir cuándo lo tomaste, o usa una de las opciones rápidas de abajo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Datum und Uhrzeit, um auszuwählen, wann du es eingenommen hast, oder nutze unten eine der Zeit-Schnellauswahlen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la date et l’heure pour choisir le moment de la prise, ou utilisez un horaire prédéfini ci-dessous."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على التاريخ والوقت لاختيار وقت تناولك للدواء، أو استخدم أحد الأوقات السريعة أدناه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להקיש על התאריך והשעה כדי לבחור מתי נלקחה התרופה, או להשתמש באחת מאפשרויות הזמן המהירות למטה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای انتخاب زمان مصرف، روی تاریخ و زمان بزنید یا از یکی از زمان‌های سریع زیر استفاده کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日時をタップして服用した時刻を選択するか、下のクイック時刻設定を使用してください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете датата и часа, за да изберете кога сте го приели, или използвайте някой от готовите варианти за час по-долу."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la data i l'hora per triar quan l'has pres, o fes servir una de les hores ràpides de sota."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na datum a čas vyberte, kdy jste lék užili, nebo použijte rychlou volbu času níže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på datoen og tidspunktet for at vælge, hvornår du tog medicinen, eller brug et af de forudindstillede tidspunkter nedenfor."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε την ημερομηνία και την ώρα για να επιλέξετε πότε το πήρατε ή χρησιμοποιήστε μία από τις γρήγορες επιλογές ώρας παρακάτω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the date and time to choose when you took it, or use a quick time below."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the date and time to choose when you took it, or use a quick time below."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the date and time to choose when you took it, or use a quick time below."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la fecha y la hora para elegir cuándo lo tomaste, o usa una de las opciones rápidas de abajo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse lääkkeen ottamisajankohta napauttamalla päivämäärää ja kellonaikaa tai käytä alla olevaa pikavalintaa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la date et l’heure pour choisir le moment où vous l’avez pris, ou utilisez une heure prédéfinie ci-dessous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने इसे कब लिया था, यह चुनने के लिए तारीख और समय पर टैप करें, या नीचे दिए गए त्वरित समय विकल्प का उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite datum i vrijeme kako biste odabrali kada ste uzeli lijek ili upotrijebite jedan od brzih odabira vremena u nastavku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a dátumra és az időre annak megadásához, hogy mikor vetted be, vagy válassz az alábbi gyors időpontok közül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tanggal dan waktu untuk memilih kapan Anda menggunakan obat ini, atau gunakan pilihan waktu cepat di bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la data e l’ora per scegliere quando l’hai assunto, oppure usa uno degli orari rapidi qui sotto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дәріні қашан қабылдағаныңызды таңдау үшін күн мен уақытты түртіңіз немесе төмендегі дайын уақыт нұсқасын пайдаланыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜와 시간을 탭하여 복용 시점을 선택하거나 아래의 빠른 시간 선택을 사용하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik tarikh dan masa untuk memilih waktu anda mengambilnya, atau gunakan pilihan masa pantas di bawah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på datoen og klokkeslettet for å velge når du tok det, eller bruk et av hurtigvalgene nedenfor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de datum en tijd om te kiezen wanneer je de medicatie hebt ingenomen, of gebruik hieronder een tijdssnelkeuze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij datę i godzinę, aby wybrać czas przyjęcia leku, lub skorzystaj z jednej z poniższych opcji szybkiego wyboru czasu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na data e na hora para escolher quando você tomou o medicamento ou use uma das opções rápidas de horário abaixo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na data e na hora para escolher quando tomou o medicamento ou use uma das opções rápidas de hora abaixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge data și ora pentru a alege când ai luat medicamentul sau folosește una dintre opțiunile rapide de timp de mai jos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на дату и время, чтобы указать, когда вы приняли лекарство, или выберите готовый вариант времени ниже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na dátum a čas vyberte, kedy ste liek užili, alebo použite niektorý z predvolených časov nižšie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på datum och tid för att välja när du tog det, eller använd en snabbtid nedan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะวันที่และเวลาเพื่อเลือกเวลาที่คุณใช้ยา หรือใช้ตัวเลือกเวลาด่วนด้านล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlacı ne zaman aldığınızı seçmek için tarih ve saate dokunun veya aşağıdaki hızlı zaman seçeneklerinden birini kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться дати й часу, щоб указати час прийому, або скористайтеся швидким вибором часу нижче."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào ngày và giờ để chọn thời điểm bạn đã dùng thuốc, hoặc dùng một thời điểm chọn nhanh bên dưới."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下日期和時間，選擇你的用藥時間，或使用下方的快捷時間選項。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点日期和时间，选择实际用药时间，或使用下方的快捷时间选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下日期與時間，選擇您的用藥時間，或使用下方的快速時間選項。"
          }
        }
      }
    },
