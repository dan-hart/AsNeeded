    "Couldn’t confirm saving. Check iPhone before trying again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido confirmar que se haya guardado. Compruébalo en el iPhone antes de volver a intentarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Speichern konnte nicht bestätigt werden. Prüfe dein iPhone, bevor du es erneut versuchst."
