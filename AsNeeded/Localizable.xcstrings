            "value": "Không thể cập nhật cài đặt nhắc nhở của bạn. Vui lòng thử lại."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "未能更新你的提醒設定。請再試一次。"
