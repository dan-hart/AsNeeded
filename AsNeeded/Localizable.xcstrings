    "Each option includes a preview. Select a font to use it in the app.": {
      "comment": "Description for font family picker",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada opción incluye una vista previa. Selecciona un tipo de letra para usarlo en la aplicación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Option enthält eine Vorschau. Wähle eine Schriftart aus, um sie in der App zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque option comprend un aperçu. Sélectionnez une police pour l’utiliser dans l’app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتضمّن كل خيار معاينة. اختر خطًا لاستخدامه في التطبيق."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל אפשרות כוללת תצוגה מקדימה. יש לבחור גופן לשימוש באפליקציה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر گزینه یک پیش‌نمایش دارد. قلمی را برای استفاده در برنامه انتخاب کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各選択肢にはプレビューがあります。アプリで使用するフォントを選択してください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всяка опция включва предварителен преглед. Изберете шрифт, за да го използвате в приложението."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada opció inclou una previsualització. Selecciona un tipus de lletra per utilitzar-lo a l’app."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá možnost obsahuje náhled. Vyberte písmo, které chcete v aplikaci používat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver mulighed indeholder en forhåndsvisning. Vælg en skrifttype for at bruge den i appen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε επιλογή περιλαμβάνει προεπισκόπηση. Επιλέξτε μια γραμματοσειρά για να τη χρησιμοποιήσετε στην εφαρμογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each option includes a preview. Select a font to use it in the app."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Each option includes a preview. Select a font to use it in the app."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Each option includes a preview. Select a font to use it in the app."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada opción incluye una vista previa. Selecciona una fuente para usarla en la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokaisesta vaihtoehdosta on esikatselu. Ota fontti käyttöön sovelluksessa valitsemalla se."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque option comprend un aperçu. Sélectionnez une police pour l’utiliser dans l’app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर विकल्प में एक पूर्वावलोकन शामिल है। ऐप में उपयोग करने के लिए फ़ॉन्ट चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka opcija uključuje pretpregled. Odaberite font koji želite koristiti u aplikaciji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden lehetőséghez előnézet tartozik. Válasszon betűtípust az alkalmazáshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
