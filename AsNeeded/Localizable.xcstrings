            "value": "En espera de sincronización con el iPhone. No vuelvas a registrar esta dosis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odotetaan synkronointia iPhonen kanssa. Älä kirjaa tätä annosta uudelleen."
          }
