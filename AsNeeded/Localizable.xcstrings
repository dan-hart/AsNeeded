        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обновить настройки напоминаний. Повторите попытку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavenia vašich pripomienok sa nepodarilo aktualizovať. Skúste to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina påminnelseinställningar kunde inte uppdateras. Försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถอัปเดตการตั้งค่าการเตือนของคุณได้ โปรดลองอีกครั้ง"
