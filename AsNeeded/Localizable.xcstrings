    "No doses recorded in this range. Choose another range or open History to review your entries.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay dosis registradas en este periodo. Elige otro periodo o abre el historial para revisar tus registros."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Zeitraum wurden keine Dosen erfasst. Wähle einen anderen Zeitraum oder öffne den Verlauf, um deine Einträge zu prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune dose enregistrée sur cette période. Choisissez une autre période ou ouvrez l’historique pour consulter vos saisies."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد جرعات مسجلة في هذه الفترة. اختر فترة أخرى أو افتح السجل لمراجعة إدخالاتك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נרשמו מנות בטווח הזה. ניתן לבחור טווח אחר או לפתוח את ההיסטוריה לעיון ברישומים שלך."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ دوزی در این بازه ثبت نشده است. بازهٔ دیگری انتخاب کنید یا برای بررسی موارد ثبت‌شده، تاریخچه را باز کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間の投与記録はありません。別の期間を選択するか、履歴を開いて記録を確認してください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма записани дози за този период. Изберете друг период или отворете История, за да прегледате записите си."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hi ha dosis registrades en aquest període. Tria un altre període o obre l’historial per revisar les teves entrades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V tomto období nejsou zaznamenány žádné dávky. Zvolte jiné období nebo otevřete historii a prohlédněte si své záznamy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen doser registreret i denne periode. Vælg en anden periode, eller åbn Historik for at gennemgå dine registreringer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν καταγράφηκαν δόσεις σε αυτή την περίοδο. Επιλέξτε άλλη περίοδο ή ανοίξτε το Ιστορικό για να ελέγξετε τις καταχωρίσεις σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No doses recorded in this range. Choose another range or open History to review your entries."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "No doses recorded in this range. Choose another range or open History to review your entries."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "No doses recorded in this range. Choose another range or open History to review your entries."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay dosis registradas en este rango. Elige otro rango o abre el historial para revisar tus registros."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tälle ajanjaksolle ei ole kirjattu annoksia. Valitse toinen ajanjakso tai tarkastele kirjauksiasi avaamalla historia."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune dose enregistrée pour cette période. Choisissez une autre période ou ouvrez l’historique pour consulter vos entrées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस अवधि में कोई खुराक दर्ज नहीं की गई है। दूसरी अवधि चुनें या अपनी प्रविष्टियाँ देखने के लिए इतिहास खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U ovom razdoblju nema zabilježenih doza. Odaberite drugo razdoblje ili otvorite povijest kako biste pregledali unose."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebben az időszakban nincsenek rögzített adagok. Válasszon másik időszakot, vagy nyissa meg az Előzményeket a bejegyzések áttekintéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada dosis yang dicatat dalam rentang ini. Pilih rentang lain atau buka Riwayat untuk meninjau catatan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna dose registrata in questo periodo. Scegli un altro periodo o apri la cronologia per esaminare le registrazioni."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл уақыт аралығында дозалар тіркелмеген. Басқа уақыт аралығын таңдаңыз немесе жазбаларыңызды қарап шығу үшін Тарих бөлімін ашыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기간에는 복용 기록이 없습니다. 다른 기간을 선택하거나 이력을 열어 기록을 검토하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada dos direkodkan dalam julat ini. Pilih julat lain atau buka Sejarah untuk menyemak entri anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen doser er registrert i denne perioden. Velg en annen periode eller åpne Historikk for å se gjennom oppføringene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen doses geregistreerd in deze periode. Kies een andere periode of open Geschiedenis om je registraties te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zapisano dawek w tym okresie. Wybierz inny okres lub otwórz Historię, aby przejrzeć wpisy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma dose registrada neste período. Escolha outro período ou abra o Histórico para revisar seus registros."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há doses registadas neste período. Escolha outro período ou abra o Histórico para rever os seus registos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu sunt înregistrate doze în această perioadă. Alege altă perioadă sau deschide istoricul pentru a verifica înregistrările."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За этот период нет записей о приёме. Выберите другой период или откройте «Историю», чтобы просмотреть записи."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V tomto období nie sú zaznamenané žiadne dávky. Vyberte iné obdobie alebo otvorte Históriu a skontrolujte svoje záznamy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga doser har registrerats under den här perioden. Välj en annan period eller öppna Historik för att granska dina poster."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีบันทึกการใช้ยาในช่วงนี้ เลือกช่วงอื่นหรือเปิดประวัติเพื่อตรวจสอบรายการของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aralıkta doz kaydedilmemiş. Başka bir aralık seçin veya kayıtlarınızı gözden geçirmek için Geçmişi açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
