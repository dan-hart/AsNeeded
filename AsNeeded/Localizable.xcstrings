          "stringUnit": {
            "state": "translated",
            "value": "Загальна дозволена кількість за будь-які 24 години, включно з наступною дозою. Відлік не починається заново опівночі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổng lượng được phép dùng trong bất kỳ khoảng 24 giờ nào, bao gồm cả liều tiếp theo. Giới hạn này không đặt lại vào nửa đêm."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "任何連續 24 小時內允許的總用量，包括下一次劑量。此數值不會在午夜重設。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任意连续 24 小时内允许的总用量，包括下一次用药。此用量不会在午夜重置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任意連續 24 小時內允許的總用量，包含下一次用藥。此用量不會在午夜歸零。"
          }
        }
      }
    },
