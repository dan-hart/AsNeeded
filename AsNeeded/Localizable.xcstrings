    "Use the instructions from your prescription or care team. Every field is optional.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa las instrucciones de tu receta o de tu equipo de atención médica. Todos los campos son opcionales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende die Anweisungen aus deiner Verordnung oder von deinem Behandlungsteam. Alle Felder sind optional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les consignes de votre ordonnance ou de votre équipe soignante. Tous les champs sont facultatifs."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتبع التعليمات الواردة في وصفتك الطبية أو من فريق رعايتك. جميع الحقول اختيارية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להשתמש בהנחיות שבמרשם שלך או בהנחיות הצוות המטפל. כל השדות הם אופציונליים."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از دستورهای نسخه یا تیم درمان خود استفاده کنید. همهٔ فیلدها اختیاری هستند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処方内容や医療チームからの指示を入力してください。すべての項目は任意です。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Следвайте указанията от рецептата си или от медицинския екип, който се грижи за вас. Всички полета са незадължителни."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Segueix les instruccions de la recepta o del teu equip assistencial. Tots els camps són opcionals."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řiďte se pokyny z předpisu nebo od svého zdravotnického týmu. Všechna pole jsou volitelná."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug anvisningerne fra din recept eller dit behandlerteam. Alle felter er valgfrie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε τις οδηγίες της συνταγής σας ή της ομάδας φροντίδας σας. Όλα τα πεδία είναι προαιρετικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the instructions from your prescription or care team. Every field is optional."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the instructions from your prescription or care team. Every field is optional."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the instructions from your prescription or care team. Every field is optional."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa las instrucciones de tu receta o de tu equipo de atención médica. Todos los campos son opcionales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Noudata reseptisi tai hoitotiimisi ohjeita. Kaikki kentät ovat valinnaisia."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les consignes de votre ordonnance ou de votre équipe soignante. Tous les champs sont facultatifs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने नुस्खे या देखभाल टीम के निर्देशों का उपयोग करें। हर फ़ील्ड वैकल्पिक है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite upute s recepta ili upute svojeg zdravstvenog tima. Sva su polja neobavezna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kövesd a recepten vagy az ellátócsapatodtól kapott utasításokat. Minden mező kitöltése opcionális."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan petunjuk dari resep atau tim perawatan Anda. Semua kolom bersifat opsional."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui le indicazioni della prescrizione o del personale sanitario che ti segue. Ogni campo è facoltativo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рецептіңіздегі немесе емдеуші мамандар тобының нұсқауларын пайдаланыңыз. Барлық өрістерді толтыру міндетті емес."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처방전이나 의료진의 지침을 따르세요. 모든 항목은 선택 사항입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikut arahan pada preskripsi anda atau daripada pasukan penjagaan anda. Semua medan adalah pilihan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk instruksjonene fra resepten eller behandlingsteamet ditt. Alle feltene er valgfrie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de instructies van je recept of zorgteam. Elk veld is optioneel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korzystaj z zaleceń z recepty lub od zespołu medycznego. Każde pole jest opcjonalne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use as instruções da sua receita ou da sua equipe de saúde. Todos os campos são opcionais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga as instruções da sua receita ou da equipa de saúde que o acompanha. Todos os campos são opcionais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește instrucțiunile din prescripția ta sau de la echipa medicală. Toate câmpurile sunt opționale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следуйте указаниям в рецепте или рекомендациям вашей лечащей команды. Все поля необязательны."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použite pokyny z vášho predpisu alebo od vášho ošetrujúceho tímu. Každé pole je voliteľné."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd anvisningarna från ditt recept eller ditt vårdteam. Alla fält är valfria."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้คำแนะนำจากใบสั่งยาหรือทีมดูแลของคุณ ทุกช่องเป็นข้อมูลที่ไม่จำเป็นต้องกรอก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reçetenizdeki veya sağlık ekibinizin verdiği talimatları kullanın. Tüm alanlar isteğe bağlıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте вказівки з вашого рецепта або від вашої медичної команди. Усі поля необов’язкові."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm theo hướng dẫn trong đơn thuốc hoặc từ đội ngũ chăm sóc của bạn. Mọi trường đều không bắt buộc."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用處方或醫護團隊提供的指示。所有欄位均可選填。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用处方或医疗团队提供的用药说明。所有字段均为选填。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請依照處方或照護團隊提供的說明填寫。所有欄位皆為選填。"
          }
        }
      }
    },
    "Use the interval from your prescription or care instructions.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el intervalo indicado en tu receta o en tus instrucciones de atención médica."
          }
