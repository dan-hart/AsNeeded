        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יישום זה אינו מספק ייעוץ רפואי, אבחנה או טיפול. כל התוכן, כולל טקסט, גרפיקה ומידע, נועד למטרות מידע בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ऐप चिकित्सा सलाह, निदान, या उपचार प्रदान नहीं करता। इसमें मौजूद सभी सामग्री — टेक्स्ट, ग्राफ़िक्स और जानकारी — केवल सूचना के उद्देश्य के लिए है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az alkalmazás nem nyújt orvosi tanácsot, diagnózist vagy kezelést. Minden tartalom, beleértve a szöveget, grafikát és információkat, kizárólag tájékoztató jellegű."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi ini tidak memberikan saran medis, diagnosis, atau pengobatan. Semua konten, termasuk teks, grafik, dan informasi, hanya untuk tujuan informasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa applicazione non fornisce consigli medici, diagnosi o terapie. Tutti i contenuti, inclusi testi, grafiche e informazioni, sono solo a scopo informativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本アプリは医療に関する助言、診断、または治療を提供するものではありません。テキストや図、情報を含むすべての内容は参考目的のみです。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл қосымша медициналық кеңес, диагноз немесе емдеу ұсынбайды. Мәтіндер, графика және ақпаратты қоса алғанда барлық мазмұн тек ақпараттық мақсатта беріледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 응용 프로그램은 의료 조언, 진단 또는 치료를 제공하지 않습니다. 텍스트, 그래픽 및 정보 등 모든 콘텐츠는 정보 제공 목적으로만 제공됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi ini tidak memberikan nasihat perubatan, diagnosis, atau rawatan. Semua kandungan, termasuk teks, grafik, dan maklumat, adalah untuk tujuan maklumat sahaja."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne applikasjonen gir ikke medisinske råd, diagnoser eller behandling. Alt innhold, inkludert tekst, grafikk og informasjon, er kun ment for informasjonsformål."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze applicatie geeft geen medisch advies, diagnose of behandeling. Alle inhoud, inclusief tekst, afbeeldingen en informatie, is alleen bedoeld voor informatieve doeleinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta aplikacja nie udziela porad medycznych, nie stawia diagnoz ani nie prowadzi leczenia. Wszystkie treści, w tym teksty, grafiki i informacje, mają wyłącznie charakter informacyjny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta aplicação não fornece aconselhamento médico, diagnóstico ou tratamento. Todo o conteúdo, incluindo texto, gráficos e informações, é apenas para fins informativos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta aplicação não fornece aconselhamento médico, diagnóstico ou tratamento. Todo o conteúdo, incluindo texto, gráficos e informação, destina‑se apenas a fins informativos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această aplicație nu oferă sfaturi medicale, diagnostic sau tratament. Toate materialele, inclusiv textele, grafica și informațiile, sunt doar cu caracter informativ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приложение не предоставляет медицинских рекомендаций, диагноза или лечения. Вся информация, включая текст, графику и данные, предназначена только для справочных целей."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna applikation ger inte medicinska råd, diagnos eller behandling. Allt innehåll, inklusive text, grafik och information, är endast avsett för informationsändamål."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปพลิเคชันนี้ไม่ได้ให้คำแนะนำทางการแพทย์ การวินิจฉัย หรือการรักษา เนื้อหาทั้งหมดรวมถึงข้อความ กราฟิก และข้อมูล มีไว้เพื่อวัตถุประสงค์ในการให้ข้อมูลเท่านั้น."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama tıbbi tavsiye, teşhis veya tedavi sağlamaz. Metin, grafik ve bilgiler de dahil olmak üzere tüm içerik yalnızca bilgilendirme amaçlıdır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng này không cung cấp lời khuyên y tế, chẩn đoán hoặc điều trị. Mọi nội dung, bao gồm văn bản, hình ảnh và thông tin, chỉ nhằm mục đích tham khảo."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "本應用程式不提供醫療建議、診斷或治療。所有內容（包括文字、圖像及資訊）僅供參考。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用不提供医疗建议、诊断或治疗。所有内容（包括文字、图形和信息）仅供参考。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本應用程式不提供醫療建議、診斷或治療。所有內容（包括文字、圖像與資訊）僅供參考。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това приложение не предоставя медицински съвети, диагноза или лечение. Цялото съдържание, включително текст, графики и информация, е само с информационна цел."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova aplikacija ne pruža medicinske savjete, dijagnoze ni liječenje. Sav sadržaj, uključujući tekst, grafiku i informacije, služi isključivo u informativne svrhe."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto aplikácia neposkytuje lekárske poradenstvo, diagnostiku ani liečbu. Všetok obsah vrátane textu, grafiky a informácií slúži výlučne na informačné účely."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей застосунок не надає медичних консультацій, не встановлює діагнозів і не призначає лікування. Увесь вміст, зокрема текст, графіка та інформація, призначений лише для ознайомлення."
          }
        }
      }
    },
