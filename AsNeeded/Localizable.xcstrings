          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra AsNeeded no iPhone que está por perto e, em seguida, atualize."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide AsNeeded pe iPhone-ul tău din apropiere, apoi reîmprospătează."
          }
        },
        "ru": {
