    "Enter positive, finite dose limits in medication settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce límites de dosis positivos y finitos en los ajustes del medicamento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib in den Medikamenteneinstellungen positive, endliche Dosisgrenzen ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez des limites de dose positives et finies dans les réglages du médicament."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل حدودًا للجرعة بقيم موجبة ومحدودة في إعدادات الدواء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להזין מגבלות מינון חיוביות וסופיות בהגדרות התרופה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در تنظیمات دارو، مقادیر مثبت و متناهی برای محدودیت‌های دوز وارد کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "薬の設定で、用量制限に正の有限数を入力してください。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въведете положителни, крайни стойности за ограниченията на дозата в настройките на лекарството."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdueix límits de dosi positius i finits a la configuració del medicament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V nastavení léku zadejte kladné, konečné hodnoty limitů dávkování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast positive, endelige dosisgrænser i medicinindstillingerne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε θετικά, πεπερασμένα όρια δόσης στις ρυθμίσεις του φαρμάκου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
