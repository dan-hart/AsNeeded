    "Find automatic backups and export options in Data & Privacy. You choose where to save them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrarás las copias de seguridad automáticas y las opciones de exportación en Datos y privacidad. Tú eliges dónde guardarlas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Sicherungen und Exportoptionen findest du unter „Daten & Datenschutz“. Du entscheidest, wo sie gespeichert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrouvez les sauvegardes automatiques et les options d’exportation dans Données et confidentialité. Vous choisissez où les enregistrer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستجد النسخ الاحتياطية التلقائية وخيارات التصدير في البيانات والخصوصية. أنت تختار مكان حفظها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן למצוא גיבויים אוטומטיים ואפשרויות ייצוא בנתונים ופרטיות. הבחירה היכן לשמור אותם בידיך."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخه‌های پشتیبان خودکار و گزینه‌های خروجی گرفتن را در بخش داده‌ها و حریم خصوصی پیدا کنید. محل ذخیرهٔ آن‌ها را خودتان انتخاب می‌کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動バックアップとエクスポートの設定は「データとプライバシー」にあります。保存先はご自身で選べます。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматичните резервни копия и опциите за експортиране се намират в „Данни и поверителност“. Вие избирате къде да ги запазвате."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Trobaràs les còpies de seguretat automàtiques i les opcions d’exportació a Dades i privacitat. Tu tries on desar-les."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatické zálohy a možnosti exportu najdete v části Data a soukromí. Místo uložení si zvolíte sami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Find automatiske sikkerhedskopier og eksportmuligheder under Data og anonymitet. Du vælger selv, hvor de skal gemmes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρείτε τα αυτόματα αντίγραφα ασφαλείας και τις επιλογές εξαγωγής στην ενότητα «Δεδομένα και απόρρητο». Εσείς επιλέγετε πού θα αποθηκεύονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find automatic backups and export options in Data & Privacy. You choose where to save them."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Find automatic backups and export options in Data & Privacy. You choose where to save them."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Find automatic backups and export options in Data & Privacy. You choose where to save them."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra las copias de seguridad automáticas y las opciones de exportación en Datos y privacidad. Tú eliges dónde guardarlas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaattiset varmuuskopiot ja vientivalinnat löytyvät kohdasta Tiedot ja yksityisyys. Valitset itse niiden tallennuspaikan."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez les sauvegardes automatiques et les options d’exportation dans Données et confidentialité. Vous choisissez où les enregistrer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटा और गोपनीयता में स्वचालित बैकअप और निर्यात के विकल्प पाएँ। इन्हें कहाँ सहेजना है, यह आप चुनते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatske sigurnosne kopije i mogućnosti izvoza pronađite u odjeljku Podaci i privatnost. Vi birate gdje ćete ih spremiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az automatikus biztonsági mentéseket és az exportálási lehetőségeket az Adatok és adatvédelem menüpontban találja. Ön dönti el, hová menti őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Temukan pencadangan otomatis dan opsi ekspor di Data & Privasi. Anda memilih lokasi penyimpanannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trovi le copie di sicurezza automatiche e le opzioni di esportazione in Dati e privacy. Scegli tu dove salvarle."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматты сақтық көшірмелер мен экспорттау мүмкіндіктері «Деректер және құпиялық» бөлімінде орналасқан. Оларды қайда сақтау керегін өзіңіз таңдайсыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 및 개인정보 보호에서 자동 백업과 내보내기 옵션을 찾을 수 있습니다. 저장 위치는 직접 선택할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari sandaran automatik dan pilihan eksport dalam Data & Privasi. Anda memilih tempat untuk menyimpannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du finner automatiske sikkerhetskopier og eksportalternativer under Data og personvern. Du velger hvor de skal lagres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vindt automatische reservekopieën en exportopties onder Gegevens en privacy. Je kiest zelf waar je ze opslaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczne kopie zapasowe i opcje eksportu znajdziesz w sekcji Dane i prywatność. Ty wybierasz miejsce ich zapisu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre backups automáticos e opções de exportação em Dados e privacidade. Você escolhe onde salvá-los."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre cópias de segurança automáticas e opções de exportação em Dados e privacidade. Pode escolher onde guardá-las."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Găsești copiile de siguranță automate și opțiunile de export în Date și confidențialitate. Tu alegi unde să le salvezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматические резервные копии и параметры экспорта находятся в разделе «Данные и конфиденциальность». Вы сами выбираете место сохранения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatické zálohy a možnosti exportu nájdete v časti Údaje a súkromie. Miesto ich uloženia si vyberáte vy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hittar automatiska säkerhetskopior och exportalternativ under Data och integritet. Du väljer var de ska sparas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูการสำรองข้อมูลอัตโนมัติและตัวเลือกการส่งออกได้ในข้อมูลและความเป็นส่วนตัว คุณเลือกตำแหน่งที่จะบันทึกได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik yedekleme ve dışa aktarma seçeneklerini Veri ve Gizlilik bölümünde bulabilirsiniz. Bunların nereye kaydedileceğini siz seçersiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматичні резервні копії та параметри експорту доступні в розділі «Дані та приватність». Ви обираєте, де їх зберігати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm các bản sao lưu tự động và tùy chọn xuất trong Dữ liệu & Quyền riêng tư. Bạn chọn nơi lưu chúng."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在「資料與私隱」中找到自動備份及匯出選項，並自行選擇儲存位置。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
