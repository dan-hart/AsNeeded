    "NSDocumentsFolderUsageDescription": {
      "comment": "System permission explanation. Preserve the app brand As Needed and permission scope.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed needs access to save automatic backups of your medication data to a location you choose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed necesita acceso para guardar copias de seguridad automáticas de tus datos de medicamentos en la ubicación que elijas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed benötigt Zugriff, um automatische Sicherungen Ihrer Medikamentendaten an einem von Ihnen gewählten Speicherort zu speichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed a besoin d’un accès pour enregistrer des sauvegardes automatiques de vos données de médication à l’emplacement de votre choix."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج As Needed إلى إذن الوصول لحفظ نسخ احتياطية تلقائية من بيانات أدويتك في موقع تختاره."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ל-As Needed דרושה גישה לשמירת גיבויים אוטומטיים של נתוני התרופות שלך במיקום לבחירתך."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed برای ذخیرهٔ خودکار نسخه‌های پشتیبان داده‌های دارویی شما در محلی که انتخاب می‌کنید، به دسترسی نیاز دارد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "As Neededが薬のデータの自動バックアップを選択した場所に保存するには、アクセス権限が必要です。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed се нуждае от достъп, за да запазва автоматични резервни копия на данните за лекарствата ви на избрано от вас място."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed necessita accés per desar còpies de seguretat automàtiques de les teves dades de medicació en una ubicació que triïs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed potřebuje přístup k ukládání automatických záloh údajů o vašich lécích do vámi zvoleného umístění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed har brug for adgang til at gemme automatiske sikkerhedskopier af dine medicindata på en placering, du vælger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το As Needed χρειάζεται πρόσβαση για να αποθηκεύει αυτόματα αντίγραφα ασφαλείας των δεδομένων των φαρμάκων σας σε μια τοποθεσία που επιλέγετε."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed needs access to save automatic backups of your medication data to a location you choose."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed needs access to save automatic backups of your medication data to a location you choose."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed necesita acceso para guardar copias de seguridad automáticas de los datos de tus medicamentos en una ubicación que elijas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed tarvitsee käyttöoikeuden tallentaakseen lääketietojesi automaattiset varmuuskopiot valitsemaasi sijaintiin."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed a besoin d’un accès pour enregistrer des sauvegardes automatiques de vos données de médicaments à l’emplacement de votre choix."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके चुने हुए स्थान पर आपकी दवाओं के डेटा का स्वचालित बैकअप सहेजने के लिए As Needed को ऐक्सेस की अनुमति चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikaciji As Needed potreban je pristup za spremanje automatskih sigurnosnih kopija vaših podataka o lijekovima na mjesto koje odaberete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az As Needed hozzáférést kér ahhoz, hogy automatikus biztonsági mentéseket készíthessen a gyógyszeradatairól az Ön által választott helyre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed memerlukan akses untuk menyimpan cadangan otomatis data obat Anda ke lokasi yang Anda pilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed richiede l'accesso per salvare backup automatici dei dati sui tuoi farmaci in una posizione a tua scelta."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed қолданбасына дәрілер туралы деректеріңіздің автоматты сақтық көшірмелерін өзіңіз таңдаған орынға сақтау үшін қол жеткізу рұқсаты қажет."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed에서 선택한 위치에 약물 데이터의 자동 백업을 저장하려면 접근 권한이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed memerlukan akses untuk menyimpan sandaran automatik data ubat anda ke lokasi yang anda pilih."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed trenger tilgang for å lagre automatiske sikkerhetskopier av legemiddeldataene dine på et sted du velger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed heeft toegang nodig om automatische reservekopieën van je medicatiegegevens op te slaan op een locatie die je kiest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed potrzebuje dostępu, aby zapisywać automatyczne kopie zapasowe danych o lekach w wybranej przez Ciebie lokalizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O As Needed precisa de acesso para salvar cópias de segurança automáticas dos dados dos seus medicamentos em um local que você escolher."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A As Needed precisa de acesso para guardar cópias de segurança automáticas dos seus dados de medicação numa localização à sua escolha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed are nevoie de acces pentru a salva automat copii de siguranță ale datelor despre medicamente într-o locație aleasă de tine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложению As Needed нужен доступ для автоматического сохранения резервных копий данных о ваших лекарствах в выбранном вами месте."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed potrebuje prístup na ukladanie automatických záloh údajov o vašich liekoch na vami zvolené miesto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed behöver åtkomst för att spara automatiska säkerhetskopior av dina läkemedelsdata på en plats som du väljer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed ต้องได้รับสิทธิ์เข้าถึงเพื่อบันทึกข้อมูลสำรองอัตโนมัติของข้อมูลยาของคุณไปยังตำแหน่งที่คุณเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed, ilaç verilerinizin otomatik yedeklerini seçtiğiniz konuma kaydetmek için erişim iznine ihtiyaç duyar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed потрібен доступ для збереження автоматичних резервних копій даних про ваші ліки у вибраному вами місці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed cần quyền truy cập để lưu bản sao lưu tự động của dữ liệu thuốc vào vị trí bạn chọn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed 需要存取權限，才能將藥物資料的自動備份儲存至你選擇的位置。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed 需要访问权限，以将药物数据的自动备份保存到您选择的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "As Needed 需要存取權限，才能將藥物資料的自動備份儲存至你選擇的位置。"
          }
        }
      }
    },
